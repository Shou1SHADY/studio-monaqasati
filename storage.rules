rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // HR 1.0 — attachments on an employee's record (EM-07): the iqama image, the
    // contract, a medical report, a penalty decision, the bank document. Read and
    // written by members of the organisation with an HR hand that handles
    // documents or pay (Firestore's `employees/{id}/files` entry decides who sees
    // that a file exists); images and PDFs up to 15 MB; never overwritten or
    // deleted from the client.
    //
    // NOTE: the open rule at the end still lets ANY signed-in user read and write
    // this path — rules are OR-ed, so this block takes effect only once that rule
    // excludes `organizations`. It is kept as the contract.
    match /organizations/{orgId}/hr/employees/{employeeId}/{fileName} {
      function member() {
        let u = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
        return request.auth != null && (request.auth.uid == orgId || u.organizationId == orgId);
      }
      allow read: if member();
      allow create: if member()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    // DEV-68 — attachments on a document that links a buyer and a supplier. The path names the
    // buyer's company; Firestore's `documentNotes` entry decides who sees that a file exists.
    // Images, PDFs and office files up to 15 MB; never overwritten or deleted from the client.
    // (Same note as above: in force only once the catch-all is narrowed.)
    match /documents/{buyerOrgId}/{targetKey}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size > 0
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('application/(msword|vnd\\.ms-excel|vnd\\.openxmlformats-officedocument\\..*)')
            || request.resource.contentType == 'text/csv');
      allow update, delete: if false;
    }

    // Companies' legal documents — the commercial registration, the tax certificate, the national address, the IBAN
    // letter (supplier onboarding, 18 Oct 2026). Only their uploader reads, lists or writes them through Storage; the
    // admin, the company and the contractors who may see one open it by the link saved on the company's record. They
    // used to fall under the catch-all, which let any signed-in user list and overwrite every company's papers.
    // No cross-service lookup here on purpose: the uploader's own id is in the path.
    match /legalDocuments/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /suppliers/{orgId}/documents/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Free-account documents uploaded before the uploader's id joined the path: the primary company's owner only.
    match /suppliers/{orgId}/documents/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == orgId;
    }

    // Everything else: any signed-in user, as before. A supplier's other folders (quotes, invoices, warranties, files)
    // stay open; the two folders above never fall through to here.
    match /{top}/{rest=**} {
      allow read, write: if request.auth != null && top != 'legalDocuments' && top != 'suppliers';
    }
    match /suppliers/{orgId}/{folder}/{rest=**} {
      allow read, write: if request.auth != null && folder != 'documents';
    }
  }
}
