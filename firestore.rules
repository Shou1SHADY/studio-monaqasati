rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- دالات مساعدة أساسية ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // الدالة الأكثر أماناً للتحقق من الرتبة: تتأكد من وجود المستند أولاً
    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == role;
    }

    function isAdmin() { return hasRole('Admin'); }
    function isSupplier() { return hasRole('Supplier'); }
    function isContractor() { return hasRole('Contractor'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- قواعد المجموعات ---

    match /users/{userId} {
      // السماح للمستخدم بإنشاء ملفه الشخصي (الخطوة الأولى الضرورية)
      allow create: if isOwner(userId);
      allow get: if isOwner(userId) || isSignedIn();
      allow list: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // السماح بالقراءة لجميع المسجلين لضمان عمل الواجهة
      allow read: if isSignedIn();
      // المقاول والمسؤول فقط يمكنهم طرح مناقصة
      allow create: if isContractor() || isAdmin();
      allow update: if isAdmin() || (isContractor() && resource.data.contractorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      // المورد والمسؤول فقط يمكنهم تقديم عرض
      allow create: if isSupplier() || isAdmin();
      allow update: if isAdmin() || (isSupplier() && resource.data.supplierId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }
  }
}