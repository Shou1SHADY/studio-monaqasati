rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data != null ? userDoc.data : {};
    }

    function getOrganizationId() {
      let userData = getUserData();
      return userData.organizationId != null ? userData.organizationId : "";
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == role;
    }

    function isAdmin() { return hasRole('Admin'); }
    function isSupplier() { return hasRole('Supplier'); }
    function isContractor() { return hasRole('Contractor'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isOrgMember(orgId) {
      return isSignedIn() && getOrganizationId() == orgId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow create: if isOwner(userId) || isAdmin();
      allow get: if isOwner(userId) || isOrgMember(resource.data.organizationId) || isSignedIn();
      allow list: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin() || (
        isSignedIn() &&
        resource.data.organizationId == getOrganizationId() &&
        getUserData().organizationRole == 'owner'
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        // Only the owner of the user doc can read their own notifications
        allow get, list: if isOwner(userId) || isAdmin();
        // Any signed-in user can create a notification for another user
        allow create: if isSignedIn();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /2fa/{docId} {
        // Only the user themselves and admins can read/write OTP codes
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      // 'read' = get + list, safe for signed-in users (static reference data)
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // Both get and list are safe for all signed-in users (RFQs are semi-public)
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || isContractor()
        || (isSignedIn() && request.resource.data.organizationId == getOrganizationId());
      // Org members / admins can update everything.
      // Any signed-in user (e.g. a supplier submitting an offer) may increment
      // only the offersCount counter — no other field may change.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId())
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount'])
        );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId())
        || (isSignedIn() && resource.data.contractorId == request.auth.uid);

      // Subcollection: inquiries (questions from suppliers about the RFQ)
      match /inquiries/{inquiryId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid)
          || (isSignedIn() && get(/databases/$(database)/documents/rfqs/$(rfqId)).data.organizationId == getOrganizationId());
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

      match /offers/{offerId} {
      // 'get' (single document): check the resource fields for ownership
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.organizationId == getOrganizationId() ||
        resource.data.contractorOrgId == getOrganizationId() ||
        isAdmin()
      );
      // 'list' (collection query): allow any signed-in user; the app's 'where' clause
      // (filtering by rfqId, organizationId, etc.) ensures data isolation.
      allow list: if isSignedIn();
      allow create: if isAdmin()
        || isSupplier()
        || (isSignedIn() && request.resource.data.supplierId == request.auth.uid)
        || (isSignedIn() && request.resource.data.organizationId == getOrganizationId());
      // Supplier can update their own offer; Contractor can update status on offers for their RFQs
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.supplierId == request.auth.uid)
        || (isSignedIn() && resource.data.contractorId == request.auth.uid)
        || (isSignedIn() && resource.data.organizationId == getOrganizationId())
        || (isSignedIn() && resource.data.contractorOrgId == getOrganizationId())
        || (isSignedIn() && resource.data.rfqId != null
            && (
              get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.organizationId == getOrganizationId()
              || get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.contractorId == request.auth.uid
            ));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.supplierId == request.auth.uid);
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if isSignedIn();
      // 'get' (single document): only parties to the chat
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      // 'list' (collection query): allow any signed-in user; app 'where' clause filters by orgId
      allow list: if isSignedIn();
      // Direct UID checks are evaluated first (no extra get() call) so they short-circuit
      // before getOrganizationId() is called — avoids a null-org denial.
      allow update: if isSignedIn() && (
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    // Top-level messages collection (used by mobile app)
    match /messages/{messageId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    // Invitations — contractor invites supplier by email; also used for team member invites
    match /invitations/{invitationId} {
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow get: if isSignedIn() && (resource == null || resource.data.email == request.auth.token.email || resource.data.invitedBy == request.auth.uid);
      // Supplier accepts/declines; contractor cancels their own invitation
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      );
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }

    // Contractor–Supplier connection requests (supplier sends request → contractor accepts)
    match /contractorSupplierLinks/{linkId} {
      // Both parties can read their own links
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier-initiated requests OR supplier accepting a contractor invitation
      allow create: if isSignedIn()
        && request.resource.data.supplierOrgId == getOrganizationId()
        && (request.resource.data.requestedBy == "supplier" || request.resource.data.requestedBy == "contractor");
      // Contractors can accept/reject (update status); suppliers can cancel their own request
      allow update: if isSignedIn() && (
        resource.data.contractorOrgId == getOrganizationId() ||
        (resource.data.supplierOrgId == getOrganizationId() && resource.data.requestedBy == "supplier") ||
        isAdmin()
      );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.supplierOrgId == getOrganizationId());
    }

    // Project tracking — contractor org-scoped
    match /projects/{projectId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.organizationId == getOrganizationId() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isContractor()
        && request.resource.data.organizationId == getOrganizationId();
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId());
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId());
    }

    // Delivery receipts — both contractor and supplier involved can read/write
    match /deliveries/{deliveryId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.confirmedByUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier creates delivery notice for their own accepted offer
      allow create: if isSupplier()
        && request.resource.data.supplierOrgId == getOrganizationId();
      // Contractor confirms receipt; supplier can update their own notice before confirmation
      allow update: if isSignedIn() && (
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

  }
}

