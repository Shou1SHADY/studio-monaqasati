rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Shared shapes, factored so the compiled ruleset stays under Firestore's
    // 250 KB limit (the source repeated them well over a hundred times each).
    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    function inProjectOrg(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId();
    }
    // The two guards nearly every project subcollection opens with, folded into
    // one call each: a ruleset has a compiled-size ceiling (250 KB) and these
    // chains were repeated some 120 times. Same checks, same order.
    function inProject(projectId) {
      return isSignedIn() && inProjectOrg(projectId);
    }
    function inOpenProject(projectId) {
      return isSignedIn() && inProjectOrg(projectId) && projectOpen(projectId);
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data != null ? userDoc.data : {};
    }

    function getOrganizationId() {
      let userData = getUserData();
      return userData.organizationId != null ? userData.organizationId : "";
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == role;
    }

    function isAdmin() { return hasRole('Admin'); }
    function isSupplier() { return hasRole('Supplier'); }
    function isContractor() { return hasRole('Contractor'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isOrgMember(orgId) {
      return isSignedIn() && getOrganizationId() == orgId;
    }

    // --- Team permission helpers (mirror src/lib/permissions.ts) ---
    // Org owners have every permission. Members get their group's permissions:
    // a project-level assignment (projects/{id}/members) overrides the default
    // group; a member with no group at all has read-only access.

    function isOrgOwner() {
      // Users created before the org-role migration have no organizationRole;
      // they are solo accounts, i.e. owners of their own one-person org.
      let userData = getUserData();
      return !('organizationRole' in userData) || userData.organizationRole == 'owner';
    }

    function memberDefaultGroupId() {
      let userData = getUserData();
      return ('defaultGroupId' in userData) ? userData.defaultGroupId : null;
    }

    function groupGrants(groupId, perm) {
      return groupId != null
        && groupId is string
        && exists(/databases/$(database)/documents/teamGroups/$(groupId))
        && get(/databases/$(database)/documents/teamGroups/$(groupId)).data.permissions.hasAny(['*', perm]);
    }

    function hasOrgPermission(perm) {
      return isOrgOwner() || groupGrants(memberDefaultGroupId(), perm);
    }

    // The owner of company `orgId`: its primary company is the owner's own uid; a
    // secondary company names its owner on the organizations doc.
    function isCompanyOwner(orgId) {
      return isSignedIn()
        && (request.auth.uid == orgId
            || (exists(/databases/$(database)/documents/organizations/$(orgId))
                && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUserId', '') == request.auth.uid));
    }
    // The prototype's CAN('sup'): the procurement manager (po.approve) and the buyer
    // (offers.accept) — not suppliers.manage alone (the seeded expediter holds it).
    function procSupplierManager() {
      return hasOrgPermission('offers.accept') || hasOrgPermission('po.approve');
    }

    function hasProjectPermission(projectId, perm) {
      // A seat that carries no group (a PM 1.0 seat made at adoption, or one whose
      // group was cleared) leaves the person's DEFAULT group in force — what the
      // client reads (`projectGroupId ?? defaultGroupId`). Reading a missing
      // `groupId` straight off the seat was an evaluation error: a refusal.
      return isOrgOwner()
        || ((exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.get('groupId', null) != null)
            ? groupGrants(get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.groupId, perm)
            : groupGrants(memberDefaultGroupId(), perm));
    }

    // PM 1.0: the manager a handover FILE is addressed to creates the project on
    // acceptance — the file must be waiting, in this org, and name them.
    function acceptsPmHandover() {
      let hid = request.resource.data.get('pmHandoverId', '');
      return hid is string && hid.size() > 0
        && exists(/databases/$(database)/documents/pmHandovers/$(hid))
        && (get(/databases/$(database)/documents/pmHandovers/$(hid)).data.to == request.auth.uid || isOrgOwner())
        && get(/databases/$(database)/documents/pmHandovers/$(hid)).data.status == 'wait'
        && get(/databases/$(database)/documents/pmHandovers/$(hid)).data.organizationId == getOrganizationId()
        && request.resource.data.get('contractorId', '') == request.auth.uid
        && request.resource.data.get('projectManagerId', '') is string
        && request.resource.data.get('projectManagerId', '').size() > 0;
    }

    // A PM 1.0 project created by hand (pmfixA): planning state, flagged `pm.manual`.
    function createsManualPmProject() {
      let pm = request.resource.data.get('pm', {});
      return pmCeilingHas('create')
        && pm.get('manual', false) == true
        && pm.get('lifecycle', '') == 'plan'
        && pm.get('original', null) == null
        && pm.get('startedAt', null) == null
        && pm.get('no', '') is string && pm.get('no', '').size() > 0
        && !('pmHandoverId' in request.resource.data)
        && request.resource.data.get('contractorId', '') == request.auth.uid
        && request.resource.data.get('projectManagerId', '') is string
        && request.resource.data.get('projectManagerId', '').size() > 0;
    }

    // PM 1.0 (PRD §3–4, RL-01/02) — a duty on a PM project is the person's system
    // ceiling (their DEFAULT group's pm.* role; owner / '*' = everything) ∩ their
    // project role's template − the duties removed from them. A member with an exit
    // date is off the team: an exit is dated today or earlier (TM-01), never later.
    // Someone off the team keeps a duty only through the `all` key (owner, QS office).
    // An archived (closed) project grants no duty to anyone. Mirrors src/lib/pm/access.ts
    // — pm-access-rules.test.ts keeps the two lists equal.
    function pmTemplate(role) {
      return {
        'pm': ['measure', 'daily', 'qa', 'hse', 'req', 'rcv', 'sub', 'approve', 'vo', 'prep', 'ipc', 'ipcOk', 'client', 'corr'],
        'site': ['measure', 'daily', 'qa', 'req', 'rcv'],
        'qs': ['measure', 'prep', 'ipc', 'vo', 'client', 'corr', 'sub'],
        'hse': ['daily', 'hse'],
        'supervisor': ['daily'],
        'other': ['measure', 'daily', 'qa', 'hse', 'req', 'rcv', 'sub', 'approve', 'vo', 'prep', 'ipc', 'ipcOk', 'client', 'corr']
      }.get(role, []);
    }

    function pmCeilingHas(key) {
      let g = memberDefaultGroupId();
      return isOrgOwner()
        || groupGrants(g, '*')
        || (groupGrants(g, 'pm.manage') && key in ['money', 'create', 'approve', 'measure', 'ipc', 'vo', 'req', 'client', 'prep', 'ipcOk', 'rcv', 'qa', 'hse', 'corr', 'sub'])
        || (groupGrants(g, 'pm.cost') && key in ['money', 'all', 'ipc', 'measure', 'vo', 'client', 'prep', 'corr', 'sub'])
        || (groupGrants(g, 'pm.site') && key in ['measure', 'daily', 'req', 'rcv', 'qa', 'hse']);
    }

    function pmMemberPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
    }

    function pmLiveSeat(projectId) {
      return exists(pmMemberPath(projectId))
        && get(pmMemberPath(projectId)).data.get('pmRole', '') != ''
        && get(pmMemberPath(projectId)).data.get('to', null) == null;
    }

    // A seat's permission group overrides the person's default group on that
    // project (hasProjectPermission), so whoever seats someone may give him his
    // OWN default group or none — never a group picked to widen him.
    function pmSeatGroupOk(memberId) {
      return request.resource.data.get('groupId', null) == null
        || request.resource.data.groupId == get(/databases/$(database)/documents/users/$(memberId)).data.get('defaultGroupId', null);
    }

    function pmArchivedData(data) {
      return data.get('pm', {}).get('lifecycle', '') == 'closed';
    }

    // An archived PM project accepts no change from anyone — its subcollections
    // included (RL-04, INV-21). Legacy projects have no `pm` block: always open.
    function projectOpen(projectId) {
      return !pmArchivedData(projectData(projectId));
    }

    // A PM project with no project manager: only the owner approves (TM-01, RL-07).
    function pmDuty(projectId, duty) {
      return !pmArchivedData(projectData(projectId))
        && pmCeilingHas(duty)
        // The client clears the manager with null; `null != ''` is true, so the
        // test must ask for a real id.
        && (duty != 'approve' || pmCeilingHas('admin')
            || (projectData(projectId).get('projectManagerId', '') is string
                && projectData(projectId).get('projectManagerId', '') != ''))
        && (pmLiveSeat(projectId)
              ? (duty in pmTemplate(get(pmMemberPath(projectId)).data.pmRole)
                  && !(duty in get(pmMemberPath(projectId)).data.get('off', [])))
              : pmCeilingHas('all'));
    }

    // HR 1.0 (PRD §3–4, RL-01…03) — the caller's HR role comes from his DEFAULT
    // group: `employees.manage` HR manager · `hr.gov` government relations ·
    // `hr.payroll` payroll officer · `hr.supervisor` workplace supervisor ·
    // `hr.management` management. The owner and a '*' group hold every role.
    // Mirrors src/lib/hr/access.ts.
    function hrRole(perm) {
      return isOrgOwner() || groupGrants(memberDefaultGroupId(), perm);
    }
    function hrManager() { return hrRole('employees.manage'); }
    // RL-03: pay is seen by the HR manager, payroll and management — never by
    // government relations or a supervisor (the employee reads his own, see employeePay).
    function hrSeesPay() {
      return hrRole('employees.manage') || hrRole('hr.payroll') || hrRole('hr.management');
    }
    function hrStaff() {
      return hrRole('employees.manage') || hrRole('hr.gov') || hrRole('hr.payroll')
        || hrRole('hr.supervisor') || hrRole('hr.management');
    }
    // Finance's hand in HR (AD-03): an advance above the HR limit.
    function hrFinance() {
      return isOrgOwner() || hasOrgPermission('invoices.manage') || hasOrgPermission('accounting.post');
    }
    // The employee record the caller is linked to: the link decides whose pay he
    // reads (RL-03) and which record is "his own" (RL-02).
    function hrOwnRecord(employeeId) {
      return get(/databases/$(database)/documents/employees/$(employeeId)).data.get('userId', '') == request.auth.uid;
    }
    // A workplace supervisor acts on his own workplaces only (the site names him).
    function hrSupervises(siteId) {
      return hrRole('hr.supervisor')
        && exists(/databases/$(database)/documents/hrSites/$(siteId))
        && get(/databases/$(database)/documents/hrSites/$(siteId)).data.get('supervisorUserId', '') == request.auth.uid;
    }

    // The project manager of a PM 1.0 project (one born from a handover file).
    function isPmProjectManager(projectId) {
      let p = projectData(projectId);
      return p.get('projectManagerId', '') == request.auth.uid && p.get('pmHandoverId', '') != '';
    }

    // Permission for an RFQ: project-linked RFQs use the project assignment,
    // standalone RFQs fall back to the member's default group.
    function hasRfqPermission(rfqData, perm) {
      return (('projectId' in rfqData) && rfqData.projectId != null && rfqData.projectId is string && rfqData.projectId.size() > 0)
        ? hasProjectPermission(rfqData.projectId, perm)
        : hasOrgPermission(perm);
    }

    // Deciding on an offer (accept/reject/reduction) follows the offer's RFQ:
    // project-linked → project assignment; otherwise the default group.
    function rfqLogAppendsOne() {
      let before = resource.data.get('log', []);
      let after = request.resource.data.get('log', []);
      return after is list
        && after.size() == before.size() + 1
        && after[before.size()].byId == request.auth.uid;
    }

    function rfqSameProject() {
      return request.resource.data.get('projectId', null) == resource.data.get('projectId', null);
    }

    function hasOfferDecisionPermission(offerData) {
      return (('rfqId' in offerData) && offerData.rfqId != null && offerData.rfqId is string
              && exists(/databases/$(database)/documents/rfqs/$(offerData.rfqId)))
        ? actsOnRfq(get(/databases/$(database)/documents/rfqs/$(offerData.rfqId)).data)
        : (hasOrgPermission('offers.accept') || hasOrgPermission('po.approve') || hasOrgPermission('rfq.manage') || hasOrgPermission('rfq.create'));
    }

    // Runs RFQs (rfq-access.ts runsRfqs): the manager, a buyer, supply chain.
    function runsRfq(rfqData) {
      return hasRfqPermission(rfqData, 'offers.accept')
        || hasRfqPermission(rfqData, 'po.approve')
        || hasRfqPermission(rfqData, 'rfq.manage')
        || hasRfqPermission(rfqData, 'rfq.create');
    }

    // Acts on THIS RFQ (rfq-access.ts actsOnRfq): a buyer (no po.approve) on the
    // RFQs he raised; the manager and the owner on every one.
    function actsOnRfq(rfqData) {
      return runsRfq(rfqData)
        && (isOrgOwner()
            || hasRfqPermission(rfqData, 'po.approve')
            || rfqData.get('createdByUserId', rfqData.get('contractorId', '')) == request.auth.uid);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Accounts are only ever created server-side (Admin SDK bypasses this
      // rule): by the admin-create-account API, or by the invitation-accept
      // API on a user's first invited signup. Client-side self-registration
      // is intentionally not possible.
      allow create: if isAdmin();
      allow get: if isOwner(userId) || isOrgMember(resource.data.organizationId) || isSignedIn();
      allow list: if isSignedIn();
      // Self-updates must not touch org membership fields — joining a team goes
      // through the server-side invitation accept API, and nothing else. (A
      // branch here used to accept "an invitation doc addressed to the caller's
      // email" as the authorization; any signed-in user could write that doc
      // himself and make himself owner of any organisation, or platform Admin.)
      allow update: if isAdmin()
        || (
          // The owner or a purchasing manager sets a member's purchasing categories — that field only.
          isSignedIn()
          && request.auth.uid != userId
          && resource.data.organizationId == getOrganizationId()
          && (getUserData().organizationRole == 'owner' || hasOrgPermission('po.approve'))
          && changedKeys().hasOnly(['procurementCategories', 'updatedAt'])
          && request.resource.data.procurementCategories is list
          && request.resource.data.procurementCategories.size() <= 30
        )
        || (isOwner(userId)
        // Supplier specializations and coverage cities go live only through
        // admin approval: suppliers submit pendingSpecializations /
        // pendingCoverageCities and an admin copies them onto the live fields.
        // Anchored on primaryRole so switching into a secondary company can't
        // sidestep the gate on the primary supplier identity.
        && !(resource.data.get('primaryRole', resource.data.get('role', '')) == 'Supplier'
             && changedKeys()
                  .hasAny(['specializations', 'coverageCities']))
        && (
          // `role` and `primaryRole` are as security-sensitive as the org fields:
          // role gates entire portals (and isAdmin()), primaryRole anchors what
          // switching back to the primary company restores. Self-writes to them
          // are only allowed via the dedicated branches below.
          !changedKeys()
            .hasAny(['organizationId', 'organizationRole', 'defaultGroupId', 'role', 'primaryRole', 'procurementCategories'])
          || (
            // Anchoring the account's original role when creating the first
            // secondary company — may only record the CURRENT effective primary
            // role, never invent a different one.
            changedKeys().hasOnly(['primaryRole', 'orgMemberships', 'updatedAt'])
            && request.resource.data.primaryRole == resource.data.get('primaryRole', resource.data.get('role', ''))
          )
          || (
            // Multi-company switch: an account may only switch its active
            // organizationId into itself (its default org) or a secondary
            // company it created — never into an org owned by someone else.
            // `role` may change along with the switch (a secondary company can
            // be a Supplier company owned by a Contractor account, or vice
            // versa) but only to the target org's declared role; switching back
            // to the primary org restores the account's original primaryRole.
            // Both the existence check and the field defaults matter: reading
            // `.data` off a missing doc — or a missing field off a present one —
            // is an evaluation ERROR, which denies the write outright instead of
            // falling through to a clean "not your company" refusal.
            changedKeys().hasOnly(['organizationId', 'role', 'updatedAt'])
            && (
              (
                request.resource.data.organizationId == userId
                && request.resource.data.role == resource.data.get('primaryRole', resource.data.get('role', ''))
              )
              || (
                exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId))
                && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.get('ownerUserId', '') == userId
                && request.resource.data.role == get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.get('role', resource.data.get('role', ''))
              )
            )
          )
        ))
        || (
          // Org owner managing a TEAM MEMBER's doc — never their own (self-updates
          // must go through the restricted isOwner branches above; without the
          // self-exclusion this branch let owners forge organizationId/role freely).
          // Only the two team-management writes are allowed: assigning a group,
          // and removing a member (reverting them to their own solo org).
          isSignedIn()
          && request.auth.uid != userId
          && resource.data.organizationId == getOrganizationId()
          && getUserData().organizationRole == 'owner'
          && (
            changedKeys().hasOnly(['defaultGroupId', 'updatedAt'])
            || (
              changedKeys()
                .hasOnly(['organizationId', 'organizationRole', 'defaultGroupId', 'updatedAt'])
              && request.resource.data.organizationId == userId
              && request.resource.data.organizationRole == 'owner'
            )
          )
        );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        // Only the owner of the user doc can read their own notifications
        allow get, list: if isOwner(userId) || isAdmin();
        // Any signed-in user can create a notification for another user
        allow create: if isSignedIn();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /2fa/{docId} {
        // The sign-in code. Written and checked only by the server
        // (/api/sms, /api/auth/verify-2fa, both on the Admin SDK): a browser
        // that could read it could skip the step, and one that could write it
        // could choose its own code.
        allow read, write: if isAdmin();
      }

      // Supplier-saved quotation PDF templates, reused across offer submissions.
      match /quotationTemplates/{templateId} {
        allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Secondary companies an account creates for the multi-company switcher.
    // The account's default/primary company has no doc here — it's implicit
    // (organizationId == the owner's own uid), matching the original org model.
    match /organizations/{orgId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      // Supplier-company specializations/coverage follow the same admin-approval
      // gate as the primary supplier identity on users/{uid}.
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid
        && !(request.resource.data.get('role', '') == 'Supplier'
             && request.resource.data.keys().hasAny(['specializations', 'coverageCities']));
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerUserId == request.auth.uid
            && !(resource.data.get('role', '') == 'Supplier'
                 && changedKeys()
                      .hasAny(['specializations', 'coverageCities'])));
      allow delete: if isAdmin();
    }

    // A company's sensitive identity (CR and tax numbers, certificate files, bank details),
    // DEV-60. Its own team members cannot read it; the owner, the platform admin and outside
    // parties (who see the same facts on its orders and receipts) can. No enumeration, no delete.
    match /companyIdentity/{orgId} {
      allow get: if isSignedIn() && (isAdmin() || isCompanyOwner(orgId) || !isOrgMember(orgId));
      allow list: if isAdmin();
      allow create, update: if isAdmin() || isCompanyOwner(orgId);
      allow delete: if false;
    }

    // What the owner chooses to print on documents the team issues (purchase orders, quotations,
    // receipts) — the registration and tax numbers, only if the owner fills them in. The owner
    // writes; the whole team reads, because it is printed on their documents.
    match /companyPrintProfile/{orgId} {
      allow get: if isSignedIn() && (isAdmin() || isCompanyOwner(orgId) || isOrgMember(orgId));
      allow create, update: if isAdmin() || isCompanyOwner(orgId);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      // 'read' = get + list, safe for signed-in users (static reference data)
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // Both get and list are safe for all signed-in users (RFQs are semi-public)
      allow read: if isSignedIn();
      // A project-linked RFQ ("Tender") must belong to a project owned by the caller's org.
      // A standalone RFQ (no project — a quick, non-competitive price request) is also allowed,
      // as long as projectId is absent/null. organizationId must match the caller either way.
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.organizationId == getOrganizationId()
          && (
            (!('projectId' in request.resource.data)) || request.resource.data.projectId == null
            || (
              request.resource.data.projectId is string
              && request.resource.data.projectId.size() > 0
              && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.organizationId == getOrganizationId()
            )
          )
          // Whoever sources raises an RFQ: rfq.create, or the manager / a buyer (rfq-access.ts).
          && (hasRfqPermission(request.resource.data, 'rfq.create')
              || hasRfqPermission(request.resource.data, 'projects.publish')
              || hasRfqPermission(request.resource.data, 'offers.accept')
              || hasRfqPermission(request.resource.data, 'po.approve'))
        );
      // Org members / admins can update everything, but re-verify projectId ownership
      // on every update too (not just create) so an RFQ can't be re-pointed at a
      // project belonging to a different org after the fact.
      // Any signed-in user (e.g. a supplier submitting an offer) may increment
      // only the offersCount counter — no other field may change.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.organizationId == getOrganizationId()
          && (
            (!('projectId' in request.resource.data)) || request.resource.data.projectId == null
            || (
              request.resource.data.projectId is string
              && request.resource.data.projectId.size() > 0
              && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.organizationId == getOrganizationId()
            )
          )
          && (hasRfqPermission(resource.data, 'rfq.manage')
              || hasRfqPermission(resource.data, 'projects.publish')
              // The manager and the buyers complete and publish their own drafts.
              || ((hasRfqPermission(resource.data, 'offers.accept') || hasRfqPermission(resource.data, 'po.approve'))
                  && actsOnRfq(resource.data)
                  && resource.data.get('status', '') == 'Draft'))
        )
        // R-01 — the award from the comparison: New → Awarded, with the lines
        // nobody won and one log entry. The offers and orders are written in
        // the same transaction under their own rules.
        || (
          isSignedIn()
          && resource.data.organizationId == getOrganizationId()
          && rfqSameProject()
          && hasRfqPermission(resource.data, 'offers.accept') && actsOnRfq(resource.data)
          && resource.data.get('status', '') == 'New'
          && request.resource.data.status == 'Awarded'
          && changedKeys()
               .hasOnly(['status', 'awardedAt', 'unawardedLines', 'awardSplit', 'log', 'updatedAt'])
          && rfqLogAppendsOne()
        )
        // R-12 — cancelled before any award, with one of three reasons.
        || (
          isSignedIn()
          && resource.data.organizationId == getOrganizationId()
          && rfqSameProject()
          && actsOnRfq(resource.data)
          && resource.data.get('status', '') in ['New', 'Draft']
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.cancellation.code in ['need', 'spec', 'reissue']
          && request.resource.data.cancellation.byId == request.auth.uid
          && changedKeys()
               .hasOnly(['status', 'cancellation', 'cancelledAt', 'log', 'updatedAt'])
          && rfqLogAppendsOne()
        )
        // R-08 — «أغلِق الآن وافتح الأسعار»: the manager (po.approve) or the
        // owner, on an open RFQ, with a written reason; the deadline moves
        // back (never forward) and the close names him.
        || (
          isSignedIn()
          && resource.data.organizationId == getOrganizationId()
          && rfqSameProject()
          && (isOrgOwner() || hasOrgPermission('po.approve'))
          && resource.data.get('status', '') == 'New'
          && resource.data.get('closedEarly', null) == null
          && request.resource.data.deadline is string
          && request.resource.data.deadline < resource.data.get('deadline', '9999-12-31')
          && request.resource.data.closedEarly.byId == request.auth.uid
          && request.resource.data.closedEarly.reason is string
          && request.resource.data.closedEarly.reason.size() > 0
          && changedKeys()
               .hasOnly(['deadline', 'closedEarly', 'log', 'updatedAt'])
          && rfqLogAppendsOne()
        )
        // R-11 — the one reduction round to every live offer: recorded once,
        // never replaced (the offers go `مطلوب تخفيض` under their own rules).
        || (
          isSignedIn()
          && resource.data.organizationId == getOrganizationId()
          && rfqSameProject()
          && actsOnRfq(resource.data)
          && resource.data.get('status', '') == 'New'
          && resource.data.get('reductionRound', null) == null
          && request.resource.data.reductionRound.byId == request.auth.uid
          && changedKeys().hasOnly(['reductionRound', 'log', 'updatedAt'])
          && rfqLogAppendsOne()
        )
        // R-09/R-13/R-15/R-41 — the buyer's other acts only append to the log
        // (the offer's exclusion, the query's answer and an off-platform offer
        // are written under their own rules in the same transaction); an
        // off-platform offer also counts itself, by exactly one.
        || (
          isSignedIn()
          && resource.data.organizationId == getOrganizationId()
          && rfqSameProject()
          && actsOnRfq(resource.data)
          && changedKeys().hasOnly(['log', 'offersCount', 'updatedAt'])
          && request.resource.data.get('offersCount', 0) in [resource.data.get('offersCount', 0), resource.data.get('offersCount', 0) + 1]
          && rfqLogAppendsOne()
        )
        || (isSignedIn()
            && resource.data.organizationId == getOrganizationId()
            && actsOnRfq(resource.data)
            && resource.data.status == 'New'
            && resource.data.get('directAward', false) != true
            && request.resource.data.status == 'New'
            && rfqSameProject()
            && rfqLogAppendsOne()
            && changedKeys()
                 .hasOnly(['deadline', 'allowedSupplierOrgIds', 'invitedSupplierOrgIds', 'log', 'updatedAt']))
        || (
          isSignedIn()
          && changedKeys().hasOnly(['offersCount'])
        );
      // Only a draft is ever deleted; a published RFQ is cancelled with a reason (R-12).
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId()
            && resource.data.get('status', '') == 'Draft'
            && (hasRfqPermission(resource.data, 'rfq.manage')
                || hasRfqPermission(resource.data, 'projects.publish')
                || actsOnRfq(resource.data)))
        || (isSignedIn() && resource.data.contractorId == request.auth.uid
            && resource.data.get('status', '') == 'Draft');

      // Subcollection: inquiries (questions from suppliers about the RFQ)
      match /inquiries/{inquiryId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid)
          || (isSignedIn() && get(/databases/$(database)/documents/rfqs/$(rfqId)).data.organizationId == getOrganizationId());
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

      match /offers/{offerId} {
      // 'get' (single document): check the resource fields for ownership
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.organizationId == getOrganizationId() ||
        resource.data.contractorOrgId == getOrganizationId() ||
        isAdmin()
      );
      // 'list' (collection query): allow any signed-in user; the app's 'where' clause
      // (filtering by rfqId, organizationId, etc.) ensures data isolation.
      allow list: if isSignedIn();
      allow create: if isAdmin()
        || isSupplier()
        || (isSignedIn() && request.resource.data.supplierId == request.auth.uid)
        || (isSignedIn() && request.resource.data.organizationId == getOrganizationId())
        // Direct award: the CONTRACTOR creates the accepted offer on behalf of
        // the chosen supplier — only on their own RFQ, only born accepted, and
        // only with the same permission that accepting an offer requires.
        || (isSignedIn()
            && request.resource.data.get('directAward', false) == true
            && request.resource.data.status == 'مقبول'
            && request.resource.data.contractorOrgId == getOrganizationId()
            && request.resource.data.rfqId is string
            && get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data.organizationId == getOrganizationId()
            && hasRfqPermission(get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data, 'offers.accept'))
        || (isSignedIn()
            && request.resource.data.get('isManualOffer', false) == true
            && request.resource.data.status == 'قيد المراجعة'
            && request.resource.data.recordedById == request.auth.uid
            && request.resource.data.contractorOrgId == getOrganizationId()
            && request.resource.data.rfqId is string
            && get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data.organizationId == getOrganizationId()
            && get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data.status == 'New'
            && actsOnRfq(get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data));
      // Supplier can update their own offer; contractor-side updates (accept /
      // reject / reduction / sample requests) additionally require the
      // offers.accept permission (org owners always have it).
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.supplierId == request.auth.uid)
        || (isSignedIn() && resource.data.organizationId == getOrganizationId())
        || (isSignedIn() && resource.data.contractorId == request.auth.uid
            && hasOfferDecisionPermission(resource.data))
        || (isSignedIn() && resource.data.contractorOrgId == getOrganizationId()
            && hasOfferDecisionPermission(resource.data))
        || (isSignedIn() && resource.data.rfqId != null
            && (
              get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.organizationId == getOrganizationId()
              || get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.contractorId == request.auth.uid
            )
            && hasOfferDecisionPermission(resource.data));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.supplierId == request.auth.uid);
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if isSignedIn();
      // 'get' (single document): only parties to the chat
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      // 'list' (collection query): allow any signed-in user; app 'where' clause filters by orgId
      allow list: if isSignedIn();
      // Direct UID checks are evaluated first (no extra get() call) so they short-circuit
      // before getOrganizationId() is called — avoids a null-org denial.
      allow update: if isSignedIn() && (
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    // Internal same-company chat — one channel per organization, doc id == organizationId.
    match /teamChats/{orgId} {
      allow get, create, update: if isOrgMember(orgId) || isAdmin();
      allow list: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isOrgMember(orgId) || isAdmin();
        allow create: if isOrgMember(orgId) && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Top-level messages collection (used by mobile app)
    match /messages/{messageId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    // Invitations — contractor invites supplier by email; also used for team member invites
    // Docs carry a secret inviteToken (capability for the email invite link), so
    // listing is restricted to the invitee and the inviter — queries must filter
    // on email == own email or invitedBy == own uid.
    match /invitations/{invitationId} {
      allow list: if isAdmin() || (isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid ||
        (resource.data.get('type', '') == 'supplier_invite' && isOrgMember(resource.data.get('contractorOrgId', '')))
      ));
      // An invitation is an authorization: the accept API reads its organisation,
      // role and group and writes them on the accepting account. So it is written
      // only by the server (/api/invitations/send, Admin SDK) — never by a client,
      // who could otherwise invite himself anywhere as anything.
      allow create: if isAdmin();
      allow get: if isSignedIn() && (resource == null || resource.data.email == request.auth.token.email || resource.data.invitedBy == request.auth.uid
        || (resource.data.get('type', '') == 'supplier_invite' && isOrgMember(resource.data.get('contractorOrgId', ''))));
      // The invitee answers a pending one (accept · decline); whoever sent it
      // cancels it or records that he re-sent it; a colleague with
      // suppliers.manage records a re-send. Nobody changes what it authorizes.
      allow update: if isSignedIn() && (
        (resource.data.email == request.auth.token.email
          && resource.data.get('status', 'pending') == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && changedKeys().hasOnly(['status', 'acceptedAt', 'declinedAt', 'respondedAt', 'updatedAt'])) ||
        (resource.data.invitedBy == request.auth.uid
          && request.resource.data.get('status', 'pending') in [resource.data.get('status', 'pending'), 'cancelled']
          && changedKeys().hasOnly(['status', 'cancelledAt', 'sentChannel', 'sentAt', 'updatedAt'])) ||
        (resource.data.get('type', '') == 'supplier_invite'
          && isOrgMember(resource.data.get('contractorOrgId', ''))
          && procSupplierManager()
          && changedKeys().hasOnly(['sentChannel', 'sentAt']))
      );
      allow delete: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      );
    }

    // Module access requests — a team member asks the org owner for access to
    // a portal module they can't open. The owner's uid IS the member's
    // organizationId, so owner reads/resolves via organizationId == their uid.
    match /accessRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.organizationId == getOrganizationId()
        && request.resource.data.status == "pending";
      allow get, list: if isSignedIn() && (
        resource == null ||
        resource.data.requesterId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.organizationId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == request.auth.uid);
    }

    // Guest RFQ share links — created and consumed exclusively by the
    // server (Admin SDK) via /api/rfq-share/*. The tokens inside grant
    // unauthenticated access to an RFQ, so clients must never read them.
    match /rfqShareLinks/{linkId} {
      allow read, write: if false;
    }

    // Private per-offer links that let a guest supplier (no account) keep the
    // RFQ workflow going — revised prices, sample confirmation, delivery
    // notices. Holding the token IS the credential, so these docs are reachable
    // only through the server routes that verify it (Admin SDK).
    // One-time codes (src/lib/otp.ts). Server-only: the code's hash, its
    // expiry and its attempt count are never a browser's business.
    // Receipt links (src/lib/receipt-links.ts, 22 Sep review): the token IS
    // the key to a delivery's receiving form, so only the server reads or
    // writes them — as with rfqShareLinks and guestOfferLinks.
    match /receiptLinks/{linkId} {
      allow read, write: if false;
    }

    // PM consultant portal links (src/lib/pm/portal-links.ts): the token and
    // the hashed sessions are the consultant's keys to a project, and the
    // mobile number is his — only the server reads or writes them.
    match /pmPortalLinks/{linkId} {
      allow read, write: if false;
    }

    match /otpChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /guestOfferLinks/{linkId} {
      allow read, write: if false;
    }

    // Team permission groups — org-scoped. Members read their org's groups
    // (queries must filter organizationId == own org); only the org owner
    // manages them. The Super Admin system group (isSystem) is immutable.
    match /teamGroups/{groupId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.organizationId == getOrganizationId());
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.organizationId == getOrganizationId()
        && getUserData().organizationRole == 'owner');
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.organizationId == getOrganizationId()
        && getUserData().organizationRole == 'owner'
        && resource.data.isSystem != true
        && request.resource.data.organizationId == resource.data.organizationId);
      allow delete: if isAdmin() || (isSignedIn()
        && resource.data.organizationId == getOrganizationId()
        && getUserData().organizationRole == 'owner'
        && resource.data.isSystem != true);
    }

    // Team activity audit log — append-only from clients; org-scoped reads
    // (queries must filter organizationId == own org).
    match /teamActivity/{activityId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.organizationId == getOrganizationId());
      allow create: if isSignedIn()
        && request.resource.data.organizationId == getOrganizationId()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }

    // Contractor–Supplier connection requests (supplier sends request → contractor accepts)
    match /contractorSupplierLinks/{linkId} {
      // Both parties can read their own links
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier-initiated requests, supplier accepting a contractor invitation,
      // OR a contractor marking a supplier as favorite (auto-connects immediately,
      // skipping the invite-and-wait step).
      allow create: if isSignedIn()
        && (
          (request.resource.data.supplierOrgId == getOrganizationId()
            && (request.resource.data.requestedBy == "supplier" || request.resource.data.requestedBy == "contractor"))
          || (request.resource.data.contractorOrgId == getOrganizationId()
              && request.resource.data.requestedBy == "contractor_favorite"
              && request.resource.data.status == "active"
              && procSupplierManager())
          // «أضِفه إلى مورّدينا» from the platform directory
          || (request.resource.data.contractorOrgId == getOrganizationId()
              && request.resource.data.requestedBy == "contractor_directory"
              && request.resource.data.status == "active"
              && procSupplierManager())
        );
      // Contractors can accept/reject (update status); suppliers can cancel their own request
      allow update: if isSignedIn() && (
        // Our side is Procurement's buyers and manager (not an expediter who only reads the list).
        (resource.data.contractorOrgId == getOrganizationId() && procSupplierManager()) ||
        (resource.data.supplierOrgId == getOrganizationId() && resource.data.requestedBy == "supplier") ||
        isAdmin()
      );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.supplierOrgId == getOrganizationId());
    }

    // Project tracking — contractor org-scoped
    match /projects/{projectId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.organizationId == getOrganizationId() ||
        isAdmin()
      );
      // Every query filters on the caller's organisation; without the condition
      // any signed-in account of any company could list every company's projects.
      // (A solo account is its own organisation: its uid, whatever its user doc carries.)
      allow list: if isSignedIn()
        && (resource.data.organizationId == request.auth.uid || resource.data.organizationId == getOrganizationId() || isAdmin());
      // A CRM handover creates the project too — that path is gated by
      // crm.close and is only allowed to write a project that names its deal.
      // A manual project is a PM 1.0 project, created only with the PM `create` key
      // (owner / '*' / pm.manage); a legacy create may not carry a `pm` block (G-28).
      allow create: if isContractor()
        && request.resource.data.organizationId == getOrganizationId()
        && ((hasOrgPermission('projects.edit') && pmCeilingHas('create') && !('pm' in request.resource.data))
            || (hasOrgPermission('crm.close')
                && ('sourceOpportunityId' in request.resource.data)
                && request.resource.data.sourceOpportunityId is string)
            || acceptsPmHandover()
            || createsManualPmProject());
      // Editing needs projects.edit; publishing flows also update the project
      // doc (linked rfqIds), so projects.publish qualifies too. The project
      // manager named in a pending handover may answer it — and touch nothing
      // else — regardless of their group.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId()
            && (((hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'))
                  // C-02: on a PM project the handover's facts move only through the PM branches;
                  // and a legacy project is brought into PM 1.0 (given a `pm` block) by the owner alone.
                  && (('pm' in resource.data)
                      ? !changedKeys()
                            .hasAny(['budget', 'clientName', 'clientType', 'status', 'pm', 'projectType', 'contractNumber', 'projectManagerId'])
                      : (!('pm' in request.resource.data) || pmCeilingHas('admin'))))
                || (('handover' in resource.data)
                    && resource.data.handover.pmId == request.auth.uid
                    && changedKeys().hasOnly(['handover', 'updatedAt']))
                // PM 1.0: the project manager completes the terms before start and starts
                // the project — the `pm` block and the status, nothing else.
                || (resource.data.get('projectManagerId', '') == request.auth.uid
                    && ('pm' in resource.data)
                    && changedKeys().hasOnly(['pm', 'status', 'updatedAt']))
                // PM 1.0: whoever measures numbers their sheet — `pm.sheetCount`, nothing else.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'measure')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['sheetCount']))
                // …certificates keep the project's running totals — the retention held
                // (what an addendum's cap is checked against), the advance recovered, the
                // deductions returned to unbilled, and the certificate count.
                || (('pm' in resource.data)
                    && (pmDuty(projectId, 'prep') || pmDuty(projectId, 'ipcOk') || pmDuty(projectId, 'approve'))
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys()
                         .hasOnly(['ipcCount', 'lastIpcOn', 'retentionHeld', 'advanceRecovered', 'cutPool']))
                // …and whoever records inspections numbers theirs — `pm.wirCount`.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'qa')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['wirCount', 'punchCount', 'ncrCount', 'itpCount']))
                // …whoever drafts claims numbers them — `pm.claimCount`; a grant with
                // days draws the next programme revision (`pm.programmeRev`, approve).
                || (('pm' in resource.data)
                    && (pmDuty(projectId, 'prep') || pmDuty(projectId, 'approve'))
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['claimCount']))
                // …whoever records samples numbers them — `pm.sampleCount`.
                || (('pm' in resource.data)
                    && (pmDuty(projectId, 'measure') || pmDuty(projectId, 'approve'))
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['sampleCount']))
                // …whoever logs variations numbers them — `pm.voCount`.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'vo')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['voCount']))
                // …whoever holds `sub` numbers subcontracts and their certificates.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'sub')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['subcontractCount', 'subCertCount']))
                // …whoever moves store material numbers a subcontractor's custody line.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'req')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['subCustodyCount']))
                // …whoever holds `corr` numbers letters — `pm.letterCount` (the doc id)
                // and the direction's own sequence `pm.lettersOut` / `pm.lettersIn`.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'corr')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['letterCount', 'lettersOut', 'lettersIn']))
                // RL-07: the owner appoints, replaces and removes the project manager — the
                // team write names him on the project in the same transaction as his seat.
                || (('pm' in resource.data)
                    && pmCeilingHas('admin')
                    && changedKeys().hasOnly(['projectManagerId', 'projectManagerName', 'updatedAt']))
                // AMD-03: whoever drafts an addendum numbers it — `pm.addendaCount`, nothing
                // else; signing (which moves `signedCount`) stays with approve, below.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'prep')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['addendaCount']))
                // C-02: on a PM project the file edits location + consultant only (approve).
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'approve')
                    && changedKeys().hasOnly(['location', 'consultant', 'updatedAt']))
                // C-14: an approver drafts AND signs an addendum in one step.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'approve')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    // …and leaves the contract in force on the project (`pm.inForce`) for
                    // those who may not read the addenda. `pm.terms` / `pm.original` stay frozen (below).
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['addendaCount', 'signedCount', 'inForce']))
                // …whoever requests material numbers requests, direct purchases and
                // equipment requests (`req`); whoever receives on site numbers the
                // project receipts (`rcv`).
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'req')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['mrCount', 'pettyCount', 'plantCount', 'plantReqCount']))
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'rcv')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['grnCount']))
                // …whoever holds `approve` approves the monthly reconciliation —
                // `pm.eac` (the approved estimate) and `pm.budCount` (its revision).
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'approve')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['eac', 'budCount'])
                    && request.resource.data.pm.budCount == resource.data.pm.get('budCount', 0) + 1
                    && request.resource.data.pm.eac.by == request.auth.uid
                    && request.resource.data.pm.eac.v is number && request.resource.data.pm.eac.v > 0)
                // …whoever raises obstacles numbers them — RFIs and other obstacles
                // apart (`pm.rfiCount`, `pm.obstacleCount`): the site record (daily)
                // or the manager (approve).
                || (('pm' in resource.data)
                    && (pmDuty(projectId, 'daily') || pmDuty(projectId, 'approve'))
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['rfiCount', 'obstacleCount']))
                // …and safety numbers its incidents and permits.
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'hse')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['incidentCount', 'permitCount']))
                // …and so may whoever the guard allows on the pm block: the terms need
                // money + (all | approve), everything else on it needs approve.
                || (('pm' in resource.data)
                    && (pmDuty(projectId, 'approve') || (pmCeilingHas('money') && pmCeilingHas('all')))
                    && changedKeys().hasOnly(['pm', 'status', 'updatedAt']))
                // …Finance releases the retention a handover made claimable — the flag
                // the close-out gate reads (`pm.retentionReleased`), nothing else.
                || (('pm' in resource.data)
                    && hasOrgPermission('invoices.manage')
                    && changedKeys().hasOnly(['pm', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['retentionReleased', 'retentionHalfReleased'])
                    && request.resource.data.pm.get('retentionReleased', false) in [true, resource.data.pm.get('retentionReleased', false)]
                    && request.resource.data.pm.get('retentionHalfReleased', false) in [true, resource.data.pm.get('retentionHalfReleased', false)])
                // …and the sections, switched by approve and logged in pm.secLog (SEC-04).
                || (('pm' in resource.data)
                    && pmDuty(projectId, 'approve')
                    && changedKeys().hasOnly(['pm', 'enabledSections', 'updatedAt'])
                    && request.resource.data.pm.diff(resource.data.pm).affectedKeys().hasOnly(['secLog'])))
            // An archived PM project accepts no change from anyone but an admin (RL-04, INV-21).
            && !pmArchivedData(resource.data)
            // Once frozen at start, the original — and the terms it was frozen from — never
            // change again: every later change is an addendum on top (TRM-02, INV-22).
            && (!('pm' in resource.data)
                || resource.data.pm.get('original', null) == null
                || (request.resource.data.get('pm', {}).get('original', null) == resource.data.pm.original
                    && request.resource.data.get('pm', {}).get('terms', null) == resource.data.pm.get('terms', null))));
      // A PM 1.0 project is closed and archived, never deleted: its frozen contract,
      // certificates and outbox events outlive it. Only an admin removes one.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId()
            && !('pm' in resource.data)
            && hasProjectPermission(projectId, 'projects.delete'));

      // BOQ items subcollection — same org as the project.
      // Once an item is pushed to a tender (isEditable == false), it is hard-locked:
      // no field may change except the specific "unlock" transition performed when
      // the item is removed from the tender or the tender itself is deleted.
      match /boqItems/{itemId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish')
              || isPmProjectManager(projectId)
              || (pmCeilingHas('create') && ('pm' in projectData(projectId))));

        // A fully drawn (locked) line accepts only the draw bookkeeping: an RFQ
        // being deleted hands its quantity back (`draws`/`drawnQuantity`
        // shrink, the line may reopen), or the whole line is unlocked. Nothing
        // else on a locked row may change.
        allow update: if inOpenProject(projectId)
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'))
          // On a PM 1.0 project this path never moves "executed" — only an approved sheet does.
          && (!('pm' in projectData(projectId))
              || !changedKeys().hasAny(['executedQuantity']))
          // C-01: a PM project's BOQ is read-only once started.
          && (!('pm' in projectData(projectId))
              || projectData(projectId).pm.get('lifecycle', 'plan') == 'plan'
              || !changedKeys()
                    .hasAny(['quantity', 'unitPrice', 'estCost', 'itemNo', 'descriptionAr', 'descriptionEn', 'unit']))
          && (
            resource.data.isEditable != false
            ||
            // executedQuantity: site measurements accumulate on locked lines
            // too — being drawn into a tender doesn't stop work on site.
            changedKeys()
              .hasOnly(['isEditable', 'tenderId', 'draws', 'drawnQuantity', 'executedQuantity', 'updatedAt'])
          );

        allow delete: if inOpenProject(projectId)
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'))
          && resource.data.isEditable != false
          && (!('pm' in projectData(projectId))
              || projectData(projectId).pm.get('lifecycle', 'plan') == 'plan');

        // C-05: an unpriced line is priced ONCE by the agreed rate — prep|approve with money.
        allow update: if inOpenProject(projectId)
          && ('pm' in projectData(projectId))
          && (pmDuty(projectId, 'prep') || pmDuty(projectId, 'approve'))
          && pmCeilingHas('money')
          && !(resource.data.get('unitPrice', 0) is number && resource.data.get('unitPrice', 0) > 0)
          && !(resource.data.get('unitPrice', '') is string && resource.data.get('unitPrice', '') != '' && resource.data.get('unitPrice', '') != '0')
          && request.resource.data.unitPrice is number && request.resource.data.unitPrice > 0
          && request.resource.data.pricedBy == request.auth.uid
          && changedKeys()
               .hasOnly(['unitPrice', 'estCost', 'pricedBy', 'pricedByName', 'pricedOn', 'updatedAt']);

        // PM 1.0 (MS-02): on a PM project "executed" moves only by an approved
        // measurement sheet — the approver writes it, and only it.
        allow update: if inOpenProject(projectId)
          && ('pm' in projectData(projectId))
          && pmDuty(projectId, 'approve')
          && changedKeys().hasOnly(['executedQuantity', 'updatedAt']);
        // …a certificate bills the line (prepare), or gives it back (withdraw).
        allow update: if inOpenProject(projectId)
          && ('pm' in projectData(projectId))
          && (pmDuty(projectId, 'prep') || pmDuty(projectId, 'approve'))
          && changedKeys().hasOnly(['billedQuantity', 'updatedAt'])
          && request.resource.data.billedQuantity is number
          && request.resource.data.billedQuantity >= 0
          && request.resource.data.billedQuantity <= resource.data.get('executedQuantity', 0) + 0.01;
        // …the line's last inspection result is written by quality (`qa`), one of the
        // known states only (WIR-03); which lines require inspection is `approve`'s.
        allow update: if inOpenProject(projectId)
          && ('pm' in projectData(projectId))
          && ((pmDuty(projectId, 'qa')
                && changedKeys().hasOnly(['pmWir', 'updatedAt'])
                && request.resource.data.pmWir in ['open', 'pass', 'cond', 'fail'])
              || (pmDuty(projectId, 'approve')
                && changedKeys().hasOnly(['pmInspect', 'updatedAt'])
                && request.resource.data.pmInspect is bool)
              // …the latest sample state (SUB-01) by measure | approve; which lines
              // require a sample is approve's.
              || ((pmDuty(projectId, 'measure') || pmDuty(projectId, 'approve'))
                && changedKeys().hasOnly(['pmSub', 'pmSubRev', 'updatedAt'])
                && request.resource.data.pmSub in ['sub', 'appA', 'appB', 'rej'])
              || (pmDuty(projectId, 'approve')
                && changedKeys().hasOnly(['pmSample', 'updatedAt'])
                && request.resource.data.pmSample is bool));
      }

      // Project team assignments — which org member works on this project and
      // with which permission group. Org members read; the org owner manages.
      match /members/{memberId} {
        allow read: if inProject(projectId);

        // The legacy assignment (a permission group on a project). On a PM project
        // it may not set or change the PM 1.0 seat — its role, the duties removed,
        // its exit or its log: those go through the PM branches below (RL-07, TM-01).
        allow create: if isAdmin() || (inOpenProject(projectId)
          && hasOrgPermission('team.manage')
          && (!('pm' in projectData(projectId))
              || !request.resource.data.keys().hasAny(['pmRole', 'off', 'to', 'log'])));
        allow update: if isAdmin() || (inOpenProject(projectId)
          && hasOrgPermission('team.manage')
          && (!('pm' in projectData(projectId))
              || !changedKeys().hasAny(['pmRole', 'off', 'to', 'log', 'from', 'why', 'byOut'])));
        // A seat on a PM 1.0 project is never deleted: an exit closes it and the
        // person's records stay in their name (TM-01).
        allow delete: if isAdmin() || (inOpenProject(projectId)
          && !('pm' in projectData(projectId))
          && hasOrgPermission('team.manage'));
        // PM 1.0 (WF-24, RL-07): on a PM project the team is managed by `all`, or by
        // `approve` on the project; a seat that is or becomes the project manager's is
        // the owner's alone (`admin`). Nothing on an archived project.
        allow create: if inOpenProject(projectId)
          && ('pm' in projectData(projectId))
          && !pmArchivedData(projectData(projectId))
          && (pmCeilingHas('all') || pmDuty(projectId, 'approve'))
          && request.resource.data.userId == memberId
          && request.resource.data.get('pmRole', '') in ['pm', 'site', 'qs', 'hse', 'supervisor', 'other']
          && request.resource.data.get('to', null) == null
          && (request.resource.data.pmRole != 'pm' || pmCeilingHas('admin'))
          && pmSeatGroupOk(memberId);
        allow update: if inOpenProject(projectId)
          && ('pm' in projectData(projectId))
          && !pmArchivedData(projectData(projectId))
          && (pmCeilingHas('all') || pmDuty(projectId, 'approve'))
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.get('pmRole', '') in ['pm', 'site', 'qs', 'hse', 'supervisor', 'other']
          && ((request.resource.data.pmRole != 'pm' && resource.data.get('pmRole', '') != 'pm') || pmCeilingHas('admin'))
          // …and on an existing assignment the group stays, or becomes his default.
          && (request.resource.data.get('groupId', null) == resource.data.get('groupId', null) || pmSeatGroupOk(memberId));
        // A CRM handover seats the project manager on the project it just
        // created — one member, flagged as such, on a project that names its deal.
        allow create: if inOpenProject(projectId)
          && hasOrgPermission('crm.close')
          && ('sourceOpportunityId' in projectData(projectId))
          && request.resource.data.viaHandover == true
          && request.resource.data.userId == memberId;
        // PM 1.0: the manager who accepted the handover seats themself as its PM.
        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.userId == memberId
          && request.resource.data.viaHandover == true
          && request.resource.data.get('pmRole', '') == 'pm'
          && pmSeatGroupOk(memberId)
          && isPmProjectManager(projectId);
        // …and whoever accepted it (the project's `contractorId`) seats the manager
        // the project names and, optionally, a site engineer — only before start.
        allow create: if inProject(projectId)
          && projectData(projectId).get('pmHandoverId', '') != ''
          && projectData(projectId).get('contractorId', '') == request.auth.uid
          && projectData(projectId).pm.get('lifecycle', '') == 'plan'
          && request.resource.data.userId == memberId
          && request.resource.data.viaHandover == true
          && pmSeatGroupOk(memberId)
          && ((request.resource.data.get('pmRole', '') == 'pm'
               && projectData(projectId).get('projectManagerId', '') == memberId)
              || request.resource.data.get('pmRole', '') == 'site');
        // …and whoever created a manual project seats its manager and a site engineer.
        allow create: if inProject(projectId)
          && projectData(projectId).get('pm', {}).get('manual', false) == true
          && projectData(projectId).get('contractorId', '') == request.auth.uid
          && projectData(projectId).pm.get('lifecycle', '') == 'plan'
          && request.resource.data.userId == memberId
          && request.resource.data.viaManual == true
          && pmSeatGroupOk(memberId)
          && ((request.resource.data.get('pmRole', '') == 'pm'
               && projectData(projectId).get('projectManagerId', '') == memberId)
              || request.resource.data.get('pmRole', '') == 'site');
      }

      // PM 1.0 contract addenda (AMD-01…10) — `pmAddenda/{NN}`, numbered by the
      // project's `pm.addendaCount`. Seen by money or approve holders only, never a
      // site engineer (AMD-10). Drafted by prep | approve on a started, unarchived
      // project; signed by approve; withdrawn by its drafter or approve. A draft is
      // the only state that moves, and it moves once: signed or void. Never deleted.
      match /pmAddenda/{addendumId} {
        allow read: if inProject(projectId)
          && (pmCeilingHas('money') || pmDuty(projectId, 'approve'));

        allow create: if inOpenProject(projectId)
          && projectData(projectId).get('pm', {}).get('lifecycle', 'plan') in ['live', 'hold', 'done']
          && (pmDuty(projectId, 'prep') || pmDuty(projectId, 'approve'))
          && (request.resource.data.status == 'draft'
              || (request.resource.data.status == 'signed'
                  && pmDuty(projectId, 'approve')
                  && request.resource.data.signedBy == request.auth.uid
                  && request.resource.data.signedOn is string))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.changes is list && request.resource.data.changes.size() > 0;

        allow update: if inOpenProject(projectId)
          && resource.data.status == 'draft'
          && ((request.resource.data.status == 'signed'
                && pmDuty(projectId, 'approve')
                && request.resource.data.signedBy == request.auth.uid
                && changedKeys()
                     .hasOnly(['status', 'signedOn', 'signedSeq', 'signedBy', 'signedByName', 'signatory', 'files', 'updatedAt']))
              || (request.resource.data.status == 'void'
                && (pmDuty(projectId, 'approve')
                    || (resource.data.by == request.auth.uid && pmDuty(projectId, 'prep')))
                && request.resource.data.voidBy == request.auth.uid
                && changedKeys()
                     .hasOnly(['status', 'voidOn', 'voidBy', 'voidByName', 'voidReason', 'voidText', 'updatedAt'])));

        allow delete: if isAdmin();
      }

      // PM 1.0 measurement sheets (MS-01…04) — `pmSheets/{NN}`. Written by `measure`
      // ("wait"), or approved at once when the writer also holds `approve` (marked
      // self). The approver moves a waiting sheet once: ok or sent back. Never deleted.
      match /pmSheets/{sheetId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'measure')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.lines is list && request.resource.data.lines.size() > 0
          && (request.resource.data.status == 'wait'
              || (request.resource.data.status == 'ok' && request.resource.data.self == true
                  && request.resource.data.okBy == request.auth.uid && pmDuty(projectId, 'approve')));

        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && resource.data.status == 'wait'
          && request.resource.data.status in ['ok', 'no']
          && request.resource.data.okBy == request.auth.uid
          && changedKeys()
               .hasOnly(['status', 'lines', 'okBy', 'okByName', 'okAt', 'self', 'returnNote', 'updatedAt']);

        allow delete: if isAdmin();
      }

      // PM 1.0 inspection requests (WIR-01…03) — `pmInspections/{NN}`. Recorded by
      // quality (`qa`); the status is one of four known states, never undefined —
      // a result saved without a choice once crashed the whole screen. Never deleted.
      match /pmInspections/{inspectionId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'qa')
          && request.resource.data.status == 'open'
          && request.resource.data.seq is int
          && request.resource.data.location is string && request.resource.data.location.size() > 0
          && request.resource.data.attempts is list && request.resource.data.attempts.size() == 1;

        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'qa')
          && request.resource.data.status in ['open', 'pass', 'cond', 'fail']
          && ((resource.data.status == 'open' && request.resource.data.status in ['pass', 'cond', 'fail'])
              || (resource.data.status == 'fail' && request.resource.data.status == 'open'
                  && request.resource.data.attempts.size() == resource.data.attempts.size() + 1))
          && changedKeys().hasOnly(['status', 'attempts', 'updatedAt']);

        allow delete: if isAdmin();
      }

      // PM 1.0 owner certificates (IPC-01…05, RET-01) — `pmCertificates/{NN}`. Seen by
      // holders of money. Prepared by prep + ipc + client ("int"); approved internally
      // by ipcOk and NEVER by its preparer ("sub"); certified by ipcOk
      // ("appr"); withdrawn before submission by its preparer or approve ("void").
      match /pmCertificates/{certId} {
        // Finance reads them too: it posts and collects what PM certified.
        allow read: if inProject(projectId)
          && (pmCeilingHas('money') || hasOrgPermission('invoices.manage') || hasOrgPermission('accounting.view'));

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'prep') && pmDuty(projectId, 'ipc') && pmDuty(projectId, 'client')
          && request.resource.data.status == 'int'
          && request.resource.data.prep == request.auth.uid
          && request.resource.data.gross is number && request.resource.data.gross > 0
          && request.resource.data.seq is int;

        // The project's own acts need it open. Finance's collection does not: the
        // close gate lets a project archive with a certified certificate that is
        // not yet due, and the client's payment on it must still be recordable.
        allow update: if inProject(projectId)
          && ((projectOpen(projectId) && ((resource.data.status == 'int' && request.resource.data.status == 'sub'
                && pmDuty(projectId, 'ipcOk')
                && request.resource.data.appr == request.auth.uid
                // Two people (IPC-02). A small firm's recorded self-approval needs a company
                // setting that does not exist yet — until it does, never the preparer.
                && ((resource.data.prep != request.auth.uid && request.resource.data.selfApp == false)
                    || (resource.data.prep == request.auth.uid && request.resource.data.selfApp == true
                        && exists(/databases/$(database)/documents/pmSettings/$(projectData(projectId).organizationId))
                        && get(/databases/$(database)/documents/pmSettings/$(projectData(projectId).organizationId)).data.get('selfApproval', false) == true))
                && changedKeys()
                     .hasOnly(['status', 'appr', 'apprName', 'apprOn', 'selfApp', 'updatedAt']))
              || (resource.data.status == 'sub' && request.resource.data.status == 'appr'
                && pmDuty(projectId, 'ipcOk')
                && request.resource.data.certBy == request.auth.uid
                && request.resource.data.certified is number
                && request.resource.data.certified > 0
                && request.resource.data.certified <= resource.data.gross + 0.01)
              || (resource.data.status == 'int' && request.resource.data.status == 'void'
                && (pmDuty(projectId, 'approve') || (resource.data.prep == request.auth.uid && pmDuty(projectId, 'prep')))
                && changedKeys()
                     .hasOnly(['status', 'voidBy', 'voidByName', 'voidOn', 'updatedAt']))))
              // Finance records what the client paid on a certified certificate: the
              // collected share only grows, and "paid" is reached only at the whole net.
              || ((resource.data.status == 'appr' || resource.data.status == 'part')
                && (request.resource.data.status == 'part' || request.resource.data.status == 'paid')
                && hasOrgPermission('invoices.manage')
                && request.resource.data.collected is number
                && request.resource.data.collected > resource.data.get('collected', 0)
                && request.resource.data.collected <= 1
                && (request.resource.data.status == 'part' || request.resource.data.collected == 1)
                && changedKeys()
                     .hasOnly(['status', 'collected', 'collections', 'collectedOn', 'updatedAt'])));

        allow delete: if isAdmin();
      }

      // PM 1.0 punch list (PN-01…03) — `pmPunch/{NN}`. Quality (`qa`) raises it with an
      // exact location, records the fix, then records the raising party's confirmation:
      // open → fix → done, one step at a time. Never deleted.
      // PM 1.0 variation orders (VO-01…03) — `pmVariations/{NN}`. Logged by `vo`,
      // priced while a draft, submitted only when priced; the decision is
      // `approve`'s and a rejection states its reason. Logging is not approval.
      match /pmVariations/{voId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'vo')
          && request.resource.data.status == 'draft'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.value is number && request.resource.data.value >= 0;

        allow update: if inOpenProject(projectId)
          && ((pmDuty(projectId, 'vo') && resource.data.status == 'draft'
                && request.resource.data.status in ['draft', 'wait']
                && (request.resource.data.status == 'draft' || request.resource.data.value > 0)
                && changedKeys().hasOnly(['value', 'cost', 'instructionNo', 'executedPct', 'status', 'days', 'files', 'updatedAt']))
              || (pmDuty(projectId, 'vo') && resource.data.status in ['wait', 'appr']
                && request.resource.data.status == resource.data.status
                && changedKeys().hasOnly(['executedPct', 'instructionNo', 'updatedAt']))
              || (pmDuty(projectId, 'approve') && resource.data.status == 'wait'
                && request.resource.data.status in ['appr', 'rej']
                && request.resource.data.decision.by == request.auth.uid
                && request.resource.data.decision.on is string
                && request.resource.data.decision.on >= resource.data.day
                && (request.resource.data.status == 'appr'
                    || (request.resource.data.decision.reason is string && request.resource.data.decision.reason.size() > 0))
                && changedKeys().hasOnly(['status', 'decision', 'updatedAt']))
              // A certificate moves an approved variation's billed share — up to its
              // executed share when prepared, back down when withdrawn (IPC-01).
              || (resource.data.status == 'appr'
                && request.resource.data.status == 'appr'
                && ((pmDuty(projectId, 'prep') && pmDuty(projectId, 'ipc') && pmDuty(projectId, 'client'))
                    || pmDuty(projectId, 'approve'))
                && request.resource.data.billedPct is number
                && request.resource.data.billedPct >= 0
                && request.resource.data.billedPct <= resource.data.executedPct + 0.000001
                && changedKeys().hasOnly(['billedPct', 'updatedAt'])));

        allow delete: if isAdmin();
      }

      // PM 1.0 material submittals (SUB-01…03) — `pmSubmittals/{NN}`. Submitted and
      // answered by measure | approve; a reply is one of three, never undefined.
      match /pmSubmittals/{submittalId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && (pmDuty(projectId, 'measure') || pmDuty(projectId, 'approve'))
          && request.resource.data.status == 'sub'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int && request.resource.data.rev is int;

        allow update: if inOpenProject(projectId)
          && (pmDuty(projectId, 'measure') || pmDuty(projectId, 'approve'))
          && resource.data.status == 'sub'
          && request.resource.data.status in ['appA', 'appB', 'rej']
          && changedKeys().hasOnly(['status', 'reply', 'updatedAt']);

        allow delete: if isAdmin();
      }

      // PM 1.0 claims and extensions of time (CLM-01…03) — `pmClaims/{NN}`.
      // Drafted and noticed by prep | approve; submitted and answered by approve;
      // a response is one of three, with its days (0 when rejected or cost only).
      match /pmClaims/{claimId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && (pmDuty(projectId, 'prep') || pmDuty(projectId, 'approve'))
          && (request.resource.data.status == 'draft'
              || (request.resource.data.status == 'notice' && request.resource.data.noticeOn is string))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.cause is string && request.resource.data.cause.size() > 0;

        allow update: if inOpenProject(projectId)
          && (((pmDuty(projectId, 'prep') || pmDuty(projectId, 'approve'))
                && resource.data.status == 'draft' && request.resource.data.status == 'notice'
                && changedKeys().hasOnly(['status', 'noticeOn', 'updatedAt']))
              || (pmDuty(projectId, 'approve')
                && resource.data.status == 'notice' && request.resource.data.status == 'sub'
                && changedKeys().hasOnly(['status', 'submittedOn', 'daysAsked', 'amountAsked', 'updatedAt']))
              || (pmDuty(projectId, 'approve')
                && resource.data.status == 'sub' && request.resource.data.status in ['appr', 'part', 'rej']
                && request.resource.data.response.by == request.auth.uid
                && request.resource.data.response.days is int && request.resource.data.response.days >= 0
                && changedKeys().hasOnly(['status', 'response', 'revision', 'updatedAt'])));

        allow delete: if isAdmin();
      }

      // PM 1.0 non-conformance (NCR-01) — `pmNcrs/{NN}`. Recorded by quality:
      // open → corrective plan → closed on the consultant's acceptance.
      // PM 1.0 programme activities (PRG-01) — `pmActivities/{NN}`, laid over the
      // approved programme by approve; edited, never deleted. The number is drawn
      // from `pm.activityCount` by the same approve branch on the project.
      match /pmActivities/{activityId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.from is string && request.resource.data.to is string
          && request.resource.data.to > request.resource.data.from
          && request.resource.data.seq is int;

        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && request.resource.data.to > request.resource.data.from
          && changedKeys().hasOnly(['name', 'from', 'to', 'itemIds', 'pred', 'permit', 'updatedAt']);

        allow delete: if isAdmin();
      }

      // PM 1.0 subcontracts (SC-01) — `pmSubcontracts/{NN}`. Registered by `sub`
      // within the riyal limit (owner unlimited · project manager 75,000 · else none —
      // mirrors pmApprovalLimit in src/lib/pm/subcontract.ts). A line's `certified`
      // moves only on a certificate's approval (`ipcOk`); `paid` is Finance's.
      match /pmSubcontracts/{contractId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'sub')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.party.name is string && request.resource.data.party.name.size() > 0
          && request.resource.data.lines is list && request.resource.data.lines.size() > 0
          && request.resource.data.value is number && request.resource.data.value > 0
          && request.resource.data.retention is number
          && request.resource.data.retention >= 0 && request.resource.data.retention <= 0.2
          && request.resource.data.get('paid', 0) == 0
          && (pmCeilingHas('admin') || (pmCeilingHas('approve') && request.resource.data.value <= 75000));

        allow update: if inOpenProject(projectId)
          && ((pmDuty(projectId, 'ipcOk')
                && changedKeys().hasOnly(['lines', 'updatedAt'])
                && request.resource.data.lines.size() == resource.data.lines.size())
              || (hasOrgPermission('invoices.manage')
                && changedKeys().hasOnly(['paid', 'updatedAt'])
                && request.resource.data.paid is number
                && request.resource.data.paid >= resource.data.get('paid', 0)));

        allow delete: if isAdmin();
      }

      // PM 1.0 subcontractor certificates (SC-02, SC-03) — `pmSubCertificates/{NN}`.
      // Prepared by `sub` (int); approved (ok) by `ipcOk`, never its preparer, within
      // the approver's riyal limit. prj:SC is written to pmEvents in the same transaction.
      match /pmSubCertificates/{certId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'sub')
          && request.resource.data.status == 'int'
          && request.resource.data.prep == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.gross is number && request.resource.data.gross > 0;

        allow update: if inOpenProject(projectId)
          && (
            (pmDuty(projectId, 'ipcOk')
              && resource.data.status == 'int' && request.resource.data.status == 'ok'
              && request.resource.data.appr == request.auth.uid
              && (pmCeilingHas('admin') || (pmCeilingHas('approve') && resource.data.gross <= 75000))
              // Two people (SC-02) — or its preparer under the company's recorded
              // self-approval, flagged `selfApp` (the setting pmCertificates reads).
              && ((resource.data.prep != request.auth.uid && request.resource.data.get('selfApp', false) == false)
                  || (resource.data.prep == request.auth.uid && request.resource.data.selfApp == true
                      && exists(/databases/$(database)/documents/pmSettings/$(projectData(projectId).organizationId))
                      && get(/databases/$(database)/documents/pmSettings/$(projectData(projectId).organizationId)).data.get('selfApproval', false) == true))
              && changedKeys().hasOnly(['status', 'appr', 'apprName', 'apprOn', 'selfApp', 'updatedAt']))
            // Withdrawn before approval — by its preparer or whoever approves certificates.
            // Terminal: without it a certificate prepared by mistake, or by the only
            // person above the limit, blocked every later one and the close-out for good.
            || (resource.data.status == 'int' && request.resource.data.status == 'void'
              && (pmDuty(projectId, 'ipcOk') || (resource.data.prep == request.auth.uid && pmDuty(projectId, 'sub')))
              && request.resource.data.voidBy == request.auth.uid
              && changedKeys().hasOnly(['status', 'voidBy', 'voidByName', 'voidOn', 'updatedAt']))
            // Finance pays an approved sub certificate — once. One whose material
            // recovery took its whole net has nothing to pay and is settled at zero.
            || (hasOrgPermission('invoices.manage')
              && resource.data.status == 'ok'
              && resource.data.get('paidOn', null) == null
              && request.resource.data.paidOn is string
              && request.resource.data.paidAmount is number && request.resource.data.paidAmount >= 0
              && request.resource.data.paidBy == request.auth.uid
              && changedKeys().hasOnly(['paidOn', 'paidAmount', 'paidBy', 'paidByName', 'updatedAt']))
          );

        allow delete: if isAdmin();
      }

      // PM 1.0 subcontractor custody (STK-03/04) — `pmSubCustody/{NN}`: material
      // issued into a sub's custody against a line of his contract. Issues, returns
      // are appended by `req` (one move per write), a count by `approve`; a recovery
      // (with its accounting return) is `approve`'s, its deduction marks `sub`'s. Never deleted.
      match /pmSubCustody/{custodyId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'req')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.moves is list && request.resource.data.moves.size() == 1
          && request.resource.data.recoveries is list && request.resource.data.recoveries.size() == 0;

        allow update: if inOpenProject(projectId)
          // A count and a new recovery are the approver's (the prototype's CAN('approve')).
          && (((pmDuty(projectId, 'req') || pmDuty(projectId, 'approve'))
                && changedKeys().hasOnly(['moves', 'updatedAt'])
                && request.resource.data.moves.size() == resource.data.moves.size() + 1
                && (request.resource.data.moves[resource.data.moves.size()].t != 'cnt' || pmDuty(projectId, 'approve')))
              || ((pmDuty(projectId, 'sub') || pmDuty(projectId, 'approve'))
                && changedKeys().hasOnly(['moves', 'recoveries', 'updatedAt'])
                && request.resource.data.moves.size() >= resource.data.moves.size()
                && request.resource.data.recoveries.size() >= resource.data.recoveries.size()
                // A certificate that can bear only part of a recovery leaves the rest as a new one.
                && (pmDuty(projectId, 'approve') || request.resource.data.recoveries.size() <= resource.data.recoveries.size() + 1)));

        allow delete: if isAdmin();
      }

      // PM 1.0 document register (DOC-01) — `pmDocs/{NN}`, kept by approve. A revision
      // is appended, never edited or removed: the list only grows, by one.
      match /pmDocs/{docId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.type in ['dwg', 'shop', 'spec', 'permit', 'cert', 'ctr']
          && request.resource.data.revisions is list && request.resource.data.revisions.size() <= 1
          && request.resource.data.seq is int;

        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && changedKeys().hasOnly(['revisions', 'updatedAt'])
          && request.resource.data.revisions.size() == resource.data.revisions.size() + 1
          && request.resource.data.revisions[request.resource.data.revisions.size() - 1].by == request.auth.uid;

        allow delete: if isAdmin();
      }

      // PM 1.0 correspondence (COR-01) — `pmLetters/{NN}`, logged by `corr`. out|in → rep
      // with the reply; nothing else on a letter ever changes (its dates are the evidence).
      match /pmLetters/{letterId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'corr')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.dir in ['out', 'in']
          && request.resource.data.status == request.resource.data.dir
          && request.resource.data.party in ['cons', 'own', 'gov', 'sub']
          && request.resource.data.subject is string && request.resource.data.subject.size() > 0
          && request.resource.data.day is string
          && request.resource.data.due is int && request.resource.data.due >= 0
          && request.resource.data.seq is int;

        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'corr')
          && resource.data.status in ['out', 'in']
          && request.resource.data.status == 'rep'
          && request.resource.data.reply.by == request.auth.uid
          && request.resource.data.reply.text is string && request.resource.data.reply.text.size() > 0
          && request.resource.data.reply.on >= resource.data.day
          && changedKeys().hasOnly(['status', 'reply', 'updatedAt']);

        allow delete: if isAdmin();
      }

      // PM 1.0 daily report (DLY-01) — `pmDaily/{YYYY-MM-DD}`: one a day, written by
      // `daily`, never rewritten (the site record a dispute falls back on).
      match /pmDaily/{day} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'daily')
          && request.resource.data.day == day
          && request.resource.data.by == request.auth.uid
          && request.resource.data.done is string && request.resource.data.done.size() > 0
          && request.resource.data.labour is int && request.resource.data.labour >= 0
          && request.resource.data.plant is int && request.resource.data.plant >= 0;

        allow update: if false;
        allow delete: if isAdmin();
      }

      // PM 1.0 obstacles and RFIs (OBS-01) — `pmObstacles/{rfi|obs}-{NN}`. Raised,
      // chased and closed by `daily` or `approve`; closed, never deleted. A chase
      // only appends one signed entry; closing sets the day, the answer and who.
      match /pmObstacles/{obstacleId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && (pmDuty(projectId, 'daily') || pmDuty(projectId, 'approve'))
          && request.resource.data.type in ['rfi', 'obs']
          && request.resource.data.party in ['consultant', 'client', 'authority', 'other', 'none']
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.impact is string && request.resource.data.impact.size() > 0
          && request.resource.data.itemIds is list
          && request.resource.data.closeOn == null
          && request.resource.data.chases.size() == 0;

        allow update: if inOpenProject(projectId)
          && resource.data.closeOn == null
          && ((changedKeys().hasOnly(['chases', 'updatedAt'])
                && (pmLiveSeat(projectId) || pmCeilingHas('all'))
                && request.resource.data.chases.size() == resource.data.get('chases', []).size() + 1
                && request.resource.data.chases[request.resource.data.chases.size() - 1].by == request.auth.uid)
              || ((pmDuty(projectId, 'daily') || pmDuty(projectId, 'approve'))
                && changedKeys().hasOnly(['closeOn', 'answer', 'closedBy', 'closedByName', 'updatedAt'])
                && request.resource.data.closeOn is string
                && request.resource.data.closeOn >= resource.data.openOn
                && request.resource.data.closedBy == request.auth.uid));

        allow delete: if isAdmin();
      }

      // PM 1.0 safety (HSE-01) — incidents `pmIncidents/{NN}` and work permits
      // `pmPermits/{NN}`, by `hse`. The incident log is never edited or erased.
      match /pmIncidents/{incidentId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'hse')
          && request.resource.data.type in ['near', 'fa', 'lti', 'prop']
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.what is string && request.resource.data.what.size() > 0
          && request.resource.data.action is string && request.resource.data.action.size() > 0
          && request.resource.data.lostDays is int && request.resource.data.lostDays >= 0
          && (request.resource.data.type == 'lti' || request.resource.data.lostDays == 0);

        allow update: if false;
        allow delete: if isAdmin();
      }

      match /pmPermits/{permitId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'hse')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.title is string && request.resource.data.title.size() > 0
          && request.resource.data.who is string && request.resource.data.who.size() > 0
          && request.resource.data.from is string && request.resource.data.to is string
          && request.resource.data.to >= request.resource.data.from;

        allow update: if false;
        allow delete: if isAdmin();
      }

      // PM 1.0 project store (E-30) — `pmStore/{storeId}`: one ledger line per
      // material, id derived from the material key. `rates` per BOQ item, `moves`
      // appended (rc from the project receipt; use/ret/xo/loss/rx/sret logged by
      // `req`; approval by `approve`; xi appended on the RECEIVING project by the
      // sender and confirmed by its `req`). Never deleted.
      match /pmStore/{storeId} {
        allow read: if inProject(projectId);

        allow create, update: if inOpenProject(projectId)
          && request.resource.data.moves is list
          && request.resource.data.rates is map
          && (resource == null || request.resource.data.moves.size() >= resource.data.moves.size())
          && (pmDuty(projectId, 'req') || pmDuty(projectId, 'rcv') || pmDuty(projectId, 'approve')
              || (pmDuty(projectId, 'measure') && pmCeilingHas('money'))
              // a move to this project from another of the org's projects: only one
              // `xi` appended, nothing else touched.
              || (request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['key', 'name', 'unit', 'rates', 'moves', 'organizationId', 'updatedAt'])
                  && request.resource.data.moves.size() == (resource == null ? 0 : resource.data.moves.size()) + 1
                  && request.resource.data.moves[request.resource.data.moves.size() - 1].t == 'xi'
                  && request.resource.data.moves[request.resource.data.moves.size() - 1].st == 'wait')
              // E-25: the QS records a recovery and the sub certificate marks it deducted.
              || (pmDuty(projectId, 'sub')
                  && resource != null
                  && changedKeys().hasOnly(['recoveries', 'moves', 'updatedAt'])
                  && request.resource.data.moves.size() >= resource.data.moves.size()
                  && request.resource.data.recoveries is list)
              // Inventory confirms a return is back in its main store — one move wait → done.
              || ((hasOrgPermission('warehouses.manage') || hasOrgPermission('warehouses.receive'))
                  && resource != null
                  && changedKeys().hasOnly(['moves', 'updatedAt'])
                  && request.resource.data.moves.size() == resource.data.moves.size()));

        allow delete: if false;
      }

      // PM 1.0 direct purchases (E-35) — `pmPetty/{NN}`: under the per-purchase cap
      // (3,000 — PETTY_CAP.one in src/lib/pm/supply.ts), by `req`; create-only.
      match /pmPetty/{pettyId} {
        allow read: if inProject(projectId);
        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'req')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.amount is number
          && request.resource.data.amount > 0 && request.resource.data.amount <= 3000
          && request.resource.data.what is string && request.resource.data.what.size() > 0
          && request.resource.data.supplier is string && request.resource.data.supplier.size() > 0;
        allow update, delete: if false;
      }

      // PM 1.0 equipment requests (E-29) — `pmPlantRequests/{NN}`: by `req`; born
      // `wait`, or `go` when the requester holds `approve`; decided by `approve`.
      match /pmPlantRequests/{plantId} {
        allow read: if inProject(projectId);
        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'req')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && (request.resource.data.status == 'wait'
              || (request.resource.data.status == 'go' && pmDuty(projectId, 'approve')));
        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && resource.data.status == 'wait'
          && request.resource.data.status in ['go', 'rej']
          && changedKeys().hasOnly(['status', 'decidedBy', 'decidedByName', 'decidedOn', 'updatedAt']);
        // The site records the plant desk's reply (there is no desk module yet): once,
        // on an approved request.
        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'req')
          && resource.data.status == 'go'
          && resource.data.get('rep', null) == null
          && request.resource.data.rep.k in ['alloc', 'late', 'alt', 'none']
          && request.resource.data.rep.by == request.auth.uid
          && changedKeys().hasOnly(['rep', 'updatedAt']);
        // «استأجر بدلها»: busy or none → a timed hire, by the approver (with prj:EQH).
        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && resource.data.status == 'go'
          && resource.data.get('got', null) == null
          && resource.data.get('rep', {}).get('k', '') in ['late', 'none']
          && request.resource.data.rep.k == 'hire'
          && changedKeys().hasOnly(['rep', 'updatedAt']);
        // Received on site (the same write creates the pmPlant unit): once, when
        // allocated, an alternative, or hired.
        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'req')
          && resource.data.status == 'go'
          && resource.data.get('got', null) == null
          && resource.data.get('rep', {}).get('k', '') in ['alloc', 'alt', 'hire']
          && request.resource.data.got.by == request.auth.uid
          && request.resource.data.got.plantSeq is int
          && changedKeys().hasOnly(['got', 'updatedAt']);
        allow delete: if false;
      }

      // PM 1.0 inspection & test plan — `pmItp/{NN}` (`pm.itpCount`), written by
      // quality. "Done" is counted from the inspections, never stored. Never
      // edited or deleted: the plan is what the consultant was promised.
      match /pmItp/{rowId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'qa')
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.need is int && request.resource.data.need >= 1
          && request.resource.data.test is string && request.resource.data.test.size() > 0;

        allow update: if false;
        allow delete: if isAdmin();
      }

      // PM 1.0 weekly plan (WWP-03…05) — `pmWeeks/{weekStart}`: one plan a week,
      // committed and closed by measure | approve (`weeklyPlan.manage`). Closing
      // is the only update: open → done, every task with done or a reason.
      match /pmWeeks/{week} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && (pmDuty(projectId, 'measure') || pmDuty(projectId, 'approve'))
          && request.resource.data.week == week
          && request.resource.data.status == 'open'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.tasks is list && request.resource.data.tasks.size() > 0;

        allow update: if inOpenProject(projectId)
          && (pmDuty(projectId, 'measure') || pmDuty(projectId, 'approve'))
          && resource.data.status == 'open'
          && request.resource.data.status == 'done'
          && request.resource.data.closedBy == request.auth.uid
          && request.resource.data.tasks.size() == resource.data.tasks.size()
          && changedKeys().hasOnly(['status', 'tasks', 'closedOn', 'closedBy', 'closedByName', 'updatedAt']);

        allow delete: if isAdmin();
      }

      // PM 1.0 plant on site (EQP-08…15, WF-14) — `pmPlant/{NN}` (`pm.plantCount`).
      // Received, off-hired and handed back by `req`; the day log is `daily`
      // (one key per day, never after the unit went back). use → req → back;
      // the desk's confirmation (offNo/offOk) is recorded once, while `req`.
      match /pmPlant/{plantId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'req')
          && request.resource.data.status == 'use'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.qty is int && request.resource.data.qty >= 1
          && request.resource.data.name is string && request.resource.data.name.size() > 0;

        allow update: if inOpenProject(projectId)
          && resource.data.status != 'back'
          && ((pmDuty(projectId, 'daily')
                && changedKeys().hasOnly(['days', 'hours', 'updatedAt']))
              || (pmDuty(projectId, 'daily') && resource.data.status == 'use' && request.resource.data.status == 'req'
                && request.resource.data.offReq.by == request.auth.uid
                && changedKeys().hasOnly(['status', 'offReq', 'updatedAt']))
              || (pmDuty(projectId, 'req') && resource.data.status == 'req' && resource.data.get('offOk', null) == null
                && request.resource.data.offOk.by == request.auth.uid
                && changedKeys().hasOnly(['offNo', 'offOk', 'updatedAt']))
              || (pmDuty(projectId, 'daily') && resource.data.status == 'req' && resource.data.get('offOk', null) != null
                && request.resource.data.status == 'back'
                && request.resource.data.back.by == request.auth.uid
                && changedKeys().hasOnly(['status', 'back', 'updatedAt']))
              // The day rate, set after the handover by someone who sees money and runs
              // the plant or approves here — never on a tool; who and when ride with it.
              // (Received by a site engineer, who sees no amounts, a unit had no rate
              // and no way to get one: its logged days cost the project nothing.)
              || (pmCeilingHas('money') && (pmDuty(projectId, 'req') || pmDuty(projectId, 'approve'))
                && resource.data.get('category', '') != 'tool'
                && request.resource.data.dayRate is number && request.resource.data.dayRate > 0
                && request.resource.data.rateSet.by == request.auth.uid
                && changedKeys().hasOnly(['dayRate', 'rateSet', 'updatedAt'])));

        allow delete: if isAdmin();
      }

      match /pmNcrs/{ncrId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'qa')
          && request.resource.data.status == 'open'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.root is string && request.resource.data.root.size() > 0
          && request.resource.data.seq is int;

        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'qa')
          && ((resource.data.status == 'open' && request.resource.data.status == 'plan'
                && changedKeys().hasOnly(['status', 'plan', 'updatedAt']))
              || (resource.data.status == 'plan' && request.resource.data.status == 'done'
                && changedKeys().hasOnly(['status', 'accepted', 'updatedAt'])));

        allow delete: if isAdmin();
      }

      match /pmPunch/{punchId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'qa')
          && request.resource.data.status == 'open'
          && request.resource.data.by == request.auth.uid
          && request.resource.data.location is string && request.resource.data.location.size() > 0
          && request.resource.data.seq is int;

        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'qa')
          && ((resource.data.status == 'open' && request.resource.data.status == 'fix'
                && changedKeys().hasOnly(['status', 'fix', 'updatedAt']))
              || (resource.data.status == 'fix' && request.resource.data.status == 'done'
                && changedKeys().hasOnly(['status', 'conf', 'updatedAt'])));

        allow delete: if isAdmin();
      }

      // PM 1.0 delivery units — `pmUnits/{NN}`, created together by approve; the
      // planned day, the handover (never undone) and the measured share move by approve.
      match /pmUnits/{unitId} {
        allow read: if inProject(projectId);
        allow create: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && request.resource.data.seq is int
          && request.resource.data.ho == null;
        allow update: if inOpenProject(projectId)
          && pmDuty(projectId, 'approve')
          && resource.data.get('ho', null) == null
          && changedKeys().hasOnly(['plan', 'ho', 'lines', 'updatedAt']);
        allow delete: if isAdmin();
      }

      // BOQ groups (sections) — plain org-scoped CRUD, same org as the project.
      // Groups themselves are never hard-locked; a locked item's groupId is already
      // frozen by the boqItems update rule above (groupId isn't in the unlock allowlist).
      match /boqGroups/{groupId} {
        allow read: if inProject(projectId);

        allow create, update, delete: if inOpenProject(projectId)
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish')
              || isPmProjectManager(projectId)
              // …as the BOQ lines themselves: the wizard writes both in one batch.
              || (pmCeilingHas('create') && ('pm' in projectData(projectId))));
      }

      // Site measurement ledger (حصر الكميات المنفذة) — one entry per quantity
      // recorded against a BOQ line. Append-only: corrections are negative
      // entries; the only mutation is a claim stamping claimId onto entries it
      // consumed (once — a claimed entry is never re-claimed or un-claimed).
      match /measurements/{measurementId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'))
          && request.resource.data.recordedByUserId == request.auth.uid
          && request.resource.data.get('claimId', null) == null;

        allow update: if inOpenProject(projectId)
          && hasProjectPermission(projectId, 'invoices.manage')
          && resource.data.get('claimId', null) == null
          && changedKeys().hasOnly(['claimId'])
          && request.resource.data.claimId is string;

        allow delete: if isAdmin();
      }

      // IPC/claims (مستخلصات) — generated from unclaimed measurements (lines,
      // retention/advance/VAT totals) or entered manually; submit, then flip
      // to collected. Content is immutable once submitted.
      match /ipcClaims/{claimId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && request.resource.data.submittedByUserId == request.auth.uid
          && request.resource.data.status == 'submitted'
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'invoices.manage'));

        allow update: if inOpenProject(projectId)
          && hasProjectPermission(projectId, 'invoices.manage')
          && resource.data.status == 'submitted'
          && changedKeys().hasOnly(['status', 'collectedAt', 'updatedAt'])
          && request.resource.data.status == 'collected';

        allow delete: if isAdmin();
      }

      // Waste records (نسبة الهدر) — one per material row consumed from the linked
      // warehouse, capturing quantity taken vs. quantity actually used. Append-only,
      // same permission as boqItems since it's written in the same transaction.
      match /wasteRecords/{recordId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'))
          && request.resource.data.recordedByUserId == request.auth.uid;

        allow update, delete: if isAdmin();
      }

      // Append-only finance audit trail (who submitted/collected an IPC claim, and when).
      // No update/delete for non-admins — it's a log, not an editable record.
      match /financeAuditLog/{entryId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && request.resource.data.actorId == request.auth.uid;

        allow update, delete: if isAdmin();
      }

      // Internal purchase requests (طلبات شراء داخلية) — any org member can raise
      // one from inside the project; only the warehouse decision-maker
      // (warehouses.manage) can approve/reject it. Bare-bones: no edit flow,
      // only the pending -> approved|rejected transition is allowed post-create.
      match /purchaseRequests/{requestId} {
        allow read: if inProject(projectId);

        allow create: if inOpenProject(projectId)
          && request.resource.data.requestedByUserId == request.auth.uid
          && request.resource.data.status == 'pending';

        allow update: if inOpenProject(projectId)
          && hasProjectPermission(projectId, 'warehouses.manage')
          && resource.data.status == 'pending'
          // A PM 1.0 request is approved technically by the project manager, never from here (REQ-02).
          && resource.data.get('pm', false) != true
          && changedKeys().hasOnly(['status', 'decidedByUserId', 'decidedByUserName', 'decidedAt', 'updatedAt'])
          && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected');

        // Procurement routes the need to Manufacturing (D4) — only the link to
        // the manufacturing request is written, at any status.
        allow update: if inOpenProject(projectId)
          && (hasOrgPermission('rfq.manage') || hasOrgPermission('warehouses.manage'))
          && changedKeys().hasOnly(['mfgRequestId', 'mfgRoutedAt', 'mfgRoutedByName', 'updatedAt']);
        // Procurement answers an approved request with an RFQ or an order placed
        // without one (PRD 3.0 §7.2) — once: the link is never rewritten.
        allow update: if inOpenProject(projectId)
          && (isOrgOwner() || hasOrgPermission('rfq.manage') || hasOrgPermission('rfq.create') || hasOrgPermission('offers.accept'))
          && (resource.data.status == 'approved'
              || (resource.data.status == 'pending'
                  && resource.data.get('pm', false) != true
                  && resource.data.get('procDecision', {}).get('kind', '') in ['proceed_short', 'proceed_full']))
          && resource.data.get('rfqId', null) == null
          && resource.data.get('poId', null) == null
          && changedKeys().hasOnly(['rfqId', 'rfqNumber', 'poId', 'poNumber', 'orderedAt', 'orderedByName', 'updatedAt']);
        // The award: the RFQ that answers this request became an order. Whoever awards
        // records it on the request — once, in the award's own transaction, and only an
        // order that names that RFQ. A split award also records, under `lineLinks`, the
        // lines another supplier's order carries. (Without it the project never learns
        // an order is out, and the material can never be received.)
        allow update: if isSignedIn()
          && changedKeys().hasOnly(['poId', 'poNumber', 'lineLinks', 'updatedAt'])
          && inProjectOrg(projectId)
          && projectOpen(projectId)
          && (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
          && resource.data.get('rfqId', null) is string
          && resource.data.get('poId', null) == null
          && request.resource.data.get('poId', null) is string
          && request.resource.data.get('poNumber', null) is string
          && getAfter(/databases/$(database)/documents/purchaseOrders/$(request.resource.data.poId)).data.get('rfqId', '') == resource.data.rfqId;
        // A line sourced apart from its request — a change decided after the request
        // already had an RFQ or an order — carries its own RFQ and order under
        // `lineLinks.<index in lines>`. One line's entry at a time; the request's own
        // links never move here.
        allow update: if isSignedIn()
          && changedKeys().hasOnly(['lineLinks', 'updatedAt'])
          && inProjectOrg(projectId)
          && projectOpen(projectId)
          && (isOrgOwner() || hasOrgPermission('rfq.manage') || hasOrgPermission('rfq.create') || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
          && resource.data.get('pm', false) == true
          && resource.data.status == 'approved'
          && request.resource.data.get('lineLinks', {}) is map
          && request.resource.data.get('lineLinks', {}).diff(resource.data.get('lineLinks', {})).affectedKeys().size() <= 1;
        // A draft RFQ is deleted: the request it held goes back to the desk (R-19).
        // Only while that RFQ still exists as a Draft — the client unlinks BEFORE deleting it.
        allow update: if inOpenProject(projectId)
          && (isOrgOwner() || hasOrgPermission('rfq.manage') || hasOrgPermission('rfq.create') || hasOrgPermission('offers.accept'))
          && resource.data.get('rfqId', null) is string
          && resource.data.get('poId', null) == null
          && exists(/databases/$(database)/documents/rfqs/$(resource.data.rfqId))
          && get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.status == 'Draft'
          && request.resource.data.get('rfqId', null) == null
          && changedKeys().hasOnly(['rfqId', 'rfqNumber', 'orderedAt', 'orderedByName', 'updatedAt']);

        // Procurement decides without the other module's answer, once (P-33/P-34):
        // after Inventory's one-day window, or buying instead of asking our workshop.
        allow update: if inOpenProject(projectId)
          && (isOrgOwner() || hasOrgPermission('offers.accept'))
          && resource.data.get('procDecision', null) == null
          && resource.data.get('rfqId', null) == null
          && resource.data.get('poId', null) == null
          && changedKeys().hasOnly(['procDecision', 'updatedAt'])
          && request.resource.data.procDecision.byName is string
          && (
            (request.resource.data.procDecision.kind == 'buy'
              && resource.data.status == 'approved'
              && resource.data.get('mfgRequestId', null) == null)
            || (request.resource.data.procDecision.kind in ['proceed_short', 'proceed_full']
              && resource.data.status == 'pending'
              // Nothing of a PM request is bought before the manager's technical approval (REQ-02).
              && resource.data.get('pm', false) != true
              && resource.data.createdAt is timestamp
              && request.time > resource.data.createdAt + duration.value(procReplyWindowDays(), 'd'))
          );

        // Inventory replies on a PM request line (issue from stock / partial / buy).
        allow update: if inOpenProject(projectId)
          && (isOrgOwner() || hasOrgPermission('warehouses.manage') || hasOrgPermission('warehouses.receive'))
          && resource.data.get('pm', false) == true
          && resource.data.status == 'approved'
          && resource.data.get('poId', null) == null
          && changedKeys().hasOnly(['lines', 'updatedAt'])
          && request.resource.data.lines is list
          && request.resource.data.lines.size() == resource.data.lines.size();

        allow delete: if isAdmin();

        // PM 1.0: the site asks (`req`), born pending, in the requester's name.
        allow create: if inProject(projectId)
          && ('pm' in projectData(projectId))
          && pmDuty(projectId, 'req')
          && request.resource.data.pm == true
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedByUserId == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.lines is list && request.resource.data.lines.size() > 0
          && request.resource.data.get('rfqId', null) == null
          && request.resource.data.get('poId', null) == null;

        // PM 1.0: technical approval / rejection by the project manager (`approve`).
        allow update: if inProject(projectId)
          && ('pm' in projectData(projectId))
          && pmDuty(projectId, 'approve')
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && changedKeys().hasOnly(['pm', 'lines', 'items', 'status', 'rejectReason', 'approvedOn', 'approvedBy', 'approvedByName', 'decidedByUserId', 'decidedByUserName', 'decidedAt', 'updatedAt']);

        // PM 1.0: the requester withdraws it before approval.
        allow update: if inOpenProject(projectId)
          && resource.data.get('pm', false) == true
          && resource.data.status == 'pending'
          && resource.data.requestedByUserId == request.auth.uid
          && request.resource.data.status == 'rejected'
          && request.resource.data.withdrawn == true
          && changedKeys().hasOnly(['status', 'withdrawn', 'decidedByUserId', 'decidedByUserName', 'decidedAt', 'updatedAt']);

        // PM 1.0: lines move after (or, for a change decision, before) approval — a
        // change decided (`approve`), a line stopped (`approve` or the requester, with
        // `req`), a project receipt (`rcv`). Status, requester and Procurement's links
        // never change here. (Per-line checks run in the write; rules cannot diff lists.)
        allow update: if inProject(projectId)
          && ('pm' in projectData(projectId))
          && resource.data.status in ['pending', 'approved']
          && (pmDuty(projectId, 'approve') || pmDuty(projectId, 'rcv')
              || (pmDuty(projectId, 'req') && resource.data.requestedByUserId == request.auth.uid))
          && request.resource.data.status == resource.data.status
          && request.resource.data.lines.size() == resource.data.get('lines', request.resource.data.lines).size()
          && changedKeys().hasOnly(['pm', 'lines', 'items', 'updatedAt']);

        // PM 1.0: the consultant approved a sample — whoever records the reply
        // (`measure` or `approve`) lifts the "sample pending" mark off `items`, in the
        // reply's own transaction. Nothing else moves, and no entry is added or dropped.
        allow update: if isSignedIn()
          && changedKeys().hasOnly(['items', 'updatedAt'])
          && inProjectOrg(projectId)
          && ('pm' in projectData(projectId))
          && resource.data.status in ['pending', 'approved']
          && (pmDuty(projectId, 'measure') || pmDuty(projectId, 'approve'))
          && request.resource.data.items is list
          && request.resource.data.items.size() == resource.data.get('items', []).size();
      }
    }

    // Procurement materials catalog — admin manages, contractors read
    match /procurementMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Contractor recurring-items catalog — org-scoped read (same pattern as rfqs/deliveries)
    match /contractorCatalog/{itemId} {
      allow read: if isSignedIn();
      allow create: if isContractor()
        && request.resource.data.organizationId == getOrganizationId()
        && request.resource.data.contractorId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.organizationId == getOrganizationId();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId());
    }

    // Delivery receipts — both contractor and supplier involved can read/write
    match /deliveries/{deliveryId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.confirmedByUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier creates delivery notice for their own accepted offer
      allow create: if (isSupplier()
        && request.resource.data.supplierOrgId == getOrganizationId())
        // Contractor manually logs a receipt for materials received outside the platform —
        // must already be self-confirmed (no supplier notice/confirmation step to go through)
        // and must not reference a real supplier account, to prevent impersonating one.
        || (isContractor()
          && request.resource.data.contractorOrgId == getOrganizationId()
          && request.resource.data.contractorId == request.auth.uid
          && request.resource.data.status == "confirmed"
          && request.resource.data.confirmedByUserId == request.auth.uid
          // A manual receipt is Procurement's (S-13): whoever prepares orders, or the owner.
          && (hasOrgPermission('deliveries.confirm')
              || (procBuyerReceives() && hasOrgPermission('offers.accept')
                  && request.resource.data.get('selfReceived', false) == true)
              || (request.resource.data.get('source', '') == 'manual'
                  && (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))))
          && !('supplierOrgId' in request.resource.data)
          && !('supplierId' in request.resource.data)
          && !('offerId' in request.resource.data)
          && !('rfqId' in request.resource.data));
      // Contractor confirms receipt; supplier can update their own notice before confirmation.
      // A manual (contractor-logged) delivery is created without supplierOrgId/supplierId/
      // offerId/rfqId to prevent impersonating a real supplier — lock that guarantee on
      // update too, so those fields can never be added retroactively once absent.
      // Procurement PRD 3.0 lays optional purchase-order fields over a delivery
      // (`poId`, `poNumber`, `docNumber`, `lines[]`, `vehiclePlate`, `paperNoteNumber`,
      // `deliveryWindow`, `checklist`, `receiverUserId`, `landedWarehouseId`,
      // `postedNet`, `selfReceived`): there is no field allow-list here, so they need
      // no entry — and a manual receipt regularised by a retroactive order gains a
      // `poId`, never the four identity fields above.
      allow update: if isSignedIn() && (
        (resource.data.contractorOrgId == getOrganizationId() && hasOrgPermission('deliveries.confirm')) ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      ) && (
        isAdmin() || !('supplierOrgId' in request.resource.data) || 'supplierOrgId' in resource.data
      ) && (
        isAdmin() || !('supplierId' in request.resource.data) || 'supplierId' in resource.data
      ) && (
        isAdmin() || !('offerId' in request.resource.data) || 'offerId' in resource.data
      ) && (
        isAdmin() || !('rfqId' in request.resource.data) || 'rfqId' in resource.data
      );
      // Whoever prepares orders regularises a no-PO manual receipt: ties it to an
      // order or marks it a cash expense — only while it has no order and was never
      // regularised, never touching the identity fields (S-26).
      allow update: if isSignedIn()
        && resource.data.contractorOrgId == getOrganizationId()
        && (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && resource.data.get('source', '') == 'manual'
        && resource.data.get('poId', null) == null
        && resource.data.get('offerId', null) == null
        && resource.data.get('regularisation', null) == null
        && changedKeys().hasOnly([
             'poId', 'poNumber', 'lines', 'postedNet', 'regularisation',
             'regularisedAt', 'regularisedById', 'regularisedByName', 'updatedAt'])
        && (request.resource.data.get('regularisation', null) in [null, 'expense']);
      // Under `buyerReceives` the buyer confirms a pending notice (flagged); a receipt
      // recorded without the notice trims / closes that order's pending notice.
      allow update: if isSignedIn()
        && resource.data.contractorOrgId == getOrganizationId()
        && hasOrgPermission('offers.accept')
        && procBuyerReceives()
        && resource.data.status == 'pending_confirmation'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.get('selfReceived', false) == true
        && request.resource.data.confirmedByUserId == request.auth.uid
        && !changedKeys().hasAny(['supplierOrgId', 'supplierId', 'offerId', 'rfqId', 'contractorOrgId']);

      allow update: if isSignedIn()
        && resource.data.contractorOrgId == getOrganizationId()
        && (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && resource.data.status == 'pending_confirmation'
        && request.resource.data.status == 'pending_confirmation'
        && resource.data.get('closedByReceipt', null) == null
        && changedKeys().hasOnly(['lines', 'closedByReceipt', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Guarantee certificates submitted by suppliers for contractor-flagged BOQ items on their
    // own accepted offers. Managed as a standalone flow (its own pages on both sides) — never
    // gates offer/RFQ/delivery-notice writes.
    match /guarantees/{guaranteeId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier submits the guarantee answer for their own accepted offer, from the standalone
      // supplier Guarantees page — independent of sending the delivery notice.
      allow create: if isSupplier()
        && request.resource.data.supplierOrgId == getOrganizationId()
        && (request.resource.data.status == 'pending_review' || request.resource.data.status == 'none');
      allow update: if isSignedIn() && (
        // Contractor accepts/rejects a submitted guarantee; only the review fields may change.
        (resource.data.contractorOrgId == getOrganizationId()
          && hasOrgPermission('deliveries.confirm')
          && changedKeys().hasOnly(['status', 'reviewedAt', 'reviewedByUserId'])
          && (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected'))
        // Owning supplier edits/resubmits their own answer before or after rejection, but never
        // once the contractor has accepted it.
        || (isSupplier()
          && resource.data.supplierOrgId == getOrganizationId()
          && resource.data.status != 'accepted'
          && changedKeys()
            .hasOnly(['hasGuarantee', 'fileUrl', 'filePath', 'fileType', 'expirationDate', 'status'])
          && (request.resource.data.status == 'pending_review' || request.resource.data.status == 'none'))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Purchase orders (Procurement PRD 3.0) — the document laid over an award ──
    //
    // An accepted offer stays the award; the order carries the number, the
    // approval, the dispatch, the supplier's promise, the lines' counters and
    // the close-out. Seven stored states move one step at a time, each step
    // its own permission and its own field list. Delivery progress, lateness,
    // blocks and the approver are DERIVED (src/lib/procurement/po.ts) — never
    // stored, so never written. The hard blocks of §6.1 that are data
    // conditions live here: nobody approves an order they prepared (the org
    // owner excepted — a company of one cannot wait for a second person),
    // nobody approves above the routing the preparer's write recorded
    // (`approverKind`), a retroactive order is the owner's alone, and no
    // dispatch before approval.
    function poFrom() { return resource.data.get('status', ''); }
    function poTo() { return request.resource.data.get('status', ''); }
    function poChanged() { return changedKeys(); }
    // The org's operating policies (procurementSettings/{orgId}, §6.4); absent = PRD reference.
    function procSettingsPath() {
      return /databases/$(database)/documents/procurementSettings/$(getOrganizationId());
    }
    // A firm with no separate receiver: whoever prepares orders records the receipt, flagged.
    function procBuyerReceives() {
      return exists(procSettingsPath()) && get(procSettingsPath()).data.get('buyerReceives', false) == true;
    }
    // Inventory's / the workshop's reply window, in whole days (reference 1).
    function procReplyWindowDays() {
      return exists(procSettingsPath()) ? int(get(procSettingsPath()).data.get('replyWindowDays', 1)) : 1;
    }
    // A buyer (prepares, does not approve, not the owner) acts on the orders HE prepared (R-26).
    // The owner's read-only stance is enforced in the writes only: the send that rides an
    // approval (sendOnApproval) is written in the approver's — possibly the owner's — name.
    function poMineOrNotBuyer() {
      return isOrgOwner() || hasOrgPermission('po.approve') || !hasOrgPermission('offers.accept')
        || resource.data.get('preparedById', '') == request.auth.uid;
    }
    // Projects' budget decision is asked for and not yet given (R-25) — no approval, no self-issue.
    function poPmBudgetClear() {
      return resource.data.get('pmBudget', null) == null
        || !(resource.data.pmBudget.get('state', '') in ['pending', 'renegotiate']);
    }
    // What no update may rewrite: where it came from, who prepared it, what it is worth.
    function poIdentityUntouched() {
      return !poChanged().hasAny(['organizationId', 'docNumber', 'preparedById', 'preparedByName', 'offerId', 'rfqId',
                                  'basis', 'totalExVat', 'vatRate', 'supplierOrgId', 'supplierUserId', 'isGuestSupplier',
                                  'createdAt', 'approverKind', 'purchaseSource', 'agreementId', 'agreementNo']);
    }
    // Chasing the supplier: expediters, and anyone who may prepare or approve.
    function poExpediter() {
      return isOrgOwner() || hasOrgPermission('po.expedite') || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve');
    }
    // Procurement's own decisions on the order: the rest will not arrive, the
    // reject decision, closing, cancelling.
    function poDecider() {
      return isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve');
    }
    // A retroactive order (goods already here) is approved straight into
    // `accepted` — there is nothing to send and nobody to wait for.
    // The manager's approval limit, read from the org's policies (reference 150,000).
    function poManagerLimit() {
      let path = /databases/$(database)/documents/procurementSettings/$(resource.data.organizationId);
      return exists(path) ? get(path).data.get('managerApprovalLimit', 150000) : 150000;
    }
    function poApproves() {
      return poFrom() == 'awaiting_approval'
        && (poTo() == 'approved'
            || (poTo() == 'accepted' && resource.data.get('basis', '') == 'retroactive'
                && request.resource.data.get('acceptanceRecordedBy', '') == 'buyer'))
        && (isOrgOwner() || hasOrgPermission('po.approve'))
        && request.resource.data.get('approvedById', '') == request.auth.uid
        && (isOrgOwner() || resource.data.get('preparedById', '') != request.auth.uid)
        && (isOrgOwner() || resource.data.get('approverKind', 'owner') == 'manager')
        && (isOrgOwner() || resource.data.get('totalExVat', 0) <= poManagerLimit())
        && (isOrgOwner() || resource.data.get('basis', '') != 'retroactive')
        && poPmBudgetClear()
        && poChanged().hasOnly(['status', 'approvedById', 'approvedByName', 'approvedAt', 'returnedReason',
                                'supplierAcceptedAt', 'acceptanceRecordedBy', 'noticeCopyTo', 'log', 'updatedAt']);
    }
    // Returned = still awaiting approval, with the approver's reason on it.
    function poReturns() {
      return poFrom() == 'awaiting_approval' && poTo() == 'awaiting_approval'
        && (isOrgOwner() || hasOrgPermission('po.approve'))
        && request.resource.data.get('returnedReason', '') is string
        && request.resource.data.get('returnedReason', '').size() > 0
        && poChanged().hasOnly(['returnedReason', 'log', 'updatedAt']);
    }
    function poResubmits() {
      return poFrom() == 'awaiting_approval' && poTo() == 'awaiting_approval'
        && (isOrgOwner() || hasOrgPermission('offers.accept'))
        && request.resource.data.get('returnedReason', null) == null
        && poChanged().hasOnly(['returnedReason', 'log', 'updatedAt']);
    }
    // Send (approved → sent), record the supplier's acceptance and date
    // (sent → accepted), a new date or a reminder (same state).
    function poExpedites() {
      return poExpediter()
        && ((poFrom() == 'approved' && poTo() == 'sent'
             && request.resource.data.get('sentById', '') == request.auth.uid)
            || (poFrom() == 'sent' && poTo() in ['sent', 'accepted'])
            || (poFrom() == 'accepted' && poTo() == 'accepted'))
        && poMineOrNotBuyer()
        && poChanged().hasOnly(['status', 'sentAt', 'sentById', 'sentByName', 'sentChannel', 'supplierAcceptedAt',
                                'promisedDate', 'acceptanceRecordedBy', 'log', 'updatedAt']);
    }
    // The lines' decisions (cancel the remainder, decide the rejects) and the
    // close-out; cancelling the whole order before anything arrived.
    function poDecides() {
      return poDecider()
        && ((poFrom() == 'accepted' && poTo() in ['accepted', 'closed'])
            || (poFrom() in ['awaiting_approval', 'approved', 'sent', 'accepted'] && poTo() == 'cancelled'))
        && poMineOrNotBuyer()
        && poChanged().hasOnly(['status', 'lines', 'closedAt', 'closedShort', 'closeReason', 'cancelledReason', 'cancelFees', 'log', 'updatedAt']);
    }
    // The gate: whoever confirms deliveries moves the counters (and releases
    // held goods). An arrival on an order the supplier never acknowledged
    // records his acceptance for him.
    function poReceives() {
      return (hasOrgPermission('deliveries.confirm') || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && poFrom() in ['sent', 'accepted'] && poTo() == 'accepted'
        && poChanged().hasOnly(['status', 'lines', 'supplierAcceptedAt', 'acceptanceRecordedBy', 'log', 'updatedAt']);
    }
    // Rating once, by whoever may prepare, when the story is whole.
    // R-32: a buyer issues his OWN order at or under the org's self-issue limit
    // (procurementSettings.buyerSelfIssueLimit, default 2,000 SAR ex VAT).
    function poSelfIssueLimit() {
      let path = /databases/$(database)/documents/procurementSettings/$(resource.data.organizationId);
      return exists(path) ? get(path).data.get('buyerSelfIssueLimit', 2000) : 2000;
    }
    function poSelfIssues() {
      return poFrom() == 'awaiting_approval' && poTo() == 'approved'
        && hasOrgPermission('offers.accept')
        && resource.data.get('preparedById', '') == request.auth.uid
        && request.resource.data.get('approvedById', '') == request.auth.uid
        && request.resource.data.get('selfIssued', false) == true
        && resource.data.get('basis', '') == 'direct'
        && poPmBudgetClear()
        && resource.data.get('returnedReason', null) == null
        && resource.data.get('totalExVat', 0) <= poSelfIssueLimit()
        && poChanged().hasOnly(['status', 'approvedById', 'approvedByName', 'approvedAt', 'selfIssued', 'log', 'updatedAt']);
    }
    // R-21: Procurement's decision on a payment Finance held (same state; the
    // holds array only — the decision fields on one entry).
    function poDecidesHold() {
      return poDecider()
        && poTo() == poFrom()
        && poMineOrNotBuyer()
        && poChanged().hasOnly(['financeHolds', 'log', 'updatedAt']);
    }
    // R-21 / R-24: Finance writes back what it paid (the advance included) and
    // what it held — on an approved order, never changing its state.
    function poFinance() {
      return (isOrgOwner() || hasOrgPermission('invoices.manage') || hasOrgPermission('accounting.post'))
        && poTo() == poFrom()
        && poFrom() in ['approved', 'sent', 'accepted', 'closed']
        && poChanged().hasOnly(['financePayments', 'financeHolds', 'updatedAt']);
    }
    // The payment that covers a received order closes it (prototype: closed by Finance's payment).
    // The sum is re-checked by the write inside its transaction; the rule pins the shape.
    function poFinanceCloses() {
      return (isOrgOwner() || hasOrgPermission('invoices.manage') || hasOrgPermission('accounting.post'))
        && poFrom() == 'accepted' && poTo() == 'closed'
        && request.resource.data.get('closedByPayment', false) == true
        && request.resource.data.get('closedShort', true) == false
        && request.resource.data.financePayments.size() == resource.data.get('financePayments', []).size() + 1
        && request.resource.data.log.size() == resource.data.get('log', []).size() + 1
        && poChanged().hasOnly(['financePayments', 'status', 'closedAt', 'closedShort', 'closedByPayment', 'log', 'updatedAt']);
    }

    // R-25: Procurement refers an overrun to the project's manager — once; the order then waits.
    function poRefersBudget() {
      return poDecider() && poMineOrNotBuyer()
        && poFrom() == 'awaiting_approval' && poTo() == 'awaiting_approval'
        && resource.data.get('pmBudget', null) == null
        && request.resource.data.pmBudget.state == 'pending'
        && poChanged().hasOnly(['pmBudget', 'log', 'updatedAt']);
    }
    // R-25: the project answers — a holder of `approve` on that PM project (or the owner).
    function poPmDecidesBudget() {
      return resource.data.get('projectId', '') is string && resource.data.get('projectId', '') != ''
        && (isOrgOwner() || pmDuty(resource.data.projectId, 'approve'))
        && poFrom() == 'awaiting_approval' && poTo() == 'awaiting_approval'
        && resource.data.get('pmBudget', null) != null
        && resource.data.pmBudget.get('state', '') == 'pending'
        && request.resource.data.pmBudget.state in ['accepted', 'renegotiate']
        && request.resource.data.pmBudget.byName is string
        && (request.resource.data.pmBudget.state == 'accepted'
            || (request.resource.data.pmBudget.get('note', '') is string && request.resource.data.pmBudget.get('note', '').size() > 0))
        && poChanged().hasOnly(['pmBudget', 'log', 'updatedAt']);
    }
    // R-29 / P-19: Projects asks to stop what has not arrived of ONE line — written in the PM's
    // stopLine transaction (requestPmStopInTx). `pmCancelKey` names the line so the rule can
    // check that exactly that entry changed. By a holder of `approve` on the project, or the
    // requester (duty `req`) of the material request the entry names. Nothing is cancelled —
    // Procurement cancels with the supplier.
    function pmRequestNamesOrder(projectId, entry, poId) {
      let req = get(/databases/$(database)/documents/projects/$(projectId)/purchaseRequests/$(entry.requestId)).data;
      return req.get('poId', '') == poId
        || req.get('lineLinks', {}).get(entry.get('line', ''), {}).get('poId', '') == poId;
    }
    function poPmStops() {
      let key = request.resource.data.get('pmCancelKey', '');
      let entry = request.resource.data.pmCancels[key];
      let projectId = entry.get('projectId', '');
      let orderProject = resource.data.get('projectId', null);
      return key is string && key != ''
        // At whatever stage the order is: the project's line closes in the same
        // transaction, and an order approved without the stop on it would bring
        // what nobody wants any more.
        && poTo() == poFrom() && poFrom() in ['awaiting_approval', 'approved', 'sent', 'accepted']
        && poChanged().hasOnly(['pmCancels', 'pmCancelKey', 'updatedAt'])
        && request.resource.data.pmCancels.diff(resource.data.get('pmCancels', {})).affectedKeys().hasOnly([key])
        && entry.reason is string && entry.reason.size() > 0
        && entry.byName is string
        && projectId is string && projectId != ''
        && entry.requestId is string
        // The project's own order — or one raised for several projects (it names no
        // project), and then the request the entry names must itself name this order.
        && (orderProject == projectId
            || ((orderProject == null || orderProject == '') && inProjectOrg(projectId) && pmRequestNamesOrder(projectId, entry, resource.id)))
        && (pmDuty(projectId, 'approve')
            || (pmDuty(projectId, 'req')
                && get(/databases/$(database)/documents/projects/$(projectId)/purchaseRequests/$(entry.requestId)).data.get('requestedByUserId', '') == request.auth.uid));
    }

    function poRates() {
      return (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && poMineOrNotBuyer()
        && poTo() == poFrom() && poFrom() in ['accepted', 'closed']
        && resource.data.get('rating', null) == null
        && request.resource.data.get('rating', null) != null
        && poChanged().hasOnly(['rating', 'log', 'updatedAt']);
    }
    // The supplier, in his own portal: sent → accepted with the date he commits to.
    function poSupplierAccepts() {
      return resource.data.get('supplierOrgId', '') == getOrganizationId()
        && resource.data.get('supplierOrgId', '') != 'guest'
        && poFrom() == 'sent' && poTo() == 'accepted'
        && request.resource.data.get('acceptanceRecordedBy', '') == 'supplier'
        && request.resource.data.get('promisedDate', '') is string
        && poChanged().hasOnly(['status', 'supplierAcceptedAt', 'promisedDate', 'acceptanceRecordedBy', 'log', 'updatedAt']);
    }
    match /purchaseOrders/{poId} {
      // The buyer's team reads its orders; the supplier reads the ones addressed to him.
      // (A guest's order carries supplierOrgId "guest", which is nobody's org id.)
      allow get, list: if isSignedIn() && (isAdmin()
        || isOrgMember(resource.data.organizationId)
        || resource.data.supplierOrgId == getOrganizationId());
      // Prepared by whoever may award, in their own name, born awaiting approval —
      // never born approved, sent or rated.
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (isOrgOwner() || hasOrgPermission('offers.accept'))
        && request.resource.data.get('preparedById', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'awaiting_approval'
        && request.resource.data.get('approvedById', null) == null
        && request.resource.data.get('sentAt', null) == null
        && request.resource.data.get('rating', null) == null
        && request.resource.data.get('basis', '') in ['rfq', 'direct', 'retroactive']
        && (request.resource.data.get('basis', '') != 'retroactive' || request.resource.data.get('approverKind', '') == 'owner')
        && request.resource.data.get('approverKind', '') in ['manager', 'owner']
        && request.resource.data.get('docNumber', '') is string
        && request.resource.data.get('docNumber', '').size() > 0;
      allow update: if isSignedIn() && poIdentityUntouched() && (isAdmin()
        || (isOrgMember(resource.data.organizationId)
            && (poApproves() || poReturns() || poResubmits() || poExpedites() || poDecides() || poReceives() || poRates()
                || poSelfIssues() || poDecidesHold() || poFinance() || poFinanceCloses()
                || poRefersBudget() || poPmDecidesBudget() || poPmStops()))
        || poSupplierAccepts());
      // Orders are records other documents point at — only an admin removes one.
      allow delete: if isAdmin();
    }

    // Procurement policies (§6.4) — one document per org, read by every
    // member, set by the owner or an approver. Absent = the PRD's reference values.
    // HR 1.0 settings (ST-01…06) — one document per org: features, policies,
    // establishment. Read by every member (tabs follow the features); written by
    // the HR manager.
    match /hrSettings/{orgId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(orgId));
      allow create, update: if isOrgMember(orgId)
        && request.resource.data.get('organizationId', orgId) == orgId
        && hrManager();
      // A visa arrival recorded by government relations uses one visa — the
      // count goes down by exactly one and nothing else changes.
      allow update: if isOrgMember(orgId) && hrRole('hr.gov')
        && changedKeys().hasOnly(['establishment'])
        && request.resource.data.establishment.diff(resource.data.establishment).affectedKeys().hasOnly(['visas'])
        && resource.data.establishment.get('visas', 0) is int
        && resource.data.establishment.get('visas', 0) > 0
        && request.resource.data.establishment.visas == resource.data.establishment.visas - 1;
      allow delete: if isAdmin();
    }

    // PM 1.0 company policies — `pmSettings/{orgId}`: the recorded self-approval
    // (C-32). Read by the org; written by the org owner only, with who and when.
    match /pmSettings/{orgId} {
      allow read: if isSignedIn() && orgId == getOrganizationId();
      allow create, update: if isSignedIn() && orgId == getOrganizationId() && isOrgOwner()
        && request.resource.data.organizationId == orgId
        && request.resource.data.selfApproval is bool
        && request.resource.data.selfApprovalBy == request.auth.uid
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
             .hasOnly(['organizationId', 'selfApproval', 'selfApprovalBy', 'selfApprovalByName', 'selfApprovalOn', 'updatedAt']);
      allow delete: if false;
    }

    match /procurementSettings/{orgId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(orgId));
      // The limits that bound the approver himself (his approval limit, the buyer's
      // self-issue limit, the direct cap, Inventory's tolerance) are the owner's alone.
      allow create, update: if isOrgMember(orgId)
        && request.resource.data.get('organizationId', orgId) == orgId
        && (isOrgOwner()
            || (hasOrgPermission('po.approve')
                && !request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
                      .hasAny(['managerApprovalLimit', 'buyerSelfIssueLimit', 'directPurchaseCap', 'overReceiptTolerancePercent'])));
      allow delete: if isAdmin();
    }

    // The receiver register (PRD 3.0 §4 `RCVR`) — who receives goods and at which
    // warehouses. Read by any member (the forward dialog and the receiving desk
    // both list it); kept by whoever prepares or approves an order, so a store
    // keeper cannot add himself to another site. Never deleted: a delivery
    // forwarded to somebody names them, so retiring is `active: false`.
    match /procurementReceivers/{receiverId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() > 1
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('phone', '').size() > 0
        && request.resource.data.get('module', '') in ['inventory', 'projects']
        && request.resource.data.warehouseIds is list
        && request.resource.data.get('active', false) == true
        && request.resource.data.get('createdById', '') == request.auth.uid;
      allow update: if isOrgMember(resource.data.organizationId)
        && (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
        && request.resource.data.get('module', '') in ['inventory', 'projects']
        && changedKeys()
             .hasOnly(['name', 'title', 'module', 'phone', 'userId', 'warehouseIds', 'active', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Price agreements (PRD 3.0 §4 `AGR`) — a price we already negotiated, so an
    // order may be placed on it without going back to the market. Read by any
    // member (it prices what they are sourcing); written by whoever may award or
    // approve an order, because it commits the company to a price.
    // Our record of a supplier (Procurement PRD 3.0 §7.2) — doc id
    // `{orgId}__{supplierOrgId}`. The facts WE vouch for: VAT number, CR
    // expiry, payment terms (Finance reads them), lead time, kind, and whether
    // the manager verified him. A buyer (suppliers.manage) may only ADD one,
    // unverified, from the platform directory; verifying and editing it is the
    // manager's (owner / po.approve). Never deleted — the log is its history.
    // `get` on a missing doc is allowed so the verify/edit transactions can read
    // "not there yet" without an evaluation error.
    match /supplierRecords/{recordId} {
      allow get: if isSignedIn() && (resource == null || isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && recordId == request.resource.data.organizationId + '__' + request.resource.data.supplierOrgId
        && (
          (procSupplierManager()
            && request.resource.data.get('verified', null) == false
            && request.resource.data.get('source', '') == 'directory'
            && request.resource.data.get('addedById', '') == request.auth.uid)
          || hasOrgPermission('po.approve')
        );
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.supplierOrgId == resource.data.supplierOrgId
        && hasOrgPermission('po.approve');
      // Favouriting a supplier is logged in his file (S-35): whoever manages suppliers may
      // append exactly one favourite line in his own name, and change nothing else.
      allow update: if isOrgMember(resource.data.organizationId)
        && (procSupplierManager() || hasOrgPermission('po.approve'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['log'])
        && request.resource.data.log.size() == resource.data.get('log', []).size() + 1
        && request.resource.data.log[request.resource.data.log.size() - 1].action in ['favourite_on', 'favourite_off']
        && request.resource.data.log[request.resource.data.log.size() - 1].byId == request.auth.uid;
      // The send form keeps the phone / e-mail the sender typed: whoever may send an order
      // touches only the contact fields.
      allow update: if isOrgMember(resource.data.organizationId)
        && (hasOrgPermission('po.expedite') || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactPhone', 'contactEmail', 'contactSavedAt', 'contactSavedByName'])
        && request.resource.data.get('contactSavedByName', '') is string;
      allow create: if isOrgMember(request.resource.data.organizationId)
        && recordId == request.resource.data.organizationId + '__' + request.resource.data.supplierOrgId
        && request.resource.data.supplierOrgId != 'guest'
        && (hasOrgPermission('po.expedite') || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && request.resource.data.keys().hasOnly(['organizationId', 'supplierOrgId', 'supplierName', 'contactPhone', 'contactEmail', 'contactSavedAt', 'contactSavedByName']);
      allow delete: if false;
    }

    match /priceAgreements/{agreementId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (isOrgOwner() || hasOrgPermission('offers.accept') || hasOrgPermission('po.approve'))
        && request.resource.data.get('preparedById', '') == request.auth.uid
        && request.resource.data.get('docNumber', '') is string
        && request.resource.data.get('docNumber', '').size() > 0
        && request.resource.data.get('supplierOrgId', '') is string
        && request.resource.data.get('supplierOrgId', '').size() > 0
        && request.resource.data.get('from', '') is string
        && request.resource.data.get('until', '') is string
        && request.resource.data.get('until', '') >= request.resource.data.get('from', '')
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0;
      // Renewing moves the end date and the prices; the supplier, the number and
      // the org it belongs to are what the history points at, so they are frozen.
      allow update: if isOrgMember(resource.data.organizationId)
        && (isOrgOwner() || hasOrgPermission('po.approve'))
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.docNumber == resource.data.docNumber
        && request.resource.data.supplierOrgId == resource.data.supplierOrgId
        && request.resource.data.get('from', '') == resource.data.get('from', '')
        && request.resource.data.get('until', '') >= resource.data.get('from', '')
        && changedKeys()
             .hasOnly(['until', 'lines', 'note', 'endedAt', 'log', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Price history (PRD 3.0 §4 `PH`) — every price we committed to, with its
    // supplier and day. An append-only ledger: it is what a price argument is
    // settled with, so a row is never edited and never removed. Written by the
    // approval itself at a deterministic id (`{poId}__{lineId}`), which is why a
    // create may land on a document that already exists.
    match /priceHistory/{entryId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.get('materialKey', '') is string
        && request.resource.data.get('materialKey', '').size() > 0
        && request.resource.data.get('price', 0) is number
        && request.resource.data.get('price', 0) > 0
        && request.resource.data.get('day', '') is string
        && request.resource.data.get('kind', '') in ['po', 'variance'];
      // A retried approval rewrites its own row; nothing else may move, and the
      // material, the supplier and the day it happened never change.
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.materialKey == resource.data.materialKey
        && request.resource.data.get('poId', '') == resource.data.get('poId', '')
        && request.resource.data.get('day', '') == resource.data.get('day', '')
        && request.resource.data.get('supplierOrgId', '') == resource.data.get('supplierOrgId', '');
      allow delete: if isAdmin();
    }

    // Mdmak internal procurement records — admin-only (hides internal cost/commission from contractors)
    match /mdmakProcurement/{procurementId} {
      allow read, write: if isAdmin();
    }

    // Platform-wide settings — admin-only read/write
    match /platformSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Demo requests — public write (unauthenticated form submissions), admin read
    match /demoRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'company', 'phone', 'email'])
        && request.resource.data.name is string
        && request.resource.data.company is string
        && request.resource.data.phone is string
        && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    match /onboardingRequests/{requestId} {
      // Only ever written server-side (POST /api/onboarding/request via
      // Admin SDK, which bypasses this rule) — no client create clause.
      allow read, update, delete: if isAdmin();
    }

    // Employee records — scoped to an organization
    // list uses isSignedIn() (no resource.data on collection queries); the app's
    // where(organizationId==) clause enforces isolation at query time.
    // HR 1.0 workplaces (AS-01) — project sites, workshop, warehouse, fleet,
    // showroom, department, head office. Read by every member (people, attendance
    // and cost all point at them); kept by the HR manager; deactivated, never deleted.
    // Attendance (AT-01…04): one document per workplace and month. Recorded by
    // the HR manager, payroll or the site's supervisor; the missing-days
    // declaration by the HR manager or the supervisor only; closed after the
    // month by any of the three — and after that nothing changes, ever.
    match /hrAttendance/{id} {
      // A month is read before it exists (the first sheet, a declaration, the
      // closing, payroll's check): a missing document must read as missing —
      // `resource.data` on it is an error, and an error refuses.
      allow get: if isSignedIn() && (isAdmin() || ((resource == null || isOrgMember(resource.data.organizationId))
        && (hrRole('employees.manage') || hrRole('hr.payroll') || hrRole('hr.management')
            || (resource == null ? hrRole('hr.supervisor') : hrSupervises(resource.data.siteId)))));
      allow list: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && (hrRole('employees.manage') || hrRole('hr.payroll') || hrRole('hr.management'))));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && id == request.resource.data.organizationId + '__' + request.resource.data.siteId + '__' + request.resource.data.month
        && (hrManager() || hrRole('hr.payroll') || hrSupervises(request.resource.data.siteId))
        && (request.resource.data.get('declarations', []).size() == 0 || hrManager() || hrSupervises(request.resource.data.siteId));
      allow update: if isOrgMember(resource.data.organizationId)
        && resource.data.get('closed', null) == null
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.siteId == resource.data.siteId
        && request.resource.data.month == resource.data.month
        && (hrManager() || hrRole('hr.payroll') || hrSupervises(resource.data.siteId))
        && (request.resource.data.get('declarations', []) == resource.data.get('declarations', [])
          || hrManager() || hrSupervises(resource.data.siteId));
      allow delete: if false;
    }

    match /hrSites/{siteId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hrManager()
        && request.resource.data.type in ['project', 'workshop', 'warehouse', 'fleet', 'showroom', 'department', 'hq']
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() > 0;
      allow update: if isOrgMember(resource.data.organizationId)
        && hrManager()
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.type in ['project', 'workshop', 'warehouse', 'fleet', 'showroom', 'department', 'hq'];
      allow delete: if isAdmin();
    }

    // HR 1.0 — the employee record (EM-01…06). HR staff read the org's people; an
    // employee reads his own (ES-05). Pay is NEVER on this document (RL-03) — it
    // lives in employeePay. The permanent number never changes (EM-02); a record
    // is never deleted (an exit closes it).
    match /employees/{employeeId} {
      allow get, list: if isSignedIn() && (isAdmin()
        || (isOrgMember(resource.data.organizationId)
            && (hrStaff() || resource.data.get('userId', '') == request.auth.uid)));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (hrManager() || hrRole('hr.gov'))
        && !('salary' in request.resource.data);
      // Government relations records renewals — the documents and nothing else
      // (assigning, status, probation and balances are the HR manager's). The
      // link to a user opens that person's pay to him (RL-03): only the HR
      // manager sets it, and never onto or off himself (the owner excepted).
      allow update: if isOrgMember(resource.data.organizationId)
        && (hrManager() || (hrRole('hr.gov') && changedKeys().hasOnly(['docs', 'updatedAt'])))
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.get('no', null) == resource.data.get('no', null)
        && !('salary' in request.resource.data && request.resource.data.salary != resource.data.get('salary', null))
        && (request.resource.data.get('userId', null) == resource.data.get('userId', null)
            || isOrgOwner()
            || (request.resource.data.get('userId', null) != request.auth.uid && resource.data.get('userId', null) != request.auth.uid));
      // Management decides the HR manager's own leave (LV-05): only its effects.
      allow update: if isOrgMember(resource.data.organizationId)
        && hrRole('hr.management')
        && changedKeys().hasOnly(['leaveTaken', 'sick', 'hajjTaken', 'contact', 'updatedAt']);
      allow delete: if isAdmin();

      // The undeletable log (EM-06): written by HR staff or the employee himself,
      // in his own name; read by HR staff and the employee.
      match /log/{entryId} {
        allow read: if isOrgMember(get(/databases/$(database)/documents/employees/$(employeeId)).data.organizationId)
          && (hrStaff() || get(/databases/$(database)/documents/employees/$(employeeId)).data.get('userId', '') == request.auth.uid);
        // The first entry is written in the transaction that creates the employee:
        // get() sees the state BEFORE it (no parent yet — an error, a refusal);
        // getAfter() sees the record as the transaction leaves it.
        allow create: if isOrgMember(getAfter(/databases/$(database)/documents/employees/$(employeeId)).data.organizationId)
          && request.resource.data.by == request.auth.uid
          && (hrStaff() || getAfter(/databases/$(database)/documents/employees/$(employeeId)).data.get('userId', '') == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // HR 1.0 — pay and bank (RL-03): the HR manager, payroll and management — and
    // the employee himself, read through the link on his record. Government
    // relations and supervisors never. Payroll only marks a returned IBAN fixed;
    // the HR manager approves it (RL-02).
    match /employeePay/{employeeId} {
      // Read before it exists too: a joiner recorded without pay has no document
      // until the HR manager enters the wage.
      allow get: if isSignedIn() && (isAdmin()
        || ((resource == null || isOrgMember(resource.data.organizationId))
            && (hrSeesPay() || hrFinance() || hrOwnRecord(employeeId))));
      allow list: if isOrgMember(resource.data.organizationId) && hrSeesPay();
      allow create: if isOrgMember(request.resource.data.organizationId) && hrManager();
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        // The HR manager — but never the wage or bank of his OWN record (RL-02;
        // the owner excepted): on it, only what the payroll he approves moves.
        // That check comes FIRST: approving a payroll writes many of these at
        // once, and the record lookup behind hrOwnRecord() must not run for
        // each (a transaction may look up twenty documents, no more).
        && ((hrManager() && (changedKeys().hasOnly(['advance', 'retro', 'updatedAt']) || isOrgOwner() || !hrOwnRecord(employeeId)))
            || (hrRole('hr.payroll')
                && changedKeys().hasOnly(['iban', 'ibanState', 'ibanFixedBy', 'updatedAt'])
                && request.resource.data.ibanState == 'fixed'
                && request.resource.data.get('ibanFixedBy', '') == request.auth.uid)
            // Finance records a returned transfer (fin:RETURNED) — the IBAN goes back to payroll.
            || (hrFinance()
                && changedKeys().hasOnly(['ibanState', 'updatedAt'])
                && request.resource.data.ibanState == 'returned')
            // An approved advance: management (the HR manager's own) or Finance (above the limit).
            || ((hrRole('hr.management') || hrFinance())
                && changedKeys().hasOnly(['advance', 'updatedAt'])
                && (isOrgOwner() || !hrOwnRecord(employeeId)))
            // The HR manager's own data update, decided by management (ES-03, LV-05).
            || (hrRole('hr.management')
                && changedKeys().hasOnly(['iban', 'ibanState', 'updatedAt'])
                && request.resource.data.ibanState == 'ok'));
      allow delete: if isAdmin();
    }

    // Payroll (PY-02…05): prepared by payroll or the HR manager and recomputed
    // until approved; approved by the HR manager who did not prepare it (the
    // org owner excepted, flagged); then Finance marks it posted and paid.
    // Carries every wage: pay roles and Finance only.
    match /hrPayrolls/{payrollId} {
      // Read before it exists (preparing a month): missing must read as missing.
      allow get, list: if isSignedIn() && (isAdmin() || ((resource == null || isOrgMember(resource.data.organizationId)) && (hrSeesPay() || hrFinance())));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && payrollId == request.resource.data.organizationId + '__' + request.resource.data.key
        && request.resource.data.state == 'prepared'
        && request.resource.data.prepared.by == request.auth.uid
        && (hrManager() || hrRole('hr.payroll'));
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.key == resource.data.key
        && (
          (resource.data.state == 'prepared' && request.resource.data.state == 'prepared'
            && request.resource.data.prepared.by == request.auth.uid
            && (hrManager() || hrRole('hr.payroll')))
          || (resource.data.state == 'prepared' && request.resource.data.state == 'approved'
            && changedKeys().hasOnly(['state', 'approved', 'ownFlagged', 'updatedAt'])
            && hrManager() && (resource.data.prepared.by != request.auth.uid || isOrgOwner()))
          || (resource.data.state in ['approved', 'posted', 'paid'] && request.resource.data.state in ['posted', 'paid']
            && (resource.data.state != 'paid' || request.resource.data.state == 'paid')
            && changedKeys().hasOnly(['state', 'posted', 'paid', 'returned', 'paidHeld', 'updatedAt'])
            && hrFinance())
        );
      allow delete: if false;
    }

    // Payslips (ES-04): written by Finance once the payroll is paid, one per
    // line; the employee reads his own; nothing changes them afterwards.
    match /hrPayslips/{payslipId} {
      allow get, list: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && (hrSeesPay() || hrFinance() || resource.data.get('employeeUserId', '') == request.auth.uid)));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hrFinance()
        && payslipId == request.resource.data.payrollId + '__' + request.resource.data.employeeId
        && exists(/databases/$(database)/documents/hrPayrolls/$(request.resource.data.payrollId))
        && get(/databases/$(database)/documents/hrPayrolls/$(request.resource.data.payrollId)).data.state == 'paid';
      allow update, delete: if false;
    }

    // The outbox to Finance (§7.2): one document per event key, written once by
    // the approving HR manager; Finance only marks it posted / paid.
    match /hrEvents/{eventId} {
      // "Never sent twice" is a read of an event that does not exist yet.
      allow get, list: if isSignedIn() && (isAdmin() || ((resource == null || isOrgMember(resource.data.organizationId)) && (hrSeesPay() || hrFinance())));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && eventId == request.resource.data.organizationId + '__' + request.resource.data.key
        && request.resource.data.state == 'sent'
        && hrManager();
      allow update: if isOrgMember(resource.data.organizationId)
        && hrFinance()
        && changedKeys().hasOnly(['state', 'posted', 'paid', 'entryId', 'updatedAt'])
        && request.resource.data.state in ['posted', 'paid'];
      allow delete: if false;
    }

    // Violations and penalties (PN-01…04): recorded by the site's supervisor
    // (his sheet) or the HR manager, at a fixed id; decided by the HR manager
    // after a hearing — never his own; objected by the employee himself;
    // the objection decided by the HR manager. A penalty carries money: pay
    // roles and the employee read it; a supervisor reads his site's (his sheet
    // must know a violation is already recorded), and anyone on HR staff may
    // learn that an id does NOT exist.
    match /hrViolations/{violationId} {
      allow get: if isSignedIn() && (isAdmin()
        || (resource == null && hrStaff())
        || (resource != null && isOrgMember(resource.data.organizationId)
            && (hrSeesPay() || resource.data.get('employeeUserId', '') == request.auth.uid
                || (resource.data.get('siteId', null) is string && hrSupervises(resource.data.siteId)))));
      allow list: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && (hrSeesPay() || resource.data.get('employeeUserId', '') == request.auth.uid)));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && violationId == request.resource.data.organizationId + '__' + request.resource.data.employeeId + '__' + request.resource.data.on + '__' + request.resource.data.code
        && request.resource.data.state == 'recorded'
        && request.resource.data.recorded.by == request.auth.uid
        && exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeId))
        && request.resource.data.employeeUserId == get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.get('userId', null)
        && (hrManager() || (request.resource.data.get('siteId', null) is string && hrSupervises(request.resource.data.siteId)));
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.code == resource.data.code
        && request.resource.data.on == resource.data.on
        && (
          (resource.data.state == 'recorded' && request.resource.data.state in ['applied', 'dismissed']
            && changedKeys().hasOnly(['state', 'hearing', 'step', 'stepKind', 'amount', 'deductMonth', 'notifiedOn', 'decision', 'updatedAt'])
            && (request.resource.data.state != 'applied' || request.resource.data.get('hearing', null) != null)
            && hrManager() && (resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner()))
          || (resource.data.state == 'applied' && request.resource.data.state == 'objected'
            && changedKeys().hasOnly(['state', 'objection', 'updatedAt'])
            && resource.data.get('employeeUserId', '') == request.auth.uid)
          || (resource.data.state == 'objected' && request.resource.data.state in ['upheld', 'cancelled']
            && changedKeys().hasOnly(['state', 'deductMonth', 'objectionDecision', 'updatedAt'])
            && hrManager() && (resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner()))
        );
      allow delete: if false;
    }

    // End of service (EX-01…06). The exit carries no money: HR staff, the
    // employee, Inventory (it clears the custody) and Finance read it. Started by
    // the HR manager — never his own; custody cleared by Inventory only; the
    // platform tasks by government relations or the HR manager; paid by Finance.
    match /hrExits/{exitId} {
      // Starting an exit first checks that none exists: missing reads as missing.
      allow get, list: if isSignedIn() && (isAdmin() || ((resource == null || isOrgMember(resource.data.organizationId))
        && (hrStaff() || hrFinance() || hasOrgPermission('warehouses.manage') || hasOrgPermission('warehouses.receive')
            || resource.data.get('employeeUserId', '') == request.auth.uid)));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && exitId == request.resource.data.organizationId + '__' + request.resource.data.employeeId
        && request.resource.data.state == 'leaving'
        && request.resource.data.custody.state == 'requested'
        && request.resource.data.started.by == request.auth.uid
        && hrManager()
        && (request.resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner());
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.employeeId == resource.data.employeeId
        && (
          (resource.data.custody.state == 'requested' && request.resource.data.custody.state == 'cleared'
            && changedKeys().hasOnly(['custody', 'updatedAt'])
            && (hasOrgPermission('warehouses.manage') || hasOrgPermission('warehouses.receive')))
          || (changedKeys().hasOnly(['tasks', 'updatedAt'])
            && (hrManager() || hrRole('hr.gov')))
          || (resource.data.state == 'leaving' && request.resource.data.state == 'settled'
            && resource.data.custody.state == 'cleared'
            && changedKeys().hasOnly(['state', 'settled', 'updatedAt'])
            && hrManager() && (resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner()))
          || (resource.data.state == 'settled' && request.resource.data.state == 'paid'
            && changedKeys().hasOnly(['state', 'paid', 'updatedAt'])
            && hrFinance())
        );
      allow delete: if false;
    }

    // The settlement (EX-02, EX-04) — money: pay roles, Finance and the employee.
    match /hrSettlements/{settlementId} {
      allow get, list: if isSignedIn() && (isAdmin() || ((resource == null || isOrgMember(resource.data.organizationId))
        && (hrSeesPay() || hrFinance() || resource.data.get('employeeUserId', '') == request.auth.uid)));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.state == 'approved'
        && request.resource.data.approved.by == request.auth.uid
        && hrManager()
        && (request.resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner())
        && exists(/databases/$(database)/documents/hrExits/$(settlementId))
        && get(/databases/$(database)/documents/hrExits/$(settlementId)).data.custody.state == 'cleared';
      allow update: if isOrgMember(resource.data.organizationId)
        && resource.data.state == 'approved' && request.resource.data.state == 'paid'
        && changedKeys().hasOnly(['state', 'paid', 'entryId', 'updatedAt'])
        && hrFinance();
      allow delete: if false;
    }

    // Work injuries (DC-07, WF-15): recorded by the site's supervisor or the HR
    // manager; the GOSI report number by government relations or the HR manager.
    match /hrInjuries/{injuryId} {
      allow get, list: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && (hrStaff() || resource.data.get('employeeUserId', '') == request.auth.uid)));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.recorded.by == request.auth.uid
        && request.resource.data.get('report', null) == null
        && (hrManager() || (request.resource.data.get('siteId', null) is string && hrSupervises(request.resource.data.siteId)));
      allow update: if isOrgMember(resource.data.organizationId)
        && resource.data.get('report', null) == null
        && changedKeys().hasOnly(['report', 'updatedAt'])
        && (hrManager() || hrRole('hr.gov'));
      allow delete: if false;
    }

    // Manpower requests (HR AS-02, WF-12): Projects asks — the project's editor
    // or its PM 1.0 manager; the HR manager answers with the coverage plan. No
    // pay inside: the org's members read them.
    match /manpowerRequests/{requestId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.state == 'open'
        && request.resource.data.requested.by == request.auth.uid
        && request.resource.data.get('answer', null) == null
        && (hasOrgPermission('projects.edit') || hasProjectPermission(request.resource.data.projectId, 'projects.edit')
            || isPmProjectManager(request.resource.data.projectId)
            // an adopted or hand-made PM project has a manager and no handover file
            || (projectData(request.resource.data.projectId).get('pm', null) != null
                && projectData(request.resource.data.projectId).get('projectManagerId', '') == request.auth.uid));
      allow update: if isOrgMember(resource.data.organizationId)
        && resource.data.state == 'open'
        && (
          (request.resource.data.state == 'answered' && hrManager()
            && changedKeys().hasOnly(['state', 'answer', 'updatedAt']))
          || (request.resource.data.state == 'withdrawn' && resource.data.requested.by == request.auth.uid
            && changedKeys().hasOnly(['state', 'updatedAt']))
        );
      allow delete: if false;
    }

    // HR requests (LV, AD): filed by the employee — or the HR manager for him —
    // endorsed by the site's supervisor or the line manager, decided by the HR
    // manager, the HR manager's own by management; an advance above the limit
    // by Finance. Nobody decides his own (RL-02) — the org owner excepted, flagged.
    // An advance carries money: read by pay roles, the employee and Finance only.
    match /hrRequests/{requestId} {
      allow get, list: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && (hrSeesPay()
            || (resource.data.kind == 'leave' && hrStaff())
            || resource.data.get('employeeUserId', '') == request.auth.uid
            || (resource.data.kind == 'advance' && hrFinance()))));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.kind in ['leave', 'advance', 'data']
        && request.resource.data.state == 'pending'
        && request.resource.data.filedBy.by == request.auth.uid
        && exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeId))
        && get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.organizationId == request.resource.data.organizationId
        && request.resource.data.employeeUserId == get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.get('userId', null)
        && (hrManager() || request.resource.data.employeeUserId == request.auth.uid)
        && (request.resource.data.employeeUserId != request.auth.uid || !hrManager() || isOrgOwner()
            || request.resource.data.deciderLevel == 'management')
        && request.resource.data.get('financeHold', false) == false;
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.employeeId == resource.data.employeeId
        && (
          // endorse — the site's supervisor or the line manager, never his own
          (resource.data.kind == 'leave' && resource.data.state == 'pending' && request.resource.data.state == 'endorsed'
            && changedKeys().hasOnly(['state', 'endorsement', 'updatedAt'])
            && resource.data.get('employeeUserId', '') != request.auth.uid
            && ((resource.data.get('siteId', null) is string && hrSupervises(resource.data.siteId)) || resource.data.get('lineManagerUserId', '') == request.auth.uid))
          // decide
          || (resource.data.state in ['pending', 'endorsed'] && request.resource.data.state in ['approved', 'declined', 'finance']
            && changedKeys().hasOnly(['state', 'decision', 'financeHold', 'leave', 'advance', 'updatedAt'])
            && (request.resource.data.state != 'finance' || resource.data.kind == 'advance')
            && (resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner())
            && ((resource.data.deciderLevel == 'manager' && hrManager())
                || (resource.data.deciderLevel == 'management' && hrRole('hr.management'))
                || isOrgOwner()))
          // Finance decides what HR sent up
          || (resource.data.state == 'finance' && request.resource.data.state in ['approved', 'declined']
            && changedKeys().hasOnly(['state', 'finance', 'updatedAt'])
            && hrFinance() && (resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner()))
          // Finance pays out an approved advance (fin:PRPAID)
          || (resource.data.kind == 'advance' && resource.data.state == 'approved' && request.resource.data.state == 'approved'
            && changedKeys().hasOnly(['payout', 'updatedAt'])
            && hrFinance() && (resource.data.get('employeeUserId', '') != request.auth.uid || isOrgOwner()))
          // cancel before it starts
          || (request.resource.data.state == 'cancelled'
            && changedKeys().hasOnly(['state', 'cancel', 'updatedAt'])
            && ((resource.data.state in ['pending', 'endorsed'] && (resource.data.get('employeeUserId', '') == request.auth.uid || hrManager()))
                || (resource.data.state == 'approved' && resource.data.kind == 'leave' && hrManager())))
        );
      allow delete: if false;
    }

    // The last permanent employee number (EM-02) — only ever moves forward.
    match /hrCounters/{orgId} {
      allow get: if isOrgMember(orgId);
      allow create: if isOrgMember(orgId) && (hrManager() || hrRole('hr.gov'))
        && request.resource.data.lastEmployeeNo is int && request.resource.data.lastEmployeeNo >= 1;
      allow update: if isOrgMember(orgId) && (hrManager() || hrRole('hr.gov'))
        && request.resource.data.lastEmployeeNo is int
        && request.resource.data.lastEmployeeNo > resource.data.lastEmployeeNo
        && request.resource.data.lastEmployeeNo <= resource.data.lastEmployeeNo + 500;
      allow delete: if isAdmin();
    }

    // CRM contacts — scoped to an organization
    match /crmContacts/{contactId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
      allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));

      match /opportunities/{opportunityId} {
        allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/crmContacts/$(contactId)).data.organizationId
        ));
        allow create: if isOrgMember(request.resource.data.organizationId);
        allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/crmContacts/$(contactId)).data.organizationId
        ));
      }

      match /quotations/{quotationId} {
        allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/crmContacts/$(contactId)).data.organizationId
        ));
        allow create: if isOrgMember(request.resource.data.organizationId);
        allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/crmContacts/$(contactId)).data.organizationId
        ));
      }
    }


    // CRM opportunities and quotations — top-level and org-scoped so the
    // pipeline pages can list every deal in one query. They used to be
    // subcollections of crmContacts (rules above, kept until
    // scripts/migrate-crm-subcollections.ts has run everywhere), which made
    // an org-wide read impossible without a collection-group index.
    // Closing a deal — the write that first sets its state to won / lost /
    // handed_over, or its stage to won / lost — needs `crm.close` (mirrors
    // src/lib/permissions.ts). Every other edit is open to org members, as
    // is a project manager's rejection sending a deal back to "won".
    function closesOpportunity() {
      let oldState = ('state' in resource.data) ? resource.data.state : 'open';
      let newState = ('state' in request.resource.data) ? request.resource.data.state : 'open';
      let oldStage = ('stage' in resource.data) ? resource.data.stage : '';
      let newStage = ('stage' in request.resource.data) ? request.resource.data.stage : '';
      return (oldState == 'open' && newState in ['won', 'lost', 'handed_over'])
        || (newState == 'handed_over' && oldState != 'handed_over')
        || (newStage in ['won', 'lost'] && !(oldStage in ['won', 'lost']));
    }

    match /crmOpportunities/{opportunityId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId))
        && !(('state' in request.resource.data) && request.resource.data.state in ['won', 'lost', 'handed_over'])
        && !(('stage' in request.resource.data) && request.resource.data.stage in ['won', 'lost']);
      allow update: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && (!closesOpportunity() || hasOrgPermission('crm.close'))));
      allow delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
    }

    // Recording a customer's payment (Sales) changes `paidAt` / `payments` /
    // `paidAmount`. That needs sales.approve or invoices.manage — mirrors the
    // gate in the Sales view. `.get()` with a default so a quotation written
    // before the fields existed evaluates cleanly instead of erroring.
    function recordsQuotationPayment() {
      return request.resource.data.get('paidAt', null) != resource.data.get('paidAt', null)
        || request.resource.data.get('payments', {}) != resource.data.get('payments', {})
        || request.resource.data.get('paidAmount', null) != resource.data.get('paidAmount', null);
    }
    // Marking a quotation accepted is the customer's approval — it posts the
    // deposit to Finance and opens the work order — so it needs sales.approve
    // (or crm.close: the same authority when a deal is awarded from the CRM).
    function acceptsQuotation() {
      return request.resource.data.get('status', 'draft') == 'accepted'
        && resource.data.get('status', 'draft') != 'accepted';
    }
    function canApproveQuotation() {
      return hasOrgPermission('sales.approve') || hasOrgPermission('crm.close');
    }

    // The quotation's lifecycle (Sales PRD §5, D6, INV-06): one step at a time
    //   draft → issued → sent → accepted | rejected
    // Issuing locks the figures; sending locks the whole document. A change
    // after that is a NEW revision (its own document), never an edit — so an
    // issued quote can no longer have its prices rewritten, a draft can no
    // longer jump straight to "accepted", and a lost quote is not re-opened.
    // Payments, the order/work-order stamps, `validUntil` (set at sending,
    // moved by an extension) and `supersededById` stay writable: they are
    // facts ABOUT the document, not the document. `contactName` is a
    // denormalised label a CRM rename may refresh.
    function qFrom() { return resource.data.get('status', 'draft'); }
    function qTo() { return request.resource.data.get('status', 'draft'); }
    function qChanged() { return changedKeys(); }
    function quoteStepAllowed() {
      return qTo() == qFrom()
        || (qFrom() == 'draft' && qTo() == 'issued')
        || (qFrom() == 'issued' && qTo() == 'sent')
        || (qFrom() == 'sent' && qTo() in ['accepted', 'rejected']);
    }
    function quoteFiguresUntouched() {
      return !qChanged().hasAny(['items', 'amount', 'installments', 'contactId', 'quotationNumber',
                                 'vatPercent', 'validityDays', 'phase', 'revision', 'revisionOf']);
    }
    function quoteTextsUntouched() {
      return !qChanged().hasAny(['terms', 'notes', 'leadTime', 'branding', 'date']);
    }
    // A quote closed as lost carries its reason (T8).
    function lossHasReason() {
      return qTo() != 'rejected' || qFrom() == 'rejected'
        || (request.resource.data.get('lostReason', '') is string && request.resource.data.get('lostReason', '').size() > 0);
    }

    match /crmQuotations/{quotationId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || (isOrgMember(request.resource.data.organizationId)
        && (request.resource.data.get('status', 'draft') != 'accepted' || canApproveQuotation())));
      allow update: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && quoteStepAllowed()
        && lossHasReason()
        && (qFrom() == 'draft' || quoteFiguresUntouched())
        && (qFrom() in ['draft', 'issued'] || quoteTextsUntouched())
        && (!acceptsQuotation() || canApproveQuotation())
        && (!recordsQuotationPayment() || hasOrgPermission('sales.approve') || hasOrgPermission('invoices.manage')
            || hasOrgPermission('accounting.post'))));
      // A draft is anyone's to discard; a quote that left the house is a
      // record — removing one (with its deal, from CRM) is a closer's act.
      allow delete: if isSignedIn() && (isAdmin() || (isOrgMember(resource.data.organizationId)
        && (resource.data.get('status', 'draft') == 'draft'
            || hasOrgPermission('crm.close') || hasOrgPermission('sales.approve'))));
    }

    // Sales price list — the org's known items with fixed prices, picked into
    // quotations. Reading is for every member; the list itself is Sales'.
    // ── Sales orders (أوامر البيع) — the backbone between quotation and cash ──
    //
    // Quantities are DERIVED, never stored: delivered comes from delivery
    // notes, invoiced from invoices. So the rules guard documents, and the
    // documents guard the numbers.
    // Finance confirms the down payment a deposit order waits on: only the
    // payment flag and the status move, and only from awaiting to running.
    function confirmsSalesOrderDeposit() {
      // Whoever may answer a transfer notice may finish the act: confirming the
      // advance records the payment AND releases the order in one batch, so a
      // permission that covers one half and not the other denies the whole.
      return (hasOrgPermission('invoices.manage') || hasOrgPermission('accounting.post'))
        && resource.data.status == 'awaiting_deposit'
        && request.resource.data.status == 'running'
        && changedKeys().hasOnly(['payment', 'status', 'updatedAt'])
        && request.resource.data.payment.kind == 'deposit'
        && request.resource.data.payment.depositPaid == true
        && request.resource.data.payment.get('depositPercent', null) == resource.data.payment.get('depositPercent', null)
        && request.resource.data.payment.get('creditDays', null) == resource.data.payment.get('creditDays', null);
    }
    match /salesOrders/{orderId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (hasOrgPermission('sales.manage') || hasOrgPermission('sales.approve'));
      // Finance's one legitimate touch: confirming the advance (directly or by
      // answering a transfer notice) releases a deposit-gated order — the
      // scoped helper above lets exactly that write through and nothing else.
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (hasOrgPermission('sales.manage') || hasOrgPermission('sales.approve')
            || confirmsSalesOrderDeposit());
      // Orders are records other documents point at — only an admin removes one.
      allow delete: if isAdmin();
    }

    // Transfer notices (إشعار الحوالة) — the seller reports, Finance verifies.
    // The seller never invoices, collects, or edits a payment state: a notice
    // is the only thing Sales may create, and only Finance's permissions may
    // move it past "reported" (confirmed / not found).
    match /salesTransferNotices/{noticeId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (hasOrgPermission('sales.manage') || hasOrgPermission('sales.approve'))
        && request.resource.data.get('status', '') == 'reported';
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (hasOrgPermission('invoices.manage') || hasOrgPermission('accounting.post')
            || hasOrgPermission('sales.approve'));
      allow delete: if isAdmin();
    }

    // Quote requests (طلب تقديم العرض) — one door: CRM asks, Sales answers.
    // Sales never creates a request for itself; pricing or declining one
    // (with a factual reason) is the Sales side's only write.
    match /salesQuoteRequests/{requestId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (hasOrgPermission('crm.manage') || hasOrgPermission('crm.close'))
        && request.resource.data.get('status', '') == 'new';
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (hasOrgPermission('sales.manage') || hasOrgPermission('sales.approve'));
      allow delete: if isAdmin();
    }

    // Customer delivery notes — a three-step handshake (Sales PRD DLV-02, T16–T19):
    //   Sales requests the issue      → 'requested'
    //   Inventory authorises it       → 'authorized'  (warehouses.manage/receive)
    //   the client signs, Sales records it under the signer's name → 'delivered'
    // A hold and its release are Finance's alone (invoices.manage); on a held
    // note the seller may only stamp a release request. Each role moves the
    // note one step and touches only that step's fields — so a seller can no
    // longer deliver a held note, skip Inventory, or hold a shipment himself.
    function dnFrom() { return resource.data.get('status', ''); }
    function dnTo() { return request.resource.data.get('status', ''); }
    function dnChanged() { return changedKeys(); }
    function isSeller() { return hasOrgPermission('sales.manage') || hasOrgPermission('sales.approve'); }

    match /salesDeliveryNotes/{noteId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('sales.manage')
        && request.resource.data.get('status', '') == 'requested';
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (
          // Inventory authorises the issue.
          ((hasOrgPermission('warehouses.manage') || hasOrgPermission('warehouses.receive'))
            && dnFrom() == 'requested' && dnTo() == 'authorized'
            && dnChanged().hasOnly(['status', 'authorizedAt', 'authorizedByUserId', 'authorizedByUserName', 'updatedAt']))
          // The client signs: never without a signer, never from any state but authorised.
          || (isSeller()
            && dnFrom() == 'authorized' && dnTo() == 'delivered'
            && request.resource.data.get('signerName', '') is string
            && request.resource.data.get('signerName', '').size() > 0
            && dnChanged().hasOnly(['status', 'lines', 'signerName', 'signedAt', 'deliveredAt', 'deliveredByUserId',
                                    'deliveredByUserName', 'varianceNote', 'updatedAt']))
          // The seller's only act on a held shipment.
          || (isSeller()
            && dnFrom() == 'held' && dnTo() == 'held'
            && dnChanged().hasOnly(['releaseRequestedAt', 'releaseRequestedByUserName', 'updatedAt']))
          // Finance holds a shipment that has not left…
          || (hasOrgPermission('invoices.manage')
            && dnFrom() in ['requested', 'authorized'] && dnTo() == 'held'
            && dnChanged().hasOnly(['status', 'heldFrom', 'holdReason', 'heldAt', 'heldByUserName',
                                    'releaseRequestedAt', 'releaseRequestedByUserName', 'updatedAt']))
          // …and releases it to where it stood.
          || (hasOrgPermission('invoices.manage')
            && dnFrom() == 'held' && dnTo() in ['requested', 'authorized']
            && dnChanged().hasOnly(['status', 'heldFrom', 'releasedAt', 'releasedByUserName', 'updatedAt']))
        );
      // Only a note Inventory has not touched may be removed — anything later
      // is the proof behind quantities and invoices.
      allow delete: if isOrgMember(resource.data.organizationId)
        && hasOrgPermission('sales.manage')
        && resource.data.status == 'requested';
    }

    // Returns (DLV-05, T21) — a seller raises the request; approving or
    // rejecting it is a prices-&-returns role's (sales.approve), never a
    // rep's; settling it with the credit note is Finance's.
    function rtFrom() { return resource.data.get('status', ''); }
    function rtTo() { return request.resource.data.get('status', ''); }

    match /salesReturns/{returnId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('sales.manage')
        && request.resource.data.get('status', '') == 'awaiting_decision';
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (
          (hasOrgPermission('sales.approve')
            && rtFrom() == 'awaiting_decision' && rtTo() in ['approved', 'rejected']
            && dnChanged().hasOnly(['status', 'disposition', 'decidedAt', 'decidedByUserId', 'decidedByUserName', 'updatedAt']))
          || (hasOrgPermission('invoices.manage')
            && rtFrom() == 'approved' && rtTo() == 'credit_note_issued'
            && dnChanged().hasOnly(['status', 'creditNoteIssuedAt', 'creditNoteByUserId', 'creditNoteByUserName', 'updatedAt']))
        );
      allow delete: if isAdmin();
    }

    // Manufacturing requests (PRD 1.2) — two doors: Sales (a manufacturing
    // request for a sales order, or a costing request) and Procurement (a
    // project need it decided to make). No request is created inside
    // Manufacturing. The workshop manager answers; the requester (Sales,
    // Procurement) may only move an unanswered request to purchase.
    match /manufacturingRequests/{requestId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.status == 'new'
        && request.resource.data.createdByUserId == request.auth.uid
        && (hasOrgPermission('sales.manage') || hasOrgPermission('rfq.manage') || hasOrgPermission('rfq.create')
            || hasOrgPermission('warehouses.manage') || hasOrgPermission('manufacturing.manage'));
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (hasOrgPermission('manufacturing.manage')
            || ((hasOrgPermission('sales.manage') || hasOrgPermission('rfq.manage') || hasOrgPermission('warehouses.manage'))
                && resource.data.status == 'new'
                && request.resource.data.status == 'moved'
                && changedKeys()
                     .hasOnly(['status', 'decidedAt', 'decidedByUserId', 'decidedByUserName', 'movedToPurchase', 'answerNote', 'updatedAt'])));
      allow delete: if isAdmin();
    }

    // Sales invoices — revenue's paper trail. Marking one paid is a Finance
    // act; deleting one is not offered to clients at all.
    match /salesInvoices/{invoiceId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (hasOrgPermission('sales.manage') || hasOrgPermission('invoices.manage'));
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (hasOrgPermission('invoices.manage') || hasOrgPermission('sales.approve'));
      allow delete: if isAdmin();
    }

    match /salesPriceItems/{itemId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      // Prices (and the standard cost they carry) are a prices-&-returns role's:
      // the sales manager's and the owner's — a rep reads the list and quotes
      // from it, he does not set it (Sales PRD §3).
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('sales.approve');
      allow update, delete: if isAdmin() || (isOrgMember(resource.data.organizationId)
        && hasOrgPermission('sales.approve'));
    }

    // ── Accounting (المحاسبة والمالية) ──
    //
    // The general journal is an APPEND-ONLY ledger, and these rules are what
    // make that true rather than merely intended: a posted entry can never be
    // edited or deleted by any client, including the owner. A mistake is undone
    // by posting its reversal, which leaves both the error and the correction
    // legible — the property an audit depends on.
    //
    // The one update permitted on a posted entry is stamping `reversedByEntryId`
    // (so the original can point at its reversal) and promoting a draft to
    // posted. Nothing may touch the money: not `lines`, not the totals, not the
    // date the entry belongs to.
    match /accounting_journal/{entryId} {
      // Readable by any member of the org. Gating this behind `accounting.view`
      // would be theatre — every figure a journal entry contains is already
      // readable in the document it came from (projects carry budgets,
      // quotations carry amounts, employees carry salaries) — and it would also
      // break auto-posting, which reads the last entry number before writing.
      // `accounting.view` gates the MODULE in the UI; the rules gate writes.
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));

      // An `auto` entry is the bookkeeping shadow of a business action, so any
      // org member may create one — the engineer who certifies a claim or the
      // keeper who signs for stock is rarely an accountant, and refusing them
      // here would simply mean the ledger silently misses those events. What is
      // enforced instead is the invariant that matters: the entry must balance.
      // A `manual` voucher has no business document behind it and is the one
      // way a human can move money by hand, so it needs the posting right.
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.totalDebit == request.resource.data.totalCredit
        && (request.resource.data.kind == 'auto' || hasOrgPermission('accounting.post'));

      allow update: if isOrgMember(resource.data.organizationId)
        && hasOrgPermission('accounting.post')
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.totalDebit == resource.data.totalDebit
        && request.resource.data.totalCredit == resource.data.totalCredit
        && request.resource.data.date == resource.data.date
        && request.resource.data.lines == resource.data.lines
        && changedKeys()
             .hasOnly(['status', 'reversedByEntryId', 'updatedAt']);

      // Only a draft may ever be removed — a posted entry is history.
      allow delete: if isOrgMember(resource.data.organizationId)
        && hasOrgPermission('accounting.post')
        && resource.data.status == 'draft';
    }

    // The org's own copy of the chart of accounts — seeded from the platform
    // catalog, then theirs to rename and extend.
    match /accounting_accounts/{accountId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('accounting.post');
      allow update, delete: if isOrgMember(resource.data.organizationId)
        && hasOrgPermission('accounting.post');
    }

    // Period locks. Closing is deliberately its own permission: it is the act
    // that freezes a statement, and it must not ride along with day-to-day
    // posting rights.
    match /accounting_periods/{periodId} {
      // Readable by every member: the posting hooks check for a closed period
      // before they write, and they run as whoever performed the business action.
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('accounting.close');
      allow update, delete: if isOrgMember(resource.data.organizationId)
        && hasOrgPermission('accounting.close');
    }

    // Module settings — whether the org has switched Accounting on, its fiscal
    // year, branches and cost centres.
    match /accounting_settings/{settingsId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('accounting.close');
      allow update, delete: if isOrgMember(resource.data.organizationId)
        && hasOrgPermission('accounting.close');
    }

    // The zakat working paper — one per org and fiscal year (id `{orgId}__{fy}`):
    // the accountant's overrides and adjustments to the system's zakat base. It
    // never touches the ledger; the provision booked from it is a journal entry.
    match /accounting_zakat/{zakatId} {
      // A year nobody has adjusted yet has no document — reading it must answer
      // "missing", not "denied", or the screen cannot tell the two apart.
      allow get: if isSignedIn() && (resource == null || isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create, update: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('accounting.post')
        && zakatId == request.resource.data.organizationId + '__' + string(request.resource.data.fiscalYear)
        && (resource == null || resource.data.organizationId == request.resource.data.organizationId);
      allow delete: if false;
    }

    // CRM company profile — classification grades and annual capacity. The doc
    // id IS the organizationId, so a member can only ever reach their own org's
    // profile and a concurrent first save cannot create a duplicate.
    match /crmOrgProfile/{organizationId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(organizationId));
      allow list: if isSignedIn();
      allow create, update: if isSignedIn()
        && (isAdmin() || isOrgMember(organizationId))
        && request.resource.data.organizationId == organizationId;
      allow delete: if isSignedIn() && (isAdmin() || isOrgMember(organizationId));
    }

    // Platform-staff CRM over the clients (contractors and suppliers) — staff
    // only. One record per client user (doc id = the client's uid); the activity
    // log is append-only.
    match /adminCrmClients/{clientId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /adminCrmActivities/{activityId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Manufacturing (تصنيع) — the org's ordered department chain and the work
    // orders that travel through it. Every org member may read (assignees need
    // their stages); the chain itself needs manufacturing.manage; a work order
    // is created by manufacturing.manage or by crm.close (the quotation-accept
    // hook); stage-flow updates are open to members but locked to the flow
    // fields — everything else needs manufacturing.manage.
    match /manufacturingDepartments/{departmentId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('manufacturing.manage');
      allow update, delete: if isAdmin() || (isOrgMember(resource.data.organizationId)
        && hasOrgPermission('manufacturing.manage'));
    }

    // Work orders (PRD 1.2). Five manufacturing roles, each limited to the
    // fields its decisions write; the other modules touch only the facts they
    // own (D9 — Manufacturing requests and reads, never acts for them):
    //   manage  — everything (release, rush, close, notes, changes, purchase…)
    //   work    — station leads: output, rejects, remnants, materials request &
    //             receipt, checklists, the design station's drawing submission
    //   qc      — output at QC & packing + quality release, rejects, QC
    //             decisions (scrap records), slab sign-off
    //   cost    — scrap review and variance reviews only
    //   Inventory (warehouses.manage/receive) — issuing withdrawals, receiving
    //             remnants and delivery notes
    //   Sales / Projects — the drawing result and incoming change requests,
    //             and (Projects) receipt into custody
    //   Procurement — marking a purchase request arrived
    // Legacy stage-flow orders (no productId) keep the member-wide stage and
    // handover field set their assignees need.
    function woChanged() {
      return changedKeys();
    }

    match /workOrders/{orderId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && (hasOrgPermission('manufacturing.manage') || hasOrgPermission('crm.close'));
      allow update: if isAdmin() || (isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (hasOrgPermission('manufacturing.manage')
            || (hasOrgPermission('manufacturing.work')
                && woChanged().hasOnly(['progress', 'rejects', 'remnants', 'materials', 'materialCost', 'checklists',
                                        'drawing', 'log', 'stages', 'currentStageIndex', 'updatedAt']))
            || (hasOrgPermission('manufacturing.qc')
                && woChanged().hasOnly(['progress', 'rejects', 'qcReleases', 'remnants', 'scrapRecords', 'slabApproval',
                                        'materials', 'materialCost', 'checklists', 'log', 'stages', 'currentStageIndex', 'updatedAt']))
            || (hasOrgPermission('manufacturing.cost')
                && woChanged().hasOnly(['scrapRecords', 'varianceReviews', 'log', 'status', 'completedAt', 'updatedAt'])
                && request.resource.data.status in ['open', 'done'])
            || ((hasOrgPermission('warehouses.manage') || hasOrgPermission('warehouses.receive'))
                && woChanged().hasOnly(['materials', 'remnants', 'receivedAt', 'receivedByUserId', 'receivedByUserName', 'status', 'completedAt', 'updatedAt'])
                && request.resource.data.status in ['open', 'done'])
            || ((hasOrgPermission('sales.manage') || hasOrgPermission('projects.edit')
                 || (resource.data.get('projectId', null) is string && hasProjectPermission(resource.data.projectId, 'projects.edit')))
                && woChanged().hasOnly(['drawing', 'changeRequest', 'log', 'receivedAt', 'receivedByUserId', 'receivedByUserName', 'status', 'completedAt', 'updatedAt'])
                && request.resource.data.status in ['open', 'done'])
            // Purchasing and Inventory answer a purchase request (RFQ started, arrived,
            // declined) — they never raise one: the shortfall travels manufacturing →
            // warehouse → purchasing, so the array may change but never grow here.
            || ((hasOrgPermission('rfq.manage') || hasOrgPermission('rfq.create') || hasOrgPermission('warehouses.manage'))
                && woChanged().hasOnly(['purchaseRequests', 'updatedAt'])
                && request.resource.data.get('purchaseRequests', []).size() == resource.data.get('purchaseRequests', []).size())
            || (resource.data.get('productId', null) == null
                && woChanged().hasOnly(['stages', 'currentStageIndex', 'status', 'completedAt', 'deliveredTo', 'deliveredAt',
                                        'deliveryNoteId', 'deliveryNoteNumber', 'receivedAt', 'receivedByUserId', 'receivedByUserName',
                                        'progress', 'materials', 'materialCost', 'checklists', 'updatedAt']))));
      allow delete: if isAdmin() || (isOrgMember(resource.data.organizationId)
        && hasOrgPermission('manufacturing.manage'));
    }

    // Product cards (بطاقة المنتج) — route + BOM + standard time. The card is
    // the basis of every date, cost and material request, so editing it is the
    // workshop manager's act alone.
    match /mfgProducts/{productId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('manufacturing.manage');
      allow update, delete: if isAdmin() || (isOrgMember(resource.data.organizationId)
        && hasOrgPermission('manufacturing.manage'));
      // Procurement's approved price is the product's make-or-buy yardstick
      // («سعر مرجعي يقرؤه التصنيع») — that field and its trace, nothing else.
      allow update: if isOrgMember(resource.data.organizationId)
        && (hasOrgPermission('po.approve') || hasOrgPermission('offers.accept'))
        && changedKeys().hasOnly(['referenceBuyPrice', 'referenceBuyAt', 'referenceBuyPo', 'updatedAt'])
        && request.resource.data.referenceBuyPrice is number && request.resource.data.referenceBuyPrice > 0;
    }

    // Cost statements — cost, lead time and validity; no price, no margin
    // (D10). The manager's answer creates the draft; only the cost controller
    // reviews, sends and recalculates it (REQ-06); Sales records what became
    // of the quote built on it (quoted / won / lost), and nothing else.
    match /mfgCostEstimates/{estimateId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.state == 'draft'
        && (hasOrgPermission('manufacturing.manage') || hasOrgPermission('manufacturing.cost'));
      allow update: if isAdmin() || (isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && (hasOrgPermission('manufacturing.cost')
            || (hasOrgPermission('sales.manage')
                && resource.data.state in ['sent', 'quoted']
                && request.resource.data.state in ['quoted', 'won', 'lost']
                && changedKeys()
                     .hasOnly(['state', 'quoteNumber', 'salesOrderNumber', 'salesStatusBy', 'salesStatusAt', 'updatedAt']))));
      allow delete: if isAdmin();
    }

    // Manufacturing settings (doc id = orgId). The feature switches are the
    // workshop manager's; the policies (overhead rate, scrap limit, windows,
    // validity, remnant valuation) are Finance's and edited only there (FN-01).
    match /manufacturingSettings/{orgId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(orgId));
      allow create: if isOrgMember(orgId)
        && request.resource.data.organizationId == orgId
        && ((hasOrgPermission('manufacturing.manage')
             && request.resource.data.keys().hasOnly(['organizationId', 'features', 'featuresUpdatedBy', 'updatedAt']))
            || (hasOrgPermission('accounting.close')
             && request.resource.data.keys().hasOnly(['organizationId', 'overheadRatePerHour', 'scrapApprovalLimit', 'answerWindowHours',
                                                      'noteEscalationHours', 'estimateValidityDays', 'remnantValuePercent',
                                                      'policiesUpdatedBy', 'policiesUpdatedAt', 'updatedAt'])));
      allow update: if isOrgMember(orgId)
        && request.resource.data.organizationId == orgId
        && ((hasOrgPermission('manufacturing.manage')
             && changedKeys().hasOnly(['organizationId', 'features', 'featuresUpdatedBy', 'updatedAt']))
            || (hasOrgPermission('accounting.close')
             && changedKeys().hasOnly(['organizationId', 'overheadRatePerHour', 'scrapApprovalLimit',
                                                      'answerWindowHours', 'noteEscalationHours', 'estimateValidityDays',
                                                      'remnantValuePercent', 'policiesUpdatedBy', 'policiesUpdatedAt', 'updatedAt'])));
      allow delete: if isAdmin();
    }

    // Stops and absences — hours lost today at a station (FL-14). Reported by
    // a station lead or the workshop manager, in their own name; append-only.
    match /mfgStops/{stopId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.byId == request.auth.uid
        && request.resource.data.hours is number && request.resource.data.hours > 0
        && (hasOrgPermission('manufacturing.work') || hasOrgPermission('manufacturing.manage'));
      allow update, delete: if isAdmin();
    }

    // Block quality notices (FL-11) — raised by Quality or the manager; the
    // quarantine is Inventory's act, the supplier claim Procurement's.
    match /mfgBlockNotices/{noticeId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && request.resource.data.byId == request.auth.uid
        && (hasOrgPermission('manufacturing.qc') || hasOrgPermission('manufacturing.manage'));
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && ((hasOrgPermission('warehouses.manage')
             && changedKeys().hasOnly(['quarantinedAt', 'quarantinedBy', 'updatedAt']))
            || ((hasOrgPermission('rfq.manage') || hasOrgPermission('rfq.create'))
             && changedKeys().hasOnly(['claimRaisedAt', 'claimRaisedBy', 'updatedAt']))
            || ((hasOrgPermission('manufacturing.qc') || hasOrgPermission('manufacturing.manage'))
             && changedKeys().hasOnly(['closedAt', 'closedBy', 'updatedAt'])));
      allow delete: if isAdmin();
    }

    // Document sequences (ORD-07) — one doc per org, type and year
    // (`{orgId}__{type}__{year}`). Read and bumped inside the transaction that
    // writes the numbered document; it only ever moves forward.
    // PM 1.0 — the handover FILE from CRM (PRD HO-01…04). CRM (crm.close) sends it;
    // only the manager it is addressed to answers it: accept · return · reassign.
    match /pmHandovers/{handoverId} {
      allow get: if isSignedIn() && (resource == null || isOrgMember(resource.data.organizationId));
      allow list: if isOrgMember(resource.data.organizationId);
      allow create: if isSignedIn()
        && request.resource.data.organizationId == getOrganizationId()
        && hasOrgPermission('crm.close')
        && request.resource.data.status == 'wait'
        && request.resource.data.requestedBy == request.auth.uid;
      allow update: if isOrgMember(resource.data.organizationId)
        && resource.data.status == 'wait'
        && (resource.data.to == request.auth.uid || isOrgOwner())
        && request.resource.data.status in ['wait', 'acc', 'ret']
        && changedKeys()
             .hasOnly(['status', 'to', 'toName', 'reassigns', 'returned', 'projectId', 'acceptedAt', 'acceptedBy', 'acceptNote']);
      allow delete: if isAdmin();
    }

    // PM 1.0 — what projects tell Finance (prj:ADV/IPC/SC/BUD/HND/AMD). The id IS the
    // idempotency key, so a second send is refused rather than posted twice; the
    // outbox is append-only. The id carries the ORGANISATION in front of the key
    // (`{orgId}__{key}`): project numbers are drawn per organisation, so two
    // companies both own PJ-2026/001, and under the key alone the second company's
    // event was an update of the first's — refused, with the whole transaction.
    match /pmEvents/{eventId} {
      allow get: if isSignedIn() && (resource == null || isOrgMember(resource.data.organizationId));
      allow list: if isOrgMember(resource.data.organizationId);
      allow create: if isSignedIn()
        && request.resource.data.organizationId == getOrganizationId()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.key is string
        && eventId == request.resource.data.organizationId + '__' + request.resource.data.key.replace('/', '_');
      allow update, delete: if false;
    }

    match /mfgCounters/{counterId} {
      allow get: if isOrgMember(counterId.split('__')[0]);
      allow create: if isOrgMember(counterId.split('__')[0])
        && request.resource.data.organizationId == counterId.split('__')[0]
        && request.resource.data.last is int && request.resource.data.last >= 1;
      allow update: if isOrgMember(counterId.split('__')[0])
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.last is int
        && request.resource.data.last > resource.data.last
        && request.resource.data.last <= resource.data.last + 50;
      allow delete: if isAdmin();
    }

    // The fleet (HR) — drivers and vehicles a delivery note picks from (ORD-14).
    match /fleetVehicles/{vehicleId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('employees.manage');
      allow update: if isOrgMember(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId
        && hasOrgPermission('employees.manage');
      allow delete: if isAdmin();
    }

    // Delivery notes (إشعار تسليم) — a finished work order handed to a
    // warehouse. Any member may write one (stage assignees finish orders);
    // signing for receipt, or refusing it, needs warehouses.receive or
    // warehouses.manage. No client delete: it is the audit trail. Inventory →
    // project movements keep using warehouses/{id}/requests.
    match /deliveryNotes/{noteId} {
      allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow create: if isOrgMember(request.resource.data.organizationId);
      // Receipt is the destination's act: the warehouse, or — for a note into
      // project custody — the project (DN-01/DN-02).
      allow update: if isAdmin() || (isOrgMember(resource.data.organizationId)
        && (hasOrgPermission('warehouses.receive') || hasOrgPermission('warehouses.manage')
            || (resource.data.get('toKind', '') == 'project'
                && (hasOrgPermission('projects.edit')
                    || (resource.data.get('toProjectId', null) is string && hasProjectPermission(resource.data.toProjectId, 'projects.edit'))))));
      allow delete: if isAdmin();
    }

    // CRM activities — calls, meetings, site visits, tasks and emails.
    // Org-scoped like the rest of the CRM; every document carries the contact
    // it was logged against and, optionally, the opportunity.
    match /crmActivities/{activityId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
      allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
    }
    // Invoices — scoped to an organization
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
      allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
    }

    // Org-defined inventory item types (beyond the built-in materials /
    // equipment) — shown as sections in every warehouse. Editing the
    // vocabulary needs warehouses.manage, same as the stock it categorizes.
    match /inventoryItemTypes/{typeId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isOrgMember(request.resource.data.organizationId)
        && hasOrgPermission('warehouses.manage');
      allow update, delete: if isSignedIn() && (isAdmin()
        || (isOrgMember(resource.data.organizationId) && hasOrgPermission('warehouses.manage')));
    }

    // Warehouses — scoped to an organization, with inventory items subcollection
    match /warehouses/{warehouseId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
      allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));

      match /inventoryItems/{itemId} {
        allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
        ));
        allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
        allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
        ));

        // Individual physical units (barcode-tracked pieces, e.g. one marble
        // slab) — only present for items with trackingMode == "unit". Same
        // org-membership rule as the parent item.
        match /units/{unitId} {
          allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
            get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
          ));
          allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
          allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(
            get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
          ));
        }
      }

      // Stock-movement log for the central-warehouse system: every transfer
      // between the company's central warehouse and a project warehouse is
      // recorded here (on the CENTRAL warehouse's doc). Append-only for the
      // org — history can't be rewritten client-side.
      // Waste recorded straight from a warehouse — no project. Same document
      // shape as projects/{id}/wasteRecords and, like it, append-only: a
      // mistake is corrected with a reversal entry, never an edit.
      match /wasteRecords/{recordId} {
        allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
        ));
        allow create: if isOrgMember(get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId)
          && hasOrgPermission('warehouses.manage')
          && request.resource.data.recordedByUserId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /transfers/{transferId} {
        allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
        ));
        allow create: if isOrgMember(request.resource.data.organizationId);
        allow update, delete: if isAdmin();
      }

      // Withdrawal requests — raised, released, and confirmed by org members;
      // always stored on the CENTRAL warehouse's doc regardless of which
      // direction stock is moving (same convention as transfers above).
      // Client-side update covers the release/confirm/cancel status
      // transitions; no client delete keeps it a real audit trail.
      match /requests/{requestId} {
        allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
        ));
        allow create: if isOrgMember(request.resource.data.organizationId);
        allow update: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
        allow delete: if isAdmin();
      }
    }

  }
}

