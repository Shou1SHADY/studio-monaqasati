
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @philosophy
     * This ruleset enforces a strict user-ownership model combined with role-based access control 
     * (Contractor, Supplier, Admin). It prioritizes Authorization Independence by relying on 
     * denormalized fields to perform security checks without expensive document lookups.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(ownerIdField) {
      return isSignedIn() && resource != null && resource.data[ownerIdField] == request.auth.uid;
    }

    // التحقق من وجود مستند المستخدم لتجنب أخطاء get() قبل التأسيس
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && userExists() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || (hasRole('Contractor') && resource.data.role == 'Supplier' && resource.data.isVerified == true);
      allow list: if isAdmin() || (hasRole('Contractor') && resource.data.role == 'Supplier' && resource.data.isVerified == true);
      
      // السماح بإنشاء الملف الشخصي الأول للمالك (مهم جداً للتهيئة)
      allow create: if isOwner(userId);
      
      // السماح بالتحديث للمالك أو المشرف
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isAdmin();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // السماح بالقراءة لجميع المسجلين إذا كانت المناقصة جديدة، أو للمالك والمشرف
      allow get, list: if isSignedIn() && (isAdmin() || isExistingOwner('contractorId') || resource.data.status == 'New');
      allow create: if hasRole('Contractor') || isAdmin();
      allow update, delete: if isExistingOwner('contractorId') || isAdmin();
    }

    match /offers/{offerId} {
      allow get, list: if isAdmin() || isExistingOwner('supplierId') || (resource != null && resource.data.contractorId == request.auth.uid);
      allow create: if hasRole('Supplier');
      allow update, delete: if isExistingOwner('supplierId') || isAdmin();
    }

    match /notification_queue/{queueEntryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

  }
}
