rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow admin full access (requires custom claims in production)
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // RFQs - Contractors can only access their own RFQs
    match /rfqs/{rfqId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.contractorId;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.contractorId;
      // Suppliers can read RFQs in their service areas/categories
      allow read: if request.auth != null && 
        request.auth.token.role == 'supplier' &&
        request.auth.token.verified == true;
      
      // Offers subcollection - nested under RFQs
      match /offers/{offerId} {
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.supplierId &&
          exists(/databases/$(database)/documents/rfqs/$(rfqId));
        allow read: if request.auth != null && 
          (request.auth.uid == resource.data.supplierId || 
           request.auth.uid == get(/databases/$(database)/documents/rfqs/$(rfqId)).data.contractorId);
        allow update: if request.auth != null && 
          (request.auth.uid == resource.data.supplierId || 
           request.auth.uid == get(/databases/$(database)/documents/rfqs/$(rfqId)).data.contractorId);
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.supplierId;
      }
    }

    // Suppliers - Verified suppliers can read/write their own data
    match /suppliers/{supplierId} {
      allow read: if request.auth != null; // All authenticated users can read supplier profiles
      allow write: if request.auth != null && request.auth.uid == supplierId;
      allow write: if request.auth != null && request.auth.token.admin == true; // Admin can verify
    }

    // AI Cache - Server-side only (requires admin SDK in functions)
    match /ai-cache/{cacheId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server-side writes via Cloud Functions
    }

    // Notifications - Users can only access their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Chats - Participants can only access their own chats
    match /chats/{chatId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.participants;
    }
  }
}
