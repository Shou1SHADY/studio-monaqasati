rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- دالات مساعدة ---
    function isSignedIn() {
      return request.auth != null;
    }

    // فحص بسيط للرتبة لتجنب مشاكل التقييم عند عدم وجود المستند
    function hasRole(role) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- قواعد المجموعات ---

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId) || isSignedIn();
      allow list: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn(); // تسهيل التهيئة
    }

    match /rfqs/{rfqId} {
      // السماح بالقراءة لجميع المسجلين لضمان عدم توقف الواجهة
      allow read: if isSignedIn();
      // السماح بالإنشاء مؤقتاً لتسهيل التأسيس
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin() || (resource != null && resource.data.contractorId == request.auth.uid);
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (resource != null && resource.data.supplierId == request.auth.uid);
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }
  }
}