rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- دالات مساعدة آمنة ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      // استخدام get() بشكل آمن فقط إذا كان المستند موجوداً
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == role;
    }

    function isAdmin() { return hasRole('Admin'); }
    function isSupplier() { return hasRole('Supplier'); }
    function isContractor() { return hasRole('Contractor'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // --- قواعد المجموعات ---

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow get: if isOwner(userId) || isSignedIn();
      allow list: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // القراءة متاحة لكل المسجلين
      allow read: if isSignedIn();
      // السماح بالإنشاء إذا كان المستخدم مقاولاً (حسب الدور) أو إذا كان المعرف في الوثيقة يطابق المستخدم الحالي
      allow create: if isAdmin()
        || isContractor()
        || (isSignedIn() && request.resource.data.contractorId == request.auth.uid);
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.contractorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        || isSupplier()
        || (isSignedIn() && request.resource.data.supplierId == request.auth.uid);
      // المورد يمكنه التحديث، والمقاول يمكنه تغيير الحالة (قبول/رفض) إذا كان يملك المناقصة الأصلية
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.supplierId == request.auth.uid)
        || (isSignedIn() && resource.data.rfqId != null
            && get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.contractorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }

    match /chats/{chatId} {
      // أي مستخدم مسجل يمكنه إنشاء محادثة (التحكم يتم من الكود)
      allow create: if isSignedIn();
      // القراءة والتحديث للمقاول أو المورد فقط (resource == null يعني المستند غير موجود)
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid
      );

      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }
  }
}