
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- دالات مساعدة ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- قواعد المجموعات ---

    match /users/{userId} {
      // السماح بالقراءة للمالك أو المسؤول أو للمقاول لرؤية الموردين الموثقين
      allow get: if isOwner(userId) || isAdmin() || (resource.data.role == 'Supplier' && resource.data.isVerified == true);
      allow list: if isAdmin() || (resource.data.role == 'Supplier' && resource.data.isVerified == true);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // تم تبسيط هذه القاعدة لضمان عمل الصفحة فوراً
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // سيتم التحقق من الرتبة برمجياً أو لاحقاً
      allow update, delete: if isAdmin() || (resource != null && resource.data.contractorId == request.auth.uid);
    }

    match /offers/{offerId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.supplierId == request.auth.uid || resource.data.contractorId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (resource != null && resource.data.supplierId == request.auth.uid);
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }
  }
}
