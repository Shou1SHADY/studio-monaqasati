rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @philosophy
     * This ruleset enforces a strict user-ownership model combined with role-based access control 
     * (Contractor, Supplier, Admin). It prioritizes Authorization Independence by relying on 
     * denormalized fields (like 'contractorId' on Offers) to perform security checks without 
     * expensive document lookups.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(ownerIdField) {
      return isSignedIn() && resource != null && resource.data[ownerIdField] == request.auth.uid;
    }

    // Fetches the role of the currently authenticated user safely
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function hasRole(role) {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == role;
    }

    function isAdmin() {
      return hasRole('Admin');
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || (hasRole('Contractor') && resource.data.role == 'Supplier' && resource.data.isVerified == true);
      allow list: if isAdmin() || (hasRole('Contractor') && resource.data.role == 'Supplier' && resource.data.isVerified == true);
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);
        allow create: if isAdmin();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      // Allow creation if the user is an admin
      allow create, update, delete: if isAdmin();
    }

    match /rfqs/{rfqId} {
      allow get, list: if isAdmin() || isExistingOwner('contractorId') || (hasRole('Supplier') && resource.data.status == 'New');
      allow create: if hasRole('Contractor') || isAdmin();
      allow update, delete: if isExistingOwner('contractorId') || isAdmin();
    }

    match /offers/{offerId} {
      allow get, list: if isAdmin() || isExistingOwner('supplierId') || (resource != null && resource.data.contractorId == request.auth.uid);
      allow create: if hasRole('Supplier');
      allow update, delete: if isExistingOwner('supplierId') || isAdmin();
    }

    match /notification_queue/{queueEntryId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

  }
}