
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- دالات مساعدة ---
    function isSignedIn() {
      return request.auth != null;
    }

    // فحص آمن لوجود مستند المستخدم لمنع انهيار القواعد
    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return userExists() && getUserData().role == 'Admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- قواعد المجموعات ---

    match /users/{userId} {
      // السماح للمستخدم بإنشاء ملفه الشخصي لأول مرة
      allow create: if isOwner(userId);
      // القراءة للمالك أو المسؤول أو للمقاول لرؤية الموردين الموثقين
      allow get: if isOwner(userId) || isAdmin() || (userExists() && getUserData().role == 'Contractor' && resource.data.role == 'Supplier' && resource.data.isVerified == true);
      allow list: if isAdmin() || (userExists() && getUserData().role == 'Contractor' && resource.data.role == 'Supplier' && resource.data.isVerified == true);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // السماح بالقراءة للمسؤول، أو صاحب المناقصة، أو أي مورد للمناقصات الجديدة
      allow read: if isSignedIn() && (
        isAdmin() || 
        (resource != null && resource.data.contractorId == request.auth.uid) ||
        (resource != null && resource.data.status == 'New') ||
        (resource == null) // للسماح بالاستعلامات (Queries)
      );
      allow create: if isSignedIn(); 
      allow update, delete: if isAdmin() || (resource != null && resource.data.contractorId == request.auth.uid);
    }

    match /offers/{offerId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.supplierId == request.auth.uid || resource.data.contractorId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (resource != null && resource.data.supplierId == request.auth.uid);
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }
  }
}
