rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data != null ? userDoc.data : {};
    }

    function getOrganizationId() {
      let userData = getUserData();
      return userData.organizationId != null ? userData.organizationId : "";
    }

    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == role;
    }

    function isAdmin() { return hasRole('Admin'); }
    function isSupplier() { return hasRole('Supplier'); }
    function isContractor() { return hasRole('Contractor'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isOrgMember(orgId) {
      return isSignedIn() && getOrganizationId() == orgId;
    }

    // --- Team permission helpers (mirror src/lib/permissions.ts) ---
    // Org owners have every permission. Members get their group's permissions:
    // a project-level assignment (projects/{id}/members) overrides the default
    // group; a member with no group at all has read-only access.

    function isOrgOwner() {
      // Users created before the org-role migration have no organizationRole;
      // they are solo accounts, i.e. owners of their own one-person org.
      let userData = getUserData();
      return !('organizationRole' in userData) || userData.organizationRole == 'owner';
    }

    function memberDefaultGroupId() {
      let userData = getUserData();
      return ('defaultGroupId' in userData) ? userData.defaultGroupId : null;
    }

    function groupGrants(groupId, perm) {
      return groupId != null
        && groupId is string
        && exists(/databases/$(database)/documents/teamGroups/$(groupId))
        && get(/databases/$(database)/documents/teamGroups/$(groupId)).data.permissions.hasAny(['*', perm]);
    }

    function hasOrgPermission(perm) {
      return isOrgOwner() || groupGrants(memberDefaultGroupId(), perm);
    }

    function hasProjectPermission(projectId, perm) {
      return isOrgOwner()
        || (exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
            ? groupGrants(get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.groupId, perm)
            : groupGrants(memberDefaultGroupId(), perm));
    }

    // Permission for an RFQ: project-linked RFQs use the project assignment,
    // standalone RFQs fall back to the member's default group.
    function hasRfqPermission(rfqData, perm) {
      return (('projectId' in rfqData) && rfqData.projectId != null && rfqData.projectId is string && rfqData.projectId.size() > 0)
        ? hasProjectPermission(rfqData.projectId, perm)
        : hasOrgPermission(perm);
    }

    // Deciding on an offer (accept/reject/reduction) follows the offer's RFQ:
    // project-linked → project assignment; otherwise the default group.
    function hasOfferDecisionPermission(offerData) {
      return (('rfqId' in offerData) && offerData.rfqId != null && offerData.rfqId is string
              && exists(/databases/$(database)/documents/rfqs/$(offerData.rfqId)))
        ? hasRfqPermission(get(/databases/$(database)/documents/rfqs/$(offerData.rfqId)).data, 'offers.accept')
        : hasOrgPermission('offers.accept');
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Accounts are only ever created server-side (Admin SDK bypasses this
      // rule): by the admin-create-account API, or by the invitation-accept
      // API on a user's first invited signup. Client-side self-registration
      // is intentionally not possible.
      allow create: if isAdmin();
      allow get: if isOwner(userId) || isOrgMember(resource.data.organizationId) || isSignedIn();
      allow list: if isSignedIn();
      // Self-updates must not touch org membership fields — joining a team goes
      // through the server-side invitation accept API (or a legacy invitation
      // doc addressed to the caller's email, which acts as the authorization).
      // Without this, anyone could write organizationId and join any org.
      allow update: if isAdmin()
        || (isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['organizationId', 'organizationRole', 'defaultGroupId'])
          || (
            request.auth.token.email is string
            && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email))
            && get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.organizationId
               == request.resource.data.organizationId
          )
          || (
            // Multi-company switch: an account may only switch its active
            // organizationId into itself (its default org) or a secondary
            // company it created — never into an org owned by someone else.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'updatedAt'])
            && (
              request.resource.data.organizationId == userId
              || get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerUserId == userId
            )
          )
        ))
        || (
          isSignedIn() &&
          resource.data.organizationId == getOrganizationId() &&
          getUserData().organizationRole == 'owner'
        );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        // Only the owner of the user doc can read their own notifications
        allow get, list: if isOwner(userId) || isAdmin();
        // Any signed-in user can create a notification for another user
        allow create: if isSignedIn();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /2fa/{docId} {
        // Only the user themselves and admins can read/write OTP codes
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Supplier-saved quotation PDF templates, reused across offer submissions.
      match /quotationTemplates/{templateId} {
        allow get, list, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Secondary companies an account creates for the multi-company switcher.
    // The account's default/primary company has no doc here — it's implicit
    // (organizationId == the owner's own uid), matching the original org model.
    match /organizations/{orgId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      // 'read' = get + list, safe for signed-in users (static reference data)
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rfqs/{rfqId} {
      // Both get and list are safe for all signed-in users (RFQs are semi-public)
      allow read: if isSignedIn();
      // A project-linked RFQ ("Tender") must belong to a project owned by the caller's org.
      // A standalone RFQ (no project — a quick, non-competitive price request) is also allowed,
      // as long as projectId is absent/null. organizationId must match the caller either way.
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.organizationId == getOrganizationId()
          && (
            (!('projectId' in request.resource.data)) || request.resource.data.projectId == null
            || (
              request.resource.data.projectId is string
              && request.resource.data.projectId.size() > 0
              && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.organizationId == getOrganizationId()
            )
          )
          && (hasRfqPermission(request.resource.data, 'rfq.create')
              || hasRfqPermission(request.resource.data, 'projects.publish'))
        );
      // Org members / admins can update everything, but re-verify projectId ownership
      // on every update too (not just create) so an RFQ can't be re-pointed at a
      // project belonging to a different org after the fact.
      // Any signed-in user (e.g. a supplier submitting an offer) may increment
      // only the offersCount counter — no other field may change.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.organizationId == getOrganizationId()
          && (
            (!('projectId' in request.resource.data)) || request.resource.data.projectId == null
            || (
              request.resource.data.projectId is string
              && request.resource.data.projectId.size() > 0
              && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.organizationId == getOrganizationId()
            )
          )
          && (hasRfqPermission(resource.data, 'rfq.manage')
              || hasRfqPermission(resource.data, 'projects.publish'))
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount'])
        );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId()
            && (hasRfqPermission(resource.data, 'rfq.manage')
                || hasRfqPermission(resource.data, 'projects.publish')))
        || (isSignedIn() && resource.data.contractorId == request.auth.uid);

      // Subcollection: inquiries (questions from suppliers about the RFQ)
      match /inquiries/{inquiryId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid)
          || (isSignedIn() && get(/databases/$(database)/documents/rfqs/$(rfqId)).data.organizationId == getOrganizationId());
        allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }
    }

      match /offers/{offerId} {
      // 'get' (single document): check the resource fields for ownership
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.organizationId == getOrganizationId() ||
        resource.data.contractorOrgId == getOrganizationId() ||
        isAdmin()
      );
      // 'list' (collection query): allow any signed-in user; the app's 'where' clause
      // (filtering by rfqId, organizationId, etc.) ensures data isolation.
      allow list: if isSignedIn();
      allow create: if isAdmin()
        || isSupplier()
        || (isSignedIn() && request.resource.data.supplierId == request.auth.uid)
        || (isSignedIn() && request.resource.data.organizationId == getOrganizationId());
      // Supplier can update their own offer; contractor-side updates (accept /
      // reject / reduction / sample requests) additionally require the
      // offers.accept permission (org owners always have it).
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.supplierId == request.auth.uid)
        || (isSignedIn() && resource.data.organizationId == getOrganizationId())
        || (isSignedIn() && resource.data.contractorId == request.auth.uid
            && hasOfferDecisionPermission(resource.data))
        || (isSignedIn() && resource.data.contractorOrgId == getOrganizationId()
            && hasOfferDecisionPermission(resource.data))
        || (isSignedIn() && resource.data.rfqId != null
            && (
              get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.organizationId == getOrganizationId()
              || get(/databases/$(database)/documents/rfqs/$(resource.data.rfqId)).data.contractorId == request.auth.uid
            )
            && hasOfferDecisionPermission(resource.data));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.supplierId == request.auth.uid);
    }

    match /notification_queue/{queueEntryId} {
      allow read, write: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if isSignedIn();
      // 'get' (single document): only parties to the chat
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      // 'list' (collection query): allow any signed-in user; app 'where' clause filters by orgId
      allow list: if isSignedIn();
      // Direct UID checks are evaluated first (no extra get() call) so they short-circuit
      // before getOrganizationId() is called — avoids a null-org denial.
      allow update: if isSignedIn() && (
        resource.data.contractorId == request.auth.uid ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    // Internal same-company chat — one channel per organization, doc id == organizationId.
    match /teamChats/{orgId} {
      allow get, create, update: if isOrgMember(orgId) || isAdmin();
      allow list: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isOrgMember(orgId) || isAdmin();
        allow create: if isOrgMember(orgId) && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Top-level messages collection (used by mobile app)
    match /messages/{messageId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    // Invitations — contractor invites supplier by email; also used for team member invites
    // Docs carry a secret inviteToken (capability for the email invite link), so
    // listing is restricted to the invitee and the inviter — queries must filter
    // on email == own email or invitedBy == own uid.
    match /invitations/{invitationId} {
      allow list: if isAdmin() || (isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      ));
      allow create: if isSignedIn();
      allow get: if isSignedIn() && (resource == null || resource.data.email == request.auth.token.email || resource.data.invitedBy == request.auth.uid);
      // Supplier accepts/declines; contractor cancels their own invitation
      allow update: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        resource.data.invitedBy == request.auth.uid
      );
    }

    // Team permission groups — org-scoped. Members read their org's groups
    // (queries must filter organizationId == own org); only the org owner
    // manages them. The Super Admin system group (isSystem) is immutable.
    match /teamGroups/{groupId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.organizationId == getOrganizationId());
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.organizationId == getOrganizationId()
        && getUserData().organizationRole == 'owner');
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.organizationId == getOrganizationId()
        && getUserData().organizationRole == 'owner'
        && resource.data.isSystem != true
        && request.resource.data.organizationId == resource.data.organizationId);
      allow delete: if isAdmin() || (isSignedIn()
        && resource.data.organizationId == getOrganizationId()
        && getUserData().organizationRole == 'owner'
        && resource.data.isSystem != true);
    }

    // Team activity audit log — append-only from clients; org-scoped reads
    // (queries must filter organizationId == own org).
    match /teamActivity/{activityId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.organizationId == getOrganizationId());
      allow create: if isSignedIn()
        && request.resource.data.organizationId == getOrganizationId()
        && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }

    // Contractor–Supplier connection requests (supplier sends request → contractor accepts)
    match /contractorSupplierLinks/{linkId} {
      // Both parties can read their own links
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier-initiated requests, supplier accepting a contractor invitation,
      // OR a contractor marking a supplier as favorite (auto-connects immediately,
      // skipping the invite-and-wait step).
      allow create: if isSignedIn()
        && (
          (request.resource.data.supplierOrgId == getOrganizationId()
            && (request.resource.data.requestedBy == "supplier" || request.resource.data.requestedBy == "contractor"))
          || (request.resource.data.contractorOrgId == getOrganizationId()
              && request.resource.data.requestedBy == "contractor_favorite"
              && request.resource.data.status == "active")
        );
      // Contractors can accept/reject (update status); suppliers can cancel their own request
      allow update: if isSignedIn() && (
        (resource.data.contractorOrgId == getOrganizationId() && hasOrgPermission('suppliers.manage')) ||
        (resource.data.supplierOrgId == getOrganizationId() && resource.data.requestedBy == "supplier") ||
        isAdmin()
      );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.supplierOrgId == getOrganizationId());
    }

    // Project tracking — contractor org-scoped
    match /projects/{projectId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.organizationId == getOrganizationId() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isContractor()
        && request.resource.data.organizationId == getOrganizationId()
        && hasOrgPermission('projects.edit');
      // Editing needs projects.edit; publishing flows also update the project
      // doc (linked rfqIds), so projects.publish qualifies too.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId()
            && (hasProjectPermission(projectId, 'projects.edit')
                || hasProjectPermission(projectId, 'projects.publish')));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId()
            && hasProjectPermission(projectId, 'projects.delete'));

      // BOQ items subcollection — same org as the project.
      // Once an item is pushed to a tender (isEditable == false), it is hard-locked:
      // no field may change except the specific "unlock" transition performed when
      // the item is removed from the tender or the tender itself is deleted.
      match /boqItems/{itemId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId();

        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'));

        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'))
          && (
            resource.data.isEditable != false
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isEditable', 'tenderId', 'updatedAt'])
              && request.resource.data.isEditable == true
              && request.resource.data.tenderId == null
            )
          );

        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'))
          && resource.data.isEditable != false;
      }

      // Project team assignments — which org member works on this project and
      // with which permission group. Org members read; the org owner manages.
      match /members/{memberId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId();

        allow create, update, delete: if isAdmin() || (isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && hasOrgPermission('team.manage'));
      }

      // BOQ groups (sections) — plain org-scoped CRUD, same org as the project.
      // Groups themselves are never hard-locked; a locked item's groupId is already
      // frozen by the boqItems update rule above (groupId isn't in the unlock allowlist).
      match /boqGroups/{groupId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId();

        allow create, update, delete: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'projects.publish'));
      }

      // Minimal IPC/claims (مستخلصات) — bare-bones: submit, then flip to collected.
      // No edit/reject flow; amount/description are immutable once submitted.
      match /ipcClaims/{claimId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId();

        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && request.resource.data.submittedByUserId == request.auth.uid
          && request.resource.data.status == 'submitted'
          && (hasProjectPermission(projectId, 'projects.edit') || hasProjectPermission(projectId, 'invoices.manage'));

        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && hasProjectPermission(projectId, 'invoices.manage')
          && resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'collectedAt', 'updatedAt'])
          && request.resource.data.status == 'collected';

        allow delete: if isAdmin();
      }

      // Append-only finance audit trail (who submitted/collected an IPC claim, and when).
      // No update/delete for non-admins — it's a log, not an editable record.
      match /financeAuditLog/{entryId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId();

        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && request.resource.data.actorId == request.auth.uid;

        allow update, delete: if isAdmin();
      }

      // Internal purchase requests (طلبات شراء داخلية) — any org member can raise
      // one from inside the project; only the warehouse decision-maker
      // (warehouses.manage) can approve/reject it. Bare-bones: no edit flow,
      // only the pending -> approved|rejected transition is allowed post-create.
      match /purchaseRequests/{requestId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId();

        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && request.resource.data.requestedByUserId == request.auth.uid
          && request.resource.data.status == 'pending';

        allow update: if isSignedIn()
          && get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId == getOrganizationId()
          && hasProjectPermission(projectId, 'warehouses.manage')
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedByUserId', 'decidedByUserName', 'decidedAt', 'updatedAt'])
          && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected');

        allow delete: if isAdmin();
      }
    }

    // Procurement materials catalog — admin manages, contractors read
    match /procurementMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Contractor recurring-items catalog — org-scoped read (same pattern as rfqs/deliveries)
    match /contractorCatalog/{itemId} {
      allow read: if isSignedIn();
      allow create: if isContractor()
        && request.resource.data.organizationId == getOrganizationId()
        && request.resource.data.contractorId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.organizationId == getOrganizationId();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.organizationId == getOrganizationId());
    }

    // Delivery receipts — both contractor and supplier involved can read/write
    match /deliveries/{deliveryId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        resource.data.supplierId == request.auth.uid ||
        resource.data.confirmedByUserId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier creates delivery notice for their own accepted offer
      allow create: if (isSupplier()
        && request.resource.data.supplierOrgId == getOrganizationId())
        // Contractor manually logs a receipt for materials received outside the platform —
        // must already be self-confirmed (no supplier notice/confirmation step to go through)
        // and must not reference a real supplier account, to prevent impersonating one.
        || (isContractor()
          && request.resource.data.contractorOrgId == getOrganizationId()
          && request.resource.data.contractorId == request.auth.uid
          && request.resource.data.status == "confirmed"
          && request.resource.data.confirmedByUserId == request.auth.uid
          && hasOrgPermission('deliveries.confirm')
          && !('supplierOrgId' in request.resource.data)
          && !('supplierId' in request.resource.data)
          && !('offerId' in request.resource.data)
          && !('rfqId' in request.resource.data));
      // Contractor confirms receipt; supplier can update their own notice before confirmation.
      // A manual (contractor-logged) delivery is created without supplierOrgId/supplierId/
      // offerId/rfqId to prevent impersonating a real supplier — lock that guarantee on
      // update too, so those fields can never be added retroactively once absent.
      allow update: if isSignedIn() && (
        (resource.data.contractorOrgId == getOrganizationId() && hasOrgPermission('deliveries.confirm')) ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      ) && (
        isAdmin() || !('supplierOrgId' in request.resource.data) || 'supplierOrgId' in resource.data
      ) && (
        isAdmin() || !('supplierId' in request.resource.data) || 'supplierId' in resource.data
      ) && (
        isAdmin() || !('offerId' in request.resource.data) || 'offerId' in resource.data
      ) && (
        isAdmin() || !('rfqId' in request.resource.data) || 'rfqId' in resource.data
      );
      allow delete: if isAdmin();
    }

    // Guarantee certificates submitted by suppliers for contractor-flagged BOQ items on their
    // own accepted offers. Managed as a standalone flow (its own pages on both sides) — never
    // gates offer/RFQ/delivery-notice writes.
    match /guarantees/{guaranteeId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.contractorOrgId == getOrganizationId() ||
        resource.data.supplierOrgId == getOrganizationId() ||
        isAdmin()
      );
      allow list: if isSignedIn();
      // Supplier submits the guarantee answer for their own accepted offer, from the standalone
      // supplier Guarantees page — independent of sending the delivery notice.
      allow create: if isSupplier()
        && request.resource.data.supplierOrgId == getOrganizationId()
        && (request.resource.data.status == 'pending_review' || request.resource.data.status == 'none');
      allow update: if isSignedIn() && (
        // Contractor accepts/rejects a submitted guarantee; only the review fields may change.
        (resource.data.contractorOrgId == getOrganizationId()
          && hasOrgPermission('deliveries.confirm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedByUserId'])
          && (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected'))
        // Owning supplier edits/resubmits their own answer before or after rejection, but never
        // once the contractor has accepted it.
        || (isSupplier()
          && resource.data.supplierOrgId == getOrganizationId()
          && resource.data.status != 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hasGuarantee', 'fileUrl', 'filePath', 'fileType', 'expirationDate', 'status'])
          && (request.resource.data.status == 'pending_review' || request.resource.data.status == 'none'))
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Mdmak internal procurement records — admin-only (hides internal cost/commission from contractors)
    match /mdmakProcurement/{procurementId} {
      allow read, write: if isAdmin();
    }

    // Platform-wide settings — admin-only read/write
    match /platformSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Demo requests — public write (unauthenticated form submissions), admin read
    match /demoRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'company', 'phone', 'email'])
        && request.resource.data.name is string
        && request.resource.data.company is string
        && request.resource.data.phone is string
        && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    match /onboardingRequests/{requestId} {
      // Only ever written server-side (POST /api/onboarding/request via
      // Admin SDK, which bypasses this rule) — no client create clause.
      allow read, update, delete: if isAdmin();
    }

    // Employee records — scoped to an organization
    // list uses isSignedIn() (no resource.data on collection queries); the app's
    // where(organizationId==) clause enforces isolation at query time.
    match /employees/{employeeId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
      allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
    }

    // Invoices — scoped to an organization
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
      allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
    }

    // Warehouses — scoped to an organization, with inventory items subcollection
    match /warehouses/{warehouseId} {
      allow get: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
      allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(resource.data.organizationId));

      match /inventoryItems/{itemId} {
        allow get, list: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
        ));
        allow create: if isSignedIn() && (isAdmin() || isOrgMember(request.resource.data.organizationId));
        allow update, delete: if isSignedIn() && (isAdmin() || isOrgMember(
          get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.organizationId
        ));
      }
    }

  }
}

